// Builds the demo: three web pages and one phone screen, from one schema.

import io     from std;
import str    from std;
import mem    from std;
import ui     from std;
import schema from app;
import rules  from app;
import views  from app;
import phone  from app;

int seed() {
    Plan <- [id = 1, name = "Lite 30",  monthly_price =  35.00, monthly_quota_gb =  30.0, speed_mbps =  30, audience = "light use"];
    Plan <- [id = 2, name = "Core 60",  monthly_price =  59.00, monthly_quota_gb =  60.0, speed_mbps =  60, audience = "most people"];
    Plan <- [id = 3, name = "Max 120",  monthly_price =  89.00, monthly_quota_gb = 120.0, speed_mbps = 100, audience = "heavy use"];
    Plan <- [id = 4, name = "Unlimited", monthly_price = 129.00, monthly_quota_gb = 500.0, speed_mbps = 300, audience = "a household"];

    Subscriber <- [id = 1, msisdn = "011-2xx xxxx", full_name = "Aisyah Rahman",
    plan_id = 2, used_gb = 71.4, state = "ACTIVE"];

    Invoice <- [id = 1, subscriber_id = 1, period = "September 2026",
    plan_charge = 59.00, overage_charge = 114.00, status = "DUE"];
    return 1;
}

int main() {
    seed();

    render PlansPage   to "public/plans.html";
    render AccountPage to "public/account.html";
    render BillPage    to "public/bill.html";

    // The same rows, drawn for a phone rather than a browser.
    int items = draw_account();
    print(str_cat(["rendered 3 pages; the phone screen holds ",
    str(items), " things to draw"]));
    return 0;
}
