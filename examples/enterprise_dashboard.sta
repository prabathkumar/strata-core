// ==============================================================================
// STRATA FRONT-END SPECIFICATION: enterprise_dashboard.sta
// Strict Brace-Enclosed UI Layout Engine Module Template
// Compiles directly to lightweight WebAssembly (Wasm) with 0% JS dependencies
// ==============================================================================

import core.io from std;

// 1. TYPED CORE FRONT-END STATE MODEL
// Explicitly binds real-time data shapes straight from the system state layer
database RealTimeMetric {
    int    system_node_id;
    str    service_name;
    float  resource_utilization;
    str    operational_status;
}

// 2. DECLARATIVE CORE PRESENTATION STRUCTURE
// The compiler maps this layout definition directly to a tree-shaken WebAssembly DOM loop
layout CoreOperationalConsole() {

    // Application Master Display View Container
    window "Strata Enterprise Operations Engine" [width = 1920, height = 1080] {

        // Master Navigation Row Element
        row [background = "#0c0c12", padding_y = 12, padding_x = 24] {
            text "SYSTEM CONSOLE: OPERATIONAL" [color = "#39ff14", weight = "bold", size = 16];
            spacer;
            text "Deployment Runtime Tier: Core Wasm Sandbox" [color = "#8b8b9a", size = 12];
        }

        // Secondary Telemetry Metrics Panel Grid
        grid [columns = 3, spacing = 20, padding = 25] {

            // Component Column 1: Live Memory Topology Map
            column [background = "#121218", border_radius = 8, border_color = "#232330", padding = 16] {
                text "Hardware Linear Matrix Map" [color = "#ffffff", size = 14];

                // Hardware accelerated virtual graphics drawing node
                canvas hardware_topology_view [width = 500, height = 300];

                row [padding_top = 10] {
                    text "Memory Status: Isolated" [color = "#8b8b9a", size = 12];
                }
            }

            // Component Column 2: Data Store Pipeline Activity Monitor
            column [background = "#121218", border_radius = 8, border_color = "#232330", padding = 16] {
                text "High-Scale Relational Queries" [color = "#ffffff", size = 14];

                // Natively fetch structural rows securely directly within the front-end layout loop
                // If a developer types 'opt_status' instead of 'operational_status', the build halts here.
                list[RealTimeMetric] critical_nodes = RealTimeMetric <- [operational_status == "DEGRADED"];

                if (len(critical_nodes) == 0) {
                    row [padding_y = 20] {
                        text "All cluster clusters operating inside normal bounds." [color = "#4af626"];
                    }
                }

                for Node in critical_nodes {
                    row [background = "#1c1c24", padding = 10, margin_top = 8] {
                        text Node.service_name [color = "#ffffff"];
                        spacer;
                        text "Usage: " + str(Node.resource_utilization) + "%" [color = "#ff4a4a"];
                    }
                }
            }

            // Component Column 3: Live Input Event Log
            column [background = "#121218", border_radius = 8, border_color = "#232330", padding = 16] {
                text "Asynchronous Stream Feed" [color = "#ffffff", size = 14];

                // A button posts to a route, the way every form in this
                // repository does. This line used to read
                // `action = on_trigger_optimize` -- a bare function name, as
                // though the button called it in the browser. Strata renders
                // HTML; it emits no JavaScript and has no browser event loop,
                // so there was nothing to call. It did not compile either:
                // the name reached the generated C as an undeclared variable.
                form [action = "/optimize", method = "post"] {
                    row [padding_top = 12] {
                        button "Execute Core Optimization Sweep" [background = "#00bcff", color = "#ffffff"];
                    }
                }
            }
        }
    }
}

// 3. WHAT HANDLES THAT ROUTE
// An ordinary function. A server dispatches "/optimize" to it -- see
// apps/orders/src/main.sta for a router that does exactly that. Nothing in a
// rendered page calls it by itself.
int on_trigger_optimize() {
    print("[UI Action Loop]: Initiating asynchronous memory compaction sweep...");

    // Explicit return tracking matching the integer function prefix contract
    return 1;
}
