// Strata Corporate Microservice Template
//
// The import here used to name `legacy_pricing_model from python_engine` — a
// source that does not exist and never did. An unresolvable import disarms the
// undefined-call rule, so it was also hiding a call to a function nothing
// defined.
import io   from std;
import str  from std;
import json from std;

database CorporateAccount {
    int    account_id;
    str    owner_uuid;
    float  credit_limit;
}

stream ProcessIncomingTransactions(str message_broker_uri) {
    str raw_event_payload = current_message();
    int target_account_id = extract_json_int(raw_event_payload, "account_id");

    list[CorporateAccount] matching_accounts = CorporateAccount <- [account_id == target_account_id];
}
