// STRATA COMPILER — compiler/typechecker.sta
// The Strata type checker, written in Strata.
//
// Stage 3 of the self-hosting pipeline. Must emit the same diagnostics as
// compiler/typechecker.py — same codes, locations, messages and order.
// test_suite/typecheck_diff.py enforces that.
//
// Uses only the frozen seed subset (see SEED_SUBSET.md).

import io     from std;
import str    from std;
import lexer  from compiler;
import parser from compiler;

// ── Types ────────────────────────────────────────────────────────────────────
//
// A type is a record rather than a tagged union, since Strata has no sum
// types. `elem` holds the element type of a list as a Ty* cast to int.

database Ty {
    str name;
    int is_list; int elem;
    int is_tensor; str dtype; int rows; int cols;
}

Ty ty_new(str name) {
    native "
    Ty* _t=(Ty*)calloc(1,sizeof(Ty));
    _t->name=$name; _t->dtype=\"\"; return _t;
    ";
}

int ty_ptr(Ty t) { native "return (int64_t)(uintptr_t)$t;"; }
Ty  ty_at(int p)  { native "return (Ty*)(uintptr_t)$p;"; }

Ty ty_list(Ty elem) {
    Ty t = ty_new("list");
    t.is_list = 1;
    t.elem = ty_ptr(elem);
    return t;
}

Ty ty_tensor(str dtype, int rows, int cols) {
    Ty t = ty_new("tensor");
    t.is_tensor = 1; t.dtype = dtype; t.rows = rows; t.cols = cols;
    return t;
}

// Rendering must match the oracle's __repr__ exactly: it appears in messages.
str ty_str(int p) {
    if (p == 0) { return "None"; }
    Ty t = ty_at(p);
    if (t.is_tensor == 1) {
        StringBuilder sb = sb_new();
        sb_append(&sb, "tensor[");
        sb_append(&sb, t.dtype);
        sb_append(&sb, ",");
        sb_append(&sb, str(t.rows));
        sb_append(&sb, ",");
        sb_append(&sb, str(t.cols));
        sb_append(&sb, "]");
        return sb_to_str(&sb);
    }
    if (t.is_list == 1) {
        StringBuilder sb = sb_new();
        sb_append(&sb, "list[");
        sb_append(&sb, ty_str(t.elem));
        sb_append(&sb, "]");
        return sb_to_str(&sb);
    }
    return t.name;
}

int ty_eq(int a, int b) {
    if (a == 0) { return 0; }
    if (b == 0) { return 0; }
    Ty x = ty_at(a);
    Ty y = ty_at(b);
    if (x.is_tensor == 1) {
        if (y.is_tensor == 1) {
            if (str_eq(x.dtype, y.dtype) == 0) { return 0; }
            if (x.rows != y.rows) { return 0; }
            if (x.cols != y.cols) { return 0; }
            return 1;
        }
    }
    if (x.is_list == 1) {
        if (y.is_list == 1) { return ty_eq(x.elem, y.elem); }
    }
    if (str_eq(x.name, y.name) == 1) { return 1; }
    return 0;
}

int ty_compatible(int declared, int actual) {
    if (ty_eq(declared, actual) == 1) { return 1; }
    if (declared == 0) { return 1; }
    if (actual == 0) { return 1; }
    Ty d = ty_at(declared);
    Ty a = ty_at(actual);
    if (str_eq(d.name, "float") == 1) { if (str_eq(a.name, "int") == 1) { return 1; } }
    return 0;
}

// ── Symbol tables ────────────────────────────────────────────────────────────
//
// Linked lists rather than hash maps: the seed subset has no maps, and a
// compiler's scopes are small enough that lookup cost is irrelevant.

database Sym { str name; int ty; int next; }

int sym_cons(str name, int ty, int next) {
    native "
    Sym* _s=(Sym*)malloc(sizeof(Sym));
    _s->name=$name; _s->ty=$ty; _s->next=$next;
    return (int64_t)(uintptr_t)_s;
    ";
}

Sym sym_at(int p) { native "return (Sym*)(uintptr_t)$p;"; }

int sym_find(int head, str name) {
    int cur = head;
    while (cur != 0) {
        Sym s = sym_at(cur);
        if (str_eq(s.name, name) == 1) { return cur; }
        cur = s.next;
    }
    return 0;
}

// A scope is a symbol list plus a parent scope.
database Scp { int syms; int parent; }

Scp scp_new(int parent) {
    native "Scp* _s=(Scp*)malloc(sizeof(Scp)); _s->syms=0; _s->parent=$parent; return _s;";
}
int scp_ptr(Scp s) { native "return (int64_t)(uintptr_t)$s;"; }
Scp scp_at(int p)  { native "return (Scp*)(uintptr_t)$p;"; }

def scp_define(Scp &s, str name, int ty) { s.syms = sym_cons(name, ty, s.syms); }

int scp_lookup(int scope_p, str name) {
    int cur = scope_p;
    while (cur != 0) {
        Scp s = scp_at(cur);
        int hit = sym_find(s.syms, name);
        if (hit != 0) { Sym sy = sym_at(hit); return sy.ty; }
        cur = s.parent;
    }
    return 0;
}

int scp_has(int scope_p, str name) {
    int cur = scope_p;
    while (cur != 0) {
        Scp s = scp_at(cur);
        if (sym_find(s.syms, name) != 0) { return 1; }
        cur = s.parent;
    }
    return 0;
}

// ── Declared shapes ──────────────────────────────────────────────────────────

// A database/protocol: name plus a field list (reusing Sym for field -> type).
database Schema { str name; int fields; int next; }

int schema_cons(str name, int fields, int next) {
    native "
    Schema* _s=(Schema*)malloc(sizeof(Schema));
    _s->name=$name; _s->fields=$fields; _s->next=$next;
    return (int64_t)(uintptr_t)_s;
    ";
}
Schema schema_at(int p) { native "return (Schema*)(uintptr_t)$p;"; }

int schema_find(int head, str name) {
    int cur = head;
    while (cur != 0) {
        Schema s = schema_at(cur);
        if (str_eq(s.name, name) == 1) { return cur; }
        cur = s.next;
    }
    return 0;
}

// A declared function: return type plus parameter types, in order.
database Fn { str name; int rt; int params; int nparams; int next; }

int fn_cons(str name, int rt, int params, int nparams, int next) {
    native "
    Fn* _f=(Fn*)malloc(sizeof(Fn));
    _f->name=$name; _f->rt=$rt; _f->params=$params; _f->nparams=$nparams; _f->next=$next;
    return (int64_t)(uintptr_t)_f;
    ";
}
Fn fn_at(int p) { native "return (Fn*)(uintptr_t)$p;"; }

int fn_find(int head, str name) {
    int cur = head;
    while (cur != 0) {
        Fn f = fn_at(cur);
        if (str_eq(f.name, name) == 1) { return cur; }
        cur = f.next;
    }
    return 0;
}

// A declared model: input and output tensor types.
database Mdl { str name; int in_ty; int out_ty; int next; }

int mdl_cons(str name, int in_ty, int out_ty, int next) {
    native "
    Mdl* _m=(Mdl*)malloc(sizeof(Mdl));
    _m->name=$name; _m->in_ty=$in_ty; _m->out_ty=$out_ty; _m->next=$next;
    return (int64_t)(uintptr_t)_m;
    ";
}
Mdl mdl_at(int p) { native "return (Mdl*)(uintptr_t)$p;"; }

int mdl_find(int head, str name) {
    int cur = head;
    while (cur != 0) {
        Mdl m = mdl_at(cur);
        if (str_eq(m.name, name) == 1) { return cur; }
        cur = m.next;
    }
    return 0;
}

// ── Checker state ────────────────────────────────────────────────────────────

database TC {
    int schemas; int fns; int models;
    int globals;
    int current_return;
    int error_count;
    // Set when the caller resolved the import graph. Without it an unknown
    // callee cannot be told apart from a call into std/, so the check stays
    // off and the mistake surfaces as a C linker error instead.
    int strict_calls;
    // The file the diagnostics being produced right now belong to. An
    // application is several files, and a line number against the wrong one is
    // worse than no line number.
    str current_file;
    str imported;     // ",name,name," of everything the imports make reachable
}

TC tc_new() {
    native "TC* _t=(TC*)calloc(1,sizeof(TC)); _t->imported=\"\"; _t->current_file=\"\"; return _t;";
}

// Functions the generated C already has, from the runtime prelude or as a
// compiler intrinsic. A call to one of these is never undefined. Kept in step
// with the oracle's RUNTIME_BUILTINS by a conformance test.
int is_runtime_builtin(str name) {
    str known = ",file_exists,file_read,file_write,float_to_str,int_to_str,sb_append_f,sb_append_line_f,sb_new_f,str_concat,str_eq,str_index_of,str_len,str_slice,str_starts_with,str_to_int,strata_concat,strata_float_to_str,strata_int_to_str,strata_dup,strata_len,strata_write_escaped,strata_read_field,strata_read_header,strata_load_refuse,strata_on,strata_publish,strata_run,current_message,strata_set_message,strata_tensor,strata_tensor_set,strata_tensor_get,strata_tensor_add,strata_predict,strata_model_load,strata_activate,strata_weight_count,native,";
    StringBuilder needle = sb_new();
    sb_append(&needle, ",");
    sb_append(&needle, name);
    sb_append(&needle, ",");
    if (str_index_of(known, sb_to_str(&needle)) >= 0) { return 1; }
    return 0;
}

int name_in_list(str names, str name) {
    StringBuilder needle = sb_new();
    sb_append(&needle, ",");
    sb_append(&needle, name);
    sb_append(&needle, ",");
    if (str_index_of(names, sb_to_str(&needle)) >= 0) { return 1; }
    return 0;
}

// Diagnostics are written as they are found, which preserves traversal order —
// the order the oracle produces and the order the repair loop consumes.
def emit(TC &tc, str code, str msg, int line, int col) {
    StringBuilder sb = sb_new();
    sb_append(&sb, code);
    sb_append(&sb, " ");
    if (str_len(tc.current_file) > 0) {
        sb_append(&sb, tc.current_file);
        sb_append(&sb, ":");
    }
    sb_append(&sb, str(line));
    sb_append(&sb, ":");
    sb_append(&sb, str(col));
    sb_append(&sb, " ");
    sb_append(&sb, msg);
    print(sb_to_str(&sb));
    tc.error_count = tc.error_count + 1;
}

// ── Type resolution from syntax ───────────────────────────────────────────────

int resolve_type(int node_p) {
    if (node_p == 0) { return ty_ptr(ty_new("void")); }
    Node n = node_at(node_p);
    if (n.kind == 11) { return ty_ptr(ty_new(n.s1)); }
    if (n.kind == 12) { return ty_ptr(ty_list(ty_at(resolve_type(n.c1)))); }
    if (n.kind == 13) { return ty_ptr(ty_tensor(n.s1, n.i1, n.i2)); }
    return ty_ptr(ty_new("void"));
}

// ── Registration pass ────────────────────────────────────────────────────────

// An import with no local checkout, reported at its own line.
//
// The compiler used to print this on stderr and carry on, so it never reached
// --json and the repair loop could not see it. It matters more than it looks:
// an unresolvable import also disarms the undefined-call check, so a file
// importing a module that is not there reports nothing at all — moving a
// broken module out of the way makes its callers look clean.
//
// It is an advisory, not an error: a dependency provided at link time is
// legitimate, and failing the build on one would make external modules
// unusable.
def report_unresolved_imports(TC &tc, Node unit, str root, str src_dir) {
    NodeVec imps = nv_at(unit.v1);
    int n = imps.len;
    for (int i = 0; i < n; i = i + 1) {
        Node imp = nv_get(&imps, i);
        int local = 0;
        if (str_eq(imp.s2, "std") == 1) { local = 1; }
        if (str_eq(imp.s2, "compiler") == 1) { local = 1; }
        if (str_eq(imp.s2, "app") == 1) { if (str_len(src_dir) > 0) { local = 1; } }
        int found = 0;
        if (local == 1) {
            str mp = module_path(root, imp.s2, imp.s1);
            if (str_eq(imp.s2, "app") == 1) { mp = app_module_path(src_dir, imp.s1); }
            if (file_exists(mp) == 1) { found = 1; }
        }
        if (found == 0) {
            StringBuilder sb = sb_new();
            sb_append(&sb, "'");
            sb_append(&sb, imp.s1);
            sb_append(&sb, "' from '");
            sb_append(&sb, imp.s2);
            sb_append(&sb, "' has no local checkout");
            emit(&tc, "E007", sb_to_str(&sb), imp.line, imp.col);
        }
    }
}

def register_imported_decls(TC &tc, int mods_p) {
    NodeVec mods = nv_at(mods_p);
    int nm = mods.len;
    for (int m = 0; m < nm; m = m + 1) {
        Node mu = nv_get(&mods, m);
        NodeVec decls = nv_at(mu.v2);
        int nd = decls.len;
        for (int i = 0; i < nd; i = i + 1) {
            Node d = nv_get(&decls, i);
            // A local declaration of the same name wins, so an already-known
            // schema is left alone.
            if (schema_find(tc.schemas, d.s1) == 0) {
                if (d.kind == 3) { tc.schemas = schema_cons(d.s1, fields_of(d), tc.schemas); }
                if (d.kind == 4) { tc.schemas = schema_cons(d.s1, fields_of(d), tc.schemas); }
            }
            if (d.kind == 5) {
                tc.models = mdl_cons(d.s1, resolve_type(d.c1), resolve_type(d.c2), tc.models);
            }
            int declares = 0;
            if (d.kind == 3)  { declares = 1; }
            if (d.kind == 4)  { declares = 1; }
            if (d.kind == 5)  { declares = 1; }
            if (d.kind == 6)  { declares = 1; }
            if (d.kind == 70) { declares = 1; }
            if (declares == 1) {
                Scp g = scp_at(tc.globals);
                scp_define(&g, d.s1, ty_ptr(ty_new(d.s1)));
            }
        }
    }
}

def register_decls(TC &tc, Node unit) {
    Scp g = scp_new(0);
    tc.globals = scp_ptr(g);

    NodeVec decls = nv_at(unit.v2);
    int nd = decls.len;
    for (int i = 0; i < nd; i = i + 1) {
        Node d = nv_get(&decls, i);
        if (d.kind == 3) { tc.schemas = schema_cons(d.s1, fields_of(d), tc.schemas); }
        if (d.kind == 4) { tc.schemas = schema_cons(d.s1, fields_of(d), tc.schemas); }
        if (d.kind == 5) {
            tc.models = mdl_cons(d.s1, resolve_type(d.c1), resolve_type(d.c2), tc.models);
        }
    }

    // Foreign signatures are registered like any other function, so a call
    // across the boundary is checked rather than trusted.
    for (int f = 0; f < nd; f = f + 1) {
        Node d2 = nv_get(&decls, f);
        if (d2.kind == 74) {
            NodeVec ffns = nv_at(d2.v1);
            int nff = ffns.len;
            for (int q = 0; q < nff; q = q + 1) {
                Node ff = nv_get(&ffns, q);
                int frt = ty_ptr(ty_new("void"));
                if (ff.c1 != 0) { frt = resolve_type(ff.c1); }
                NodeVec fps = nv_at(ff.v1);
                int fplist = 0;
                int fnp = fps.len;
                for (int r = fnp - 1; r >= 0; r = r - 1) {
                    Node fprm = nv_get(&fps, r);
                    fplist = sym_cons(fprm.s1, resolve_type(fprm.c1), fplist);
                }
                tc.fns = fn_cons(ff.s2, frt, fplist, fnp, tc.fns);
            }
        }
    }

    NodeVec fns = nv_at(unit.v3);
    int nf = fns.len;
    for (int j = 0; j < nf; j = j + 1) {
        Node f = nv_get(&fns, j);
        int rt = ty_ptr(ty_new("void"));
        if (f.c1 != 0) { rt = resolve_type(f.c1); }
        NodeVec ps = nv_at(f.v1);
        int plist = 0;
        int np = ps.len;
        // Built in reverse so the list reads in declaration order.
        for (int k = np - 1; k >= 0; k = k - 1) {
            Node prm = nv_get(&ps, k);
            plist = sym_cons(prm.s1, resolve_type(prm.c1), plist);
        }
        tc.fns = fn_cons(f.s2, rt, plist, np, tc.fns);
    }
}

int fields_of(Node d) {
    NodeVec fs = nv_at(d.v1);
    int head = 0;
    int n = fs.len;
    for (int i = n - 1; i >= 0; i = i - 1) {
        Node f = nv_get(&fs, i);
        head = sym_cons(f.s1, resolve_type(f.c1), head);
    }
    return head;
}

// ── Expression inference ─────────────────────────────────────────────────────

int infer(TC &tc, int node_p, int scope_p) {
    if (node_p == 0) { return 0; }
    Node e = node_at(node_p);
    int k = e.kind;

    if (k == 50) { return ty_ptr(ty_new("int")); }
    if (k == 51) { return ty_ptr(ty_new("float")); }
    if (k == 52) { return ty_ptr(ty_new("str")); }
    if (k == 53) { return ty_ptr(ty_new("bool")); }

    if (k == 54) {                                   // Identifier
        int t = scp_lookup(scope_p, e.s1);
        if (t == 0) {
            // A bare model name is the model itself, so Strata code never has
            // to name a generated C global.
            if (mdl_find(tc.models, e.s1) != 0) { return 0; }
            // A bare function name is a reference — an event handler passed to
            // a layout element, for instance — not an undefined variable.
            if (fn_find(tc.fns, e.s1) != 0) { return 0; }
            if (scp_has(scope_p, e.s1) == 0) {
                StringBuilder sb = sb_new();
                sb_append(&sb, "Undefined identifier '");
                sb_append(&sb, e.s1);
                sb_append(&sb, "'");
                emit(&tc, "E001", sb_to_str(&sb), e.line, e.col);
            }
            return 0;
        }
        return t;
    }

    if (k == 40) { return infer_binary(&tc, e, scope_p); }
    if (k == 41) { return infer(&tc, e.c1, scope_p); }
    if (k == 42) { return infer_call(&tc, e, scope_p); }
    if (k == 43) { return infer(&tc, e.c1, scope_p); }
    if (k == 44) { return ty_ptr(ty_new(e.s1)); }
    if (k == 45) { return infer_predict(&tc, e, scope_p); }

    if (k == 47) {                                   // ListLiteral
        NodeVec els = nv_at(e.v1);
        if (els.len == 0) { return ty_ptr(ty_list(ty_new("void"))); }
        int first = infer(&tc, node_ptr(nv_get(&els, 0)), scope_p);
        if (first == 0) { return 0; }
        return ty_ptr(ty_list(ty_at(first)));
    }

    if (k == 48) {                                   // MemberAccess
        int ot = infer(&tc, e.c1, scope_p);
        if (ot == 0) { return 0; }
        Ty o = ty_at(ot);
        if (o.is_list == 1) {
            // A collection has no fields of its own; without this the mistake
            // reaches the C compiler as a pointer error in generated code.
            StringBuilder sb = sb_new();
            sb_append(&sb, "'"); sb_append(&sb, e.s1);
            sb_append(&sb, "' is a field of the row, not of '");
            sb_append(&sb, ty_str(ot)); sb_append(&sb, "'");
            emit(&tc, "E003", sb_to_str(&sb), e.line, e.col);
            return 0;
        }
        int sch = schema_find(tc.schemas, o.name);
        if (sch == 0) { return 0; }
        Schema s = schema_at(sch);
        int f = sym_find(s.fields, e.s1);
        if (f == 0) {
            StringBuilder sb = sb_new();
            sb_append(&sb, "Field '");
            sb_append(&sb, e.s1);
            sb_append(&sb, "' not in '");
            sb_append(&sb, o.name);
            sb_append(&sb, "'");
            emit(&tc, "E004", sb_to_str(&sb), e.line, e.col);
            return 0;
        }
        Sym fs = sym_at(f);
        return fs.ty;
    }

    if (k == 49) {                                   // IndexExpr
        int bt = infer(&tc, e.c1, scope_p);
        int it = infer(&tc, e.c2, scope_p);
        if (it != 0) {
            Ty i = ty_at(it);
            if (str_eq(i.name, "int") == 0) {
                StringBuilder sb = sb_new();
                sb_append(&sb, "List index must be 'int', got '");
                sb_append(&sb, ty_str(it));
                sb_append(&sb, "'");
                emit(&tc, "E001", sb_to_str(&sb), e.line, e.col);
            }
        }
        if (bt == 0) { return 0; }
        Ty b = ty_at(bt);
        if (b.is_list == 1) { return b.elem; }
        if (str_eq(b.name, "str") == 1) { return ty_ptr(ty_new("int")); }
        StringBuilder sb2 = sb_new();
        sb2_msg(&sb2, ty_str(bt));
        emit(&tc, "E003", sb_to_str(&sb2), e.line, e.col);
        return 0;
    }

    if (k == 55) {                                   // render L  -> str
        if (scp_lookup(tc.globals, e.s1) == 0) {
            StringBuilder sb = sb_new();
            sb_append(&sb, "'"); sb_append(&sb, e.s1);
            sb_append(&sb, "' is not a layout or report");
            emit(&tc, "E002", sb_to_str(&sb), e.line, e.col);
        }
        return ty_ptr(ty_new("str"));
    }

    if (k == 46) {                                   // QueryExpr
        int sch = schema_find(tc.schemas, e.s1);
        if (sch == 0) {
            StringBuilder qsb = sb_new();
            sb_append(&qsb, "Database '");
            sb_append(&qsb, e.s1);
            sb_append(&qsb, "' not declared");
            emit(&tc, "E004", sb_to_str(&qsb), e.line, e.col);
            return 0;
        }
        validate_query(&tc, e.c1, e.s1, e.line, e.col);
        return ty_ptr(ty_list(ty_new(e.s1)));
    }

    return 0;
}

def sb2_msg(StringBuilder &sb, str tname) {
    sb_append(&sb, "Cannot index into '");
    sb_append(&sb, tname);
    sb_append(&sb, "' — not a list or str");
}

int is_comparison_op(str op) {
    if (str_eq(op, "==")) { return 1; }
    if (str_eq(op, "!=")) { return 1; }
    if (str_eq(op, "<"))  { return 1; }
    if (str_eq(op, ">"))  { return 1; }
    if (str_eq(op, "<=")) { return 1; }
    if (str_eq(op, ">=")) { return 1; }
    if (str_eq(op, "&&")) { return 1; }
    if (str_eq(op, "||")) { return 1; }
    return 0;
}

int infer_binary(TC &tc, Node e, int scope_p) {
    int left = infer(&tc, e.c1, scope_p);
    int right = infer(&tc, e.c2, scope_p);
    if (is_comparison_op(e.s1) == 1) { return ty_ptr(ty_new("bool")); }

    if (str_eq(e.s1, "+") == 1) {
        if (left != 0) {
            Ty l = ty_at(left);
            if (str_eq(l.name, "str") == 1) {
                // An uninferred right operand means a call into a module that
                // is not being checked, not a contaminated boundary.
                if (right != 0) {
                    Ty r = ty_at(right);
                    if (str_eq(r.name, "str") == 0) {
                        StringBuilder sb = sb_new();
                        sb_append(&sb, "Cannot concat str with '");
                        sb_append(&sb, ty_str(right));
                        sb_append(&sb, "' — wrap in str()");
                        emit(&tc, "E005", sb_to_str(&sb), e.line, e.col);
                    }
                }
                return ty_ptr(ty_new("str"));
            }
        }
    }
    if (left != 0) { return left; }
    return right;
}

// `count(rows)`, and `sum(xs)` / `sum(rows.column)` for the rest.
//
// A column projection is written `rows.amount` and is checked against the row
// type's schema, so a renamed column fails the build here the same way it
// fails at a query or in a layout. That contract is why aggregation belongs in
// the language rather than in a library.
//
// sum, min and max keep the element's own type; avg is always float and count
// always int.
int infer_aggregate(TC &tc, Node e, int scope_p) {
    NodeVec args = nv_at(e.v1);
    int na = args.len;
    int is_count = str_eq(e.s1, "count");

    if (na != 1) {
        StringBuilder sb = sb_new();
        sb_append(&sb, "'"); sb_append(&sb, e.s1);
        sb_append(&sb, "' takes one argument, got "); sb_append(&sb, str(na));
        emit(&tc, "E002", sb_to_str(&sb), e.line, e.col);
        if (is_count == 1) { return ty_ptr(ty_new("int")); }
        return ty_ptr(ty_new("float"));
    }

    Node arg = nv_get(&args, 0);
    if (is_count == 1) {
        int at = infer(&tc, node_ptr(arg), scope_p);
        if (at != 0) {
            Ty t = ty_at(at);
            if (t.is_list == 0) {
                StringBuilder sb = sb_new();
                sb_append(&sb, "'count' expects a list, got '");
                sb_append(&sb, ty_str(at)); sb_append(&sb, "'");
                emit(&tc, "E003", sb_to_str(&sb), e.line, e.col);
            }
        }
        return ty_ptr(ty_new("int"));
    }

    int elem = 0;
    if (arg.kind == 48) {
        int bt = infer(&tc, arg.c1, scope_p);
        int handled = 0;
        if (bt != 0) {
            Ty b = ty_at(bt);
            if (b.is_list == 1) {
                handled = 1;
                str rowname = ty_str(b.elem);
                int sch = schema_find(tc.schemas, rowname);
                if (sch == 0) {
                    StringBuilder sb = sb_new();
                    sb_append(&sb, "'"); sb_append(&sb, e.s1);
                    sb_append(&sb, "' cannot project '"); sb_append(&sb, arg.s1);
                    sb_append(&sb, "' out of '"); sb_append(&sb, ty_str(bt));
                    sb_append(&sb, "' — its element is not a record");
                    emit(&tc, "E003", sb_to_str(&sb), e.line, e.col);
                    return ty_ptr(ty_new("float"));
                }
                Schema sc = schema_at(sch);
                int fp = sym_find(sc.fields, arg.s1);
                if (fp == 0) {
                    StringBuilder sb = sb_new();
                    sb_append(&sb, "Column '"); sb_append(&sb, arg.s1);
                    sb_append(&sb, "' does not exist in '"); sb_append(&sb, rowname);
                    sb_append(&sb, "'");
                    emit(&tc, "E004", sb_to_str(&sb), e.line, e.col);
                    return ty_ptr(ty_new("float"));
                }
                Sym col = sym_at(fp);
                elem = col.ty;
            }
        }
        if (handled == 0) { elem = infer(&tc, node_ptr(arg), scope_p); }
    }
    if (arg.kind != 48) {
        int at = infer(&tc, node_ptr(arg), scope_p);
        if (at != 0) {
            Ty t = ty_at(at);
            if (t.is_list == 1) { elem = t.elem; }
            if (t.is_list == 0) {
                StringBuilder sb = sb_new();
                sb_append(&sb, "'"); sb_append(&sb, e.s1);
                sb_append(&sb, "' expects a list, got '"); sb_append(&sb, ty_str(at));
                sb_append(&sb, "'");
                emit(&tc, "E003", sb_to_str(&sb), e.line, e.col);
                return ty_ptr(ty_new("float"));
            }
        }
    }

    if (elem != 0) {
        str en = ty_str(elem);
        int numeric = 0;
        if (str_eq(en, "int") == 1)   { numeric = 1; }
        if (str_eq(en, "float") == 1) { numeric = 1; }
        if (numeric == 0) {
            StringBuilder sb = sb_new();
            sb_append(&sb, "'"); sb_append(&sb, e.s1);
            sb_append(&sb, "' expects numbers, got '"); sb_append(&sb, en);
            sb_append(&sb, "'");
            emit(&tc, "E003", sb_to_str(&sb), e.line, e.col);
            return ty_ptr(ty_new("float"));
        }
    }
    if (str_eq(e.s1, "avg") == 1) { return ty_ptr(ty_new("float")); }
    if (elem != 0) { return elem; }
    return ty_ptr(ty_new("float"));
}

int infer_call(TC &tc, Node e, int scope_p) {
    NodeVec args = nv_at(e.v1);
    int na = args.len;

    if (str_eq(e.s1, "str") == 1) {
        for (int i = 0; i < na; i = i + 1) { infer(&tc, node_ptr(nv_get(&args, i)), scope_p); }
        return ty_ptr(ty_new("str"));
    }
    if (str_eq(e.s1, "int") == 1) {
        for (int i = 0; i < na; i = i + 1) { infer(&tc, node_ptr(nv_get(&args, i)), scope_p); }
        return ty_ptr(ty_new("int"));
    }
    if (str_eq(e.s1, "float") == 1) {
        for (int i = 0; i < na; i = i + 1) { infer(&tc, node_ptr(nv_get(&args, i)), scope_p); }
        return ty_ptr(ty_new("float"));
    }
    if (str_eq(e.s1, "bool") == 1) {
        for (int i = 0; i < na; i = i + 1) { infer(&tc, node_ptr(nv_get(&args, i)), scope_p); }
        return ty_ptr(ty_new("bool"));
    }
    if (str_eq(e.s1, "native") == 1) { return 0; }
    // Aggregates are reserved names with a fixed result type. There is no
    // evaluation behind them yet — see the roadmap — but they are not
    // undefined functions either.
    if (str_eq(e.s1, "len") == 1) {
        for (int i = 0; i < na; i = i + 1) { infer(&tc, node_ptr(nv_get(&args, i)), scope_p); }
        return ty_ptr(ty_new("int"));
    }
    int agg = 0;
    if (str_eq(e.s1, "sum") == 1)   { agg = 1; }
    if (str_eq(e.s1, "avg") == 1)   { agg = 1; }
    if (str_eq(e.s1, "min") == 1)   { agg = 1; }
    if (str_eq(e.s1, "max") == 1)   { agg = 1; }
    if (str_eq(e.s1, "count") == 1) { agg = 1; }
    if (agg == 1) { return infer_aggregate(&tc, e, scope_p); }

    int fp = fn_find(tc.fns, e.s1);
    if (fp == 0) {
        // Unknown callee: arguments are still ordinary expressions and every
        // rule applies inside them.
        for (int i = 0; i < na; i = i + 1) { infer(&tc, node_ptr(nv_get(&args, i)), scope_p); }
        if (tc.strict_calls == 1) {
            if (is_runtime_builtin(e.s1) == 0) {
                if (name_in_list(tc.imported, e.s1) == 0) {
                    if (schema_find(tc.schemas, e.s1) == 0) {
                        StringBuilder sb = sb_new();
                        sb_append(&sb, "Undefined function '");
                        sb_append(&sb, e.s1);
                        sb_append(&sb, "'");
                        emit(&tc, "E002", sb_to_str(&sb), e.line, e.col);
                    }
                }
            }
        }
        return 0;
    }

    Fn f = fn_at(fp);
    if (na != f.nparams) {
        StringBuilder sb = sb_new();
        sb_append(&sb, "'");
        sb_append(&sb, e.s1);
        sb_append(&sb, "' expects ");
        sb_append(&sb, str(f.nparams));
        sb_append(&sb, " args, got ");
        sb_append(&sb, str(na));
        emit(&tc, "E002", sb_to_str(&sb), e.line, e.col);
        return f.rt;
    }

    int cur = f.params;
    for (int i = 0; i < na; i = i + 1) {
        int at = infer(&tc, node_ptr(nv_get(&args, i)), scope_p);
        Sym ps = sym_at(cur);
        if (at != 0) {
            if (ty_compatible(ps.ty, at) == 0) {
                StringBuilder sb = sb_new();
                sb_append(&sb, "Arg ");
                sb_append(&sb, str(i + 1));
                sb_append(&sb, " of '");
                sb_append(&sb, e.s1);
                sb_append(&sb, "': expected '");
                sb_append(&sb, ty_str(ps.ty));
                sb_append(&sb, "', got '");
                sb_append(&sb, ty_str(at));
                sb_append(&sb, "'");
                emit(&tc, "E005", sb_to_str(&sb), e.line, e.col);
            }
        }
        cur = ps.next;
    }
    return f.rt;
}

int infer_predict(TC &tc, Node e, int scope_p) {
    int mp = mdl_find(tc.models, e.s1);
    if (mp == 0) {
        StringBuilder sb = sb_new();
        sb_append(&sb, "Model '");
        sb_append(&sb, e.s1);
        sb_append(&sb, "' not declared");
        emit(&tc, "E006", sb_to_str(&sb), e.line, e.col);
        infer(&tc, e.c1, scope_p);
        return 0;
    }
    Mdl m = mdl_at(mp);
    int at = infer(&tc, e.c1, scope_p);
    if (at != 0) {
        Ty a = ty_at(at);
        Ty want = ty_at(m.in_ty);
        if (a.is_tensor == 1) {
            if (a.rows != want.rows) { tensor_drift(&tc, e, want, a); }
            if (a.rows == want.rows) {
                if (a.cols != want.cols) { tensor_drift(&tc, e, want, a); }
            }
        }
    }
    return m.out_ty;
}

def tensor_drift(TC &tc, Node e, Ty want, Ty got) {
    StringBuilder sb = sb_new();
    sb_append(&sb, "Tensor shape mismatch for '");
    sb_append(&sb, e.s1);
    sb_append(&sb, "': expected [");
    sb_append(&sb, str(want.rows));
    sb_append(&sb, ",");
    sb_append(&sb, str(want.cols));
    sb_append(&sb, "], got [");
    sb_append(&sb, str(got.rows));
    sb_append(&sb, ",");
    sb_append(&sb, str(got.cols));
    sb_append(&sb, "]");
    emit(&tc, "E006", sb_to_str(&sb), e.line, e.col);
}

// ── Statement checking ───────────────────────────────────────────────────────

def check_var_decl(TC &tc, Node st, int scope_p) {
    int declared = resolve_type(st.c1);
    if (st.c2 == 0) {
        Scp s0 = scp_at(scope_p);
        scp_define(&s0, st.s1, declared);
        return;
    }
    // A query on the right of a declaration is checked here and the
    // declaration returns: a query into a record type yields the first match
    // rather than a list, so the element type is what must be compatible.
    Node qval = node_at(st.c2);
    if (qval.kind == 46) {
        int qsch = schema_find(tc.schemas, qval.s1);
        if (qsch == 0) {
            StringBuilder qsb = sb_new();
            sb_append(&qsb, "Database '");
            sb_append(&qsb, qval.s1);
            sb_append(&qsb, "' not declared");
            emit(&tc, "E004", sb_to_str(&qsb), st.line, st.col);
        }
        if (qsch != 0) { validate_query(&tc, qval.c1, qval.s1, st.line, st.col); }
        Scp sq = scp_at(scope_p);
        scp_define(&sq, st.s1, declared);
        return;
    }

    int actual = infer(&tc, st.c2, scope_p);

    Node val = node_at(st.c2);
    // A list literal is checked element by element so the diagnostic points at
    // the element that is wrong rather than at the whole collection.
    if (val.kind == 47) {
        Ty d = ty_at(declared);
        if (d.is_list == 1) {
            NodeVec els = nv_at(val.v1);
            int n = els.len;
            for (int i = 0; i < n; i = i + 1) {
                int et = infer(&tc, node_ptr(nv_get(&els, i)), scope_p);
                if (et != 0) {
                    if (ty_compatible(d.elem, et) == 0) {
                        StringBuilder sb = sb_new();
                        sb_append(&sb, "List '");
                        sb_append(&sb, st.s1);
                        sb_append(&sb, "' element ");
                        sb_append(&sb, str(i + 1));
                        sb_append(&sb, ": expected '");
                        sb_append(&sb, ty_str(d.elem));
                        sb_append(&sb, "', got '");
                        sb_append(&sb, ty_str(et));
                        sb_append(&sb, "'");
                        emit(&tc, "E003", sb_to_str(&sb), st.line, st.col);
                    }
                }
            }
        }
    }

    if (val.kind != 47) {
        if (val.kind != 46) {
            if (actual != 0) {
                if (ty_compatible(declared, actual) == 0) {
                    StringBuilder sb = sb_new();
                    sb_append(&sb, "Type mismatch: '");
                    sb_append(&sb, st.s1);
                    sb_append(&sb, "' declared as '");
                    sb_append(&sb, ty_str(declared));
                    sb_append(&sb, "' but assigned '");
                    sb_append(&sb, ty_str(actual));
                    sb_append(&sb, "'");
                    emit(&tc, "E001", sb_to_str(&sb), st.line, st.col);
                }
            }
        }
    }

    Scp sc = scp_at(scope_p);
    scp_define(&sc, st.s1, declared);
}

def validate_query(TC &tc, int cond_p, str schema, int line, int col) {
    if (cond_p == 0) { return; }
    Node c = node_at(cond_p);
    if (c.kind != 40) { return; }
    Node left = node_at(c.c1);
    if (left.kind == 54) {
        int sch = schema_find(tc.schemas, schema);
        Schema s = schema_at(sch);
        if (sym_find(s.fields, left.s1) == 0) {
            StringBuilder sb = sb_new();
            sb_append(&sb, "Column '");
            sb_append(&sb, left.s1);
            sb_append(&sb, "' does not exist in '");
            sb_append(&sb, schema);
            sb_append(&sb, "'");
            emit(&tc, "E004", sb_to_str(&sb), line, col);
        }
    }
    validate_query(&tc, c.c1, schema, line, col);
    validate_query(&tc, c.c2, schema, line, col);
}

def check_stmt(TC &tc, Node st, int scope_p) {
    int k = st.kind;

    if (k == 20) { check_var_decl(&tc, st, scope_p); return; }

    if (k == 21) {                                   // return
        int rt = tc.current_return;
        Ty want = ty_at(rt);
        if (st.c1 == 0) {
            if (str_eq(want.name, "void") == 0) {
                StringBuilder sb = sb_new();
                sb_append(&sb, "Function must return '");
                sb_append(&sb, ty_str(rt));
                sb_append(&sb, "' but returns nothing");
                emit(&tc, "E002", sb_to_str(&sb), st.line, st.col);
            }
            return;
        }
        int at = infer(&tc, st.c1, scope_p);
        if (at != 0) {
            if (ty_compatible(rt, at) == 0) {
                StringBuilder sb = sb_new();
                sb_append(&sb, "Return mismatch: expected '");
                sb_append(&sb, ty_str(rt));
                sb_append(&sb, "', got '");
                sb_append(&sb, ty_str(at));
                sb_append(&sb, "'");
                emit(&tc, "E002", sb_to_str(&sb), st.line, st.col);
            }
        }
        return;
    }

    if (k == 22) {                                   // if
        infer(&tc, st.c1, scope_p);
        check_block(&tc, st.v1, scope_p);
        if (st.v2 != 0) { check_block(&tc, st.v2, scope_p); }
        return;
    }

    if (k == 29) {                                   // while
        infer(&tc, st.c1, scope_p);
        check_block(&tc, st.v1, scope_p);
        return;
    }

    if (k == 30) {                                   // for
        Scp inner = scp_new(scope_p);
        int ip = scp_ptr(inner);
        if (st.c1 != 0) { check_stmt(&tc, node_at(st.c1), ip); }
        infer(&tc, st.c2, ip);
        if (st.c3 != 0) { check_stmt(&tc, node_at(st.c3), ip); }
        check_block(&tc, st.v1, ip);
        return;
    }

    if (k == 28) {                                   // assignment
        int tt = infer(&tc, st.c1, scope_p);
        int vt = infer(&tc, st.c2, scope_p);
        if (tt != 0) {
            if (vt != 0) {
                if (ty_compatible(tt, vt) == 0) {
                    Node tgt = node_at(st.c1);
                    StringBuilder sb = sb_new();
                    sb_append(&sb, "Type mismatch: '");
                    sb_append(&sb, tgt.s1);
                    sb_append(&sb, "' is '");
                    sb_append(&sb, ty_str(tt));
                    sb_append(&sb, "' but assigned '");
                    sb_append(&sb, ty_str(vt));
                    sb_append(&sb, "'");
                    emit(&tc, "E001", sb_to_str(&sb), st.line, st.col);
                }
            }
        }
        return;
    }

    if (k == 27) {                                   // insert
        int sch = schema_find(tc.schemas, st.s1);
        if (sch == 0) {
            StringBuilder sb = sb_new();
            sb_append(&sb, "Database '");
            sb_append(&sb, st.s1);
            sb_append(&sb, "' not declared");
            emit(&tc, "E004", sb_to_str(&sb), st.line, st.col);
            return;
        }
        Schema s = schema_at(sch);
        NodeVec pairs = nv_at(st.v1);
        int n = pairs.len;
        for (int i = 0; i < n; i = i + 1) {
            Node pair = nv_get(&pairs, i);
            if (sym_find(s.fields, pair.s1) == 0) {
                StringBuilder sb = sb_new();
                sb_append(&sb, "Column '");
                sb_append(&sb, pair.s1);
                sb_append(&sb, "' does not exist in '");
                sb_append(&sb, st.s1);
                sb_append(&sb, "'");
                emit(&tc, "E004", sb_to_str(&sb), st.line, st.col);
            }
            infer(&tc, pair.c1, scope_p);
        }
        return;
    }

    if (k == 75) {                                   // save / load
        if (schema_find(tc.schemas, st.s2) == 0) {
            StringBuilder sb = sb_new();
            sb_append(&sb, "Database '"); sb_append(&sb, st.s2);
            sb_append(&sb, "' not declared");
            emit(&tc, "E004", sb_to_str(&sb), st.line, st.col);
        }
        return;
    }
    if (k == 71) { check_element(&tc, st, scope_p); return; }
    if (k == 73) { check_for_in(&tc, st, scope_p); return; }
    if (k == 26) { check_verify_in(&tc, st, scope_p); return; }
    if (k == 23) { infer(&tc, st.c1, scope_p); return; }
    if (k == 24) { infer(&tc, st.c1, scope_p); return; }
}

def check_verify(TC &tc, Node decl) { check_verify_in(&tc, decl, tc.globals); }

// A nested `assert "label" { ... }` sees the bindings of the block it sits in,
// so the enclosing scope is the parent rather than the global one.
def check_verify_in(TC &tc, Node decl, int parent) {
    Scp s = scp_new(parent);
    int sp = scp_ptr(s);
    NodeVec body = nv_at(decl.v1);
    int n = body.len;
    for (int i = 0; i < n; i = i + 1) { check_stmt(&tc, nv_get(&body, i), sp); }
}

// A report's datasource is a query and gets the same E004 treatment, and its
// metrics are expressions evaluated where `rows` is the datasource result.
// Without either, a typo'd column or a mistyped metric compiled silently.
def check_report(TC &tc, Node decl) {
    if (decl.c1 == 0) { return; }
    Node q = node_at(decl.c1);
    if (q.kind != 46) { return; }
    if (schema_find(tc.schemas, q.s1) == 0) {
        StringBuilder sb = sb_new();
        sb_append(&sb, "Database '");
        sb_append(&sb, q.s1);
        sb_append(&sb, "' not declared");
        emit(&tc, "E004", sb_to_str(&sb), decl.line, decl.col);
        return;
    }
    validate_query(&tc, q.c1, q.s1, decl.line, decl.col);

    Scp ms = scp_new(tc.globals);
    scp_define(&ms, "rows", ty_ptr(ty_list(ty_new(q.s1))));
    int mp = scp_ptr(ms);
    NodeVec mets = nv_at(decl.v1);
    int nm = mets.len;
    for (int i = 0; i < nm; i = i + 1) {
        Node m = nv_get(&mets, i);
        int declared = resolve_type(m.c1);
        int actual = infer(&tc, m.c2, mp);
        if (actual != 0) {
            if (ty_compatible(declared, actual) == 0) {
                StringBuilder sb = sb_new();
                sb_append(&sb, "Type mismatch: metric '");
                sb_append(&sb, m.s1);
                sb_append(&sb, "' declared as '");
                sb_append(&sb, ty_str(declared));
                sb_append(&sb, "' but assigned '");
                sb_append(&sb, ty_str(actual));
                sb_append(&sb, "'");
                emit(&tc, "E001", sb_to_str(&sb), m.line, m.col);
            }
        }
    }
}

def check_layout(TC &tc, Node decl) {
    // A layout is checked like any other body. This is the point of the
    // language: a field rendered on screen resolves against the database
    // schema at build time, so renaming a column fails the build at the line
    // of UI that used it.
    Scp s = scp_new(tc.globals);
    int sp = scp_ptr(s);
    NodeVec body = nv_at(decl.v1);
    int n = body.len;
    for (int i = 0; i < n; i = i + 1) { check_stmt(&tc, nv_get(&body, i), sp); }
}

def check_element(TC &tc, Node st, int scope_p) {
    // A bare identifier after a tag names the element rather than referring to
    // a value, so it is only inferred when it actually resolves.
    if (st.c1 != 0) {
        Node label = node_at(st.c1);
        int bare = 0;
        if (label.kind == 54) {
            if (scp_lookup(scope_p, label.s1) == 0) { bare = 1; }
        }
        if (bare == 0) { infer(&tc, st.c1, scope_p); }
    }
    NodeVec props = nv_at(st.v1);
    int np = props.len;
    for (int i = 0; i < np; i = i + 1) {
        Node pr = nv_get(&props, i);
        infer(&tc, pr.c1, scope_p);
    }
    Scp inner = scp_new(scope_p);
    int ip = scp_ptr(inner);
    NodeVec kids = nv_at(st.v2);
    int nk = kids.len;
    for (int j = 0; j < nk; j = j + 1) { check_stmt(&tc, nv_get(&kids, j), ip); }
}

def check_for_in(TC &tc, Node st, int scope_p) {
    int ct = infer(&tc, st.c1, scope_p);
    Scp inner = scp_new(scope_p);
    int ip = scp_ptr(inner);
    if (ct != 0) {
        Ty c = ty_at(ct);
        if (c.is_list == 1) { scp_define(&inner, st.s1, c.elem); }
        if (c.is_list == 0) {
            StringBuilder sb = sb_new();
            sb_append(&sb, "'");
            sb_append(&sb, st.s1);
            sb_append(&sb, "' iterates '");
            sb_append(&sb, ty_str(ct));
            sb_append(&sb, "', which is not a list");
            emit(&tc, "E003", sb_to_str(&sb), st.line, st.col);
        }
    }
    NodeVec body = nv_at(st.v1);
    int n = body.len;
    for (int i = 0; i < n; i = i + 1) { check_stmt(&tc, nv_get(&body, i), ip); }
}

def check_block(TC &tc, int vec_p, int parent) {
    Scp inner = scp_new(parent);
    int ip = scp_ptr(inner);
    NodeVec body = nv_at(vec_p);
    int n = body.len;
    for (int i = 0; i < n; i = i + 1) { check_stmt(&tc, nv_get(&body, i), ip); }
}

// ── Entry point ──────────────────────────────────────────────────────────────

// Check a file whose imports have been resolved, so an unknown callee is an
// error rather than a shrug. `root` is the tree the std/ and compiler/ module
// directories sit under.
int check_unit_root(str root, Node unit) { return check_unit_project(root, "", unit); }

// Check a file together with the project it belongs to: `src_dir` is where an
// `app` import resolves, and the modules it pulls in have their declarations
// registered so a schema in one file is visible to the module that queries it.
int check_unit_project(str root, str src_dir, Node unit) {
    NodeVec mods = nv_new();
    str seen = "";
    int unresolved = 0;
    collect_modules_from(root, src_dir, unit, &mods, &seen, &unresolved);

    // This file's OWN imports that do not resolve. Only these get a
    // diagnostic: a transitive one has no line here to point at. They also
    // decide whether the undefined-call check arms, because an import we
    // cannot follow means we do not know what is reachable.
    int root_unresolved = 0;
    NodeVec imps = nv_at(unit.v1);
    int ni = imps.len;
    for (int i = 0; i < ni; i = i + 1) {
        Node imp = nv_get(&imps, i);
        int local = 0;
        if (str_eq(imp.s2, "std") == 1) { local = 1; }
        if (str_eq(imp.s2, "compiler") == 1) { local = 1; }
        if (str_eq(imp.s2, "app") == 1) { if (str_len(src_dir) > 0) { local = 1; } }
        int found = 0;
        if (local == 1) {
            str mp = module_path(root, imp.s2, imp.s1);
            if (str_eq(imp.s2, "app") == 1) { mp = app_module_path(src_dir, imp.s1); }
            if (file_exists(mp) == 1) { found = 1; }
        }
        if (found == 0) { root_unresolved = root_unresolved + 1; }
    }

    StringBuilder names = sb_new();
    sb_append(&names, ",");
    int nm = mods.len;
    for (int m = 0; m < nm; m = m + 1) {
        Node mu = nv_get(&mods, m);
        NodeVec mfns = nv_at(mu.v3);
        int mf = mfns.len;
        for (int i = 0; i < mf; i = i + 1) {
            Node f = nv_get(&mfns, i);
            sb_append(&names, f.s2); sb_append(&names, ",");
        }
        NodeVec mdecls = nv_at(mu.v2);
        int md = mdecls.len;
        for (int j = 0; j < md; j = j + 1) {
            Node d = nv_get(&mdecls, j);
            sb_append(&names, d.s1); sb_append(&names, ",");
            if (d.kind == 74) {
                NodeVec ffns = nv_at(d.v1);
                int nff = ffns.len;
                for (int q = 0; q < nff; q = q + 1) {
                    Node ff = nv_get(&ffns, q);
                    sb_append(&names, ff.s2); sb_append(&names, ",");
                }
            }
        }
    }
    // An import with no local checkout means the picture is incomplete, so
    // the check stays off rather than guessing — the same rule the oracle uses.
    int strict = 1;
    if (root_unresolved > 0) { strict = 0; }
    return check_unit_mode_project(unit, strict, sb_to_str(&names), root, src_dir,
    1, nv_ptr(mods));
}

// Check the bodies of the project's own modules, not its dependencies.
//
// Only the file being compiled used to have its bodies checked, so a column
// renamed in schema.sta failed the build at main.sta and sailed past
// views.sta — the UI tier, which is the one the cross-tier claim is about.
//
// `std` and `compiler` modules are deliberately not checked here: they are
// dependencies with their own suite, and re-checking them on every application
// build would put their diagnostics in every user's output. A module carries
// its path in s2 only when it came from `app`, which is how they are told
// apart.
def check_project_modules(TC &tc, int mods_p) {
    NodeVec mods = nv_at(mods_p);
    int nm = mods.len;
    for (int m = 0; m < nm; m = m + 1) {
        Node mu = nv_get(&mods, m);
        if (str_len(mu.s2) > 0) {
            tc.current_file = mu.s2;
            register_module_functions(&tc, mu);
            NodeVec decls = nv_at(mu.v2);
            int nd = decls.len;
            for (int d = 0; d < nd; d = d + 1) {
                Node dec = nv_get(&decls, d);
                if (dec.kind == 6)  { check_report(&tc, dec); }
                if (dec.kind == 70) { check_layout(&tc, dec); }
            }
            check_unit_functions(&tc, mu);
        }
    }
    tc.current_file = "";
}

// An imported module's own functions, so a call between two project modules
// resolves while its bodies are being checked.
def register_module_functions(TC &tc, Node unit) {
    NodeVec fns = nv_at(unit.v3);
    int n = fns.len;
    for (int i = 0; i < n; i = i + 1) {
        Node f = nv_get(&fns, i);
        int rt = ty_ptr(ty_new("void"));
        if (f.c1 != 0) { rt = resolve_type(f.c1); }
        NodeVec ps = nv_at(f.v1);
        int plist = 0;
        int np = ps.len;
        for (int k = np - 1; k >= 0; k = k - 1) {
            Node prm = nv_get(&ps, k);
            plist = sym_cons(prm.s1, resolve_type(prm.c1), plist);
        }
        tc.fns = fn_cons(f.s2, rt, plist, np, tc.fns);
    }
}

int check_unit(Node unit) { return check_unit_mode(unit, 0, ""); }

int check_unit_mode(Node unit, int strict, str imported) {
    return check_unit_mode_imports(unit, strict, imported, "", 0);
}

int check_unit_mode_imports(Node unit, int strict, str imported,
str root, int report_imports) {
    return check_unit_mode_project(unit, strict, imported, root, "",
    report_imports, 0);
}

int check_unit_mode_project(Node unit, int strict, str imported, str root,
str src_dir, int report_imports, int mods_p) {
    TC tc = tc_new();
    tc.strict_calls = strict;
    tc.imported = imported;
    if (report_imports == 1) { report_unresolved_imports(&tc, unit, root, src_dir); }
    register_decls(&tc, unit);
    // Schemas and models an import brings in. Without this an application
    // cannot be more than one file: a `database` in schema.sta is invisible to
    // the module that queries it, and every query reports E004 against a table
    // that is right there.
    if (mods_p != 0) { register_imported_decls(&tc, mods_p); }

    // Checked after functions are registered: a layout may reference a handler
    // declared further down the file, and either may precede its database.
    NodeVec all_decls = nv_at(unit.v2);
    int ndecl = all_decls.len;
    for (int d = 0; d < ndecl; d = d + 1) {
        Node dec = nv_get(&all_decls, d);
        if (dec.kind == 6) { check_report(&tc, dec); }
        if (dec.kind == 70) { check_layout(&tc, dec); }
        if (dec.kind == 26) { check_verify(&tc, dec); }
    }

    check_unit_functions(&tc, unit);
    if (mods_p != 0) { check_project_modules(&tc, mods_p); }
    return tc.error_count;
}

def check_unit_functions(TC &tc, Node unit) {
    NodeVec fns = nv_at(unit.v3);
    int nf = fns.len;
    for (int i = 0; i < nf; i = i + 1) {
        Node f = nv_get(&fns, i);
        Scp fs = scp_new(tc.globals);
        int fp = scp_ptr(fs);
        NodeVec ps = nv_at(f.v1);
        int np = ps.len;
        for (int j = 0; j < np; j = j + 1) {
            Node prm = nv_get(&ps, j);
            scp_define(&fs, prm.s1, resolve_type(prm.c1));
        }
        tc.current_return = ty_ptr(ty_new("void"));
        if (f.c1 != 0) { tc.current_return = resolve_type(f.c1); }
        NodeVec body = nv_at(f.v2);
        int nb = body.len;
        for (int b = 0; b < nb; b = b + 1) { check_stmt(&tc, nv_get(&body, b), fp); }
    }
}
