int parse_unary(ParserState &ps, NodePool &pool) {
    Token t=ps_peek(&ps);
    if(ps_kind(&ps)==77){ps_advance(&ps);int idx=node_new(&pool,AST_UNARY,t.line,t.col);int o=parse_unary(&ps,&pool);native "ASTNode* _n=&((ASTNode*)(uintptr_t)$pool.buf_ptr)[$idx];_n->sval=\"!\";_n->left=$o;";return idx;}
    if(ps_kind(&ps)==65){ps_advance(&ps);int idx=node_new(&pool,AST_UNARY,t.line,t.col);int o=parse_unary(&ps,&pool);native "ASTNode* _n=&((ASTNode*)(uintptr_t)$pool.buf_ptr)[$idx];_n->sval=\"-\";_n->left=$o;";return idx;}
    if(ps_kind(&ps)==63){ps_advance(&ps);int idx=node_new(&pool,AST_BORROW,t.line,t.col);int tgt=parse_primary(&ps,&pool);native "((ASTNode*)(uintptr_t)$pool.buf_ptr)[$idx].left=$tgt;";return idx;}
    int base=parse_primary(&ps,&pool);
    if(ps_kind(&ps)==62){
        Token ct=ps_advance(&ps);
        Token tt=ps_consume(&ps,4);
        int idx=node_new(&pool,AST_CAST,ct.line,ct.col);
        native "ASTNode* _n=&((ASTNode*)(uintptr_t)$pool.buf_ptr)[$idx];_n->left=$base;_n->sval=$tt.value;";
        return idx;
    }
    return base;
}

int parse_addition(ParserState &ps, NodePool &pool) {
    int left=parse_unary(&ps,&pool);
    native "
    while(1){
        int64_t _k=ps_kind(&$ps);
        if(_k!=64&&_k!=65)break;
        Token _t=ps_advance(&$ps);
        int64_t _r=parse_unary(&$ps,&$pool);
        int64_t _idx=node_new(&$pool,6,_t.line,_t.col);
        ASTNode* _n=&((ASTNode*)(uintptr_t)$pool.buf_ptr)[_idx];
        _n->sval=_t.value;_n->left=$left;_n->right=_r;$left=_idx;
    }
    ";
    return left;
}

int parse_comparison(ParserState &ps, NodePool &pool) {
    int left=parse_addition(&ps,&pool);
    native "
    while(1){
        int64_t _k=ps_kind(&$ps);
        if(_k!=71&&_k!=72&&_k!=73&&_k!=74)break;
        Token _t=ps_advance(&$ps);
        int64_t _r=parse_addition(&$ps,&$pool);
        int64_t _idx=node_new(&$pool,6,_t.line,_t.col);
        ASTNode* _n=&((ASTNode*)(uintptr_t)$pool.buf_ptr)[_idx];
        _n->sval=_t.value;_n->left=$left;_n->right=_r;$left=_idx;
    }
    ";
    return left;
}

int parse_equality(ParserState &ps, NodePool &pool) {
    int left=parse_comparison(&ps,&pool);
    native "
    while(1){
        int64_t _k=ps_kind(&$ps);
        if(_k!=69&&_k!=70)break;
        Token _t=ps_advance(&$ps);
        int64_t _r=parse_comparison(&$ps,&$pool);
        int64_t _idx=node_new(&$pool,6,_t.line,_t.col);
        ASTNode* _n=&((ASTNode*)(uintptr_t)$pool.buf_ptr)[_idx];
        _n->sval=_t.value;_n->left=$left;_n->right=_r;$left=_idx;
    }
    ";
    return left;
}

int parse_and(ParserState &ps, NodePool &pool) {
    int left=parse_equality(&ps,&pool);
    native "
    while(ps_kind(&$ps)==75){
        Token _t=ps_advance(&$ps);
        int64_t _r=parse_equality(&$ps,&$pool);
        int64_t _idx=node_new(&$pool,6,_t.line,_t.col);
        ASTNode* _n=&((ASTNode*)(uintptr_t)$pool.buf_ptr)[_idx];
        _n->sval=_t.value;_n->left=$left;_n->right=_r;$left=_idx;
    }
    ";
