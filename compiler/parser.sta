// STRATA COMPILER — compiler/parser.sta
// The Strata parser, written in Strata.
//
// Stage 2 of the self-hosting pipeline. Must produce a syntax tree identical
// to compiler/parser.py, which is the oracle; test_suite/parser_diff.py
// enforces that by comparing emitted JSON structurally.
//
// Uses only the frozen seed subset (see SEED_SUBSET.md).

import io    from std;
import str   from std;
import lexer from compiler;

// ── Node ─────────────────────────────────────────────────────────────────────
//
// Strata has no sum types, so every syntax node is one record with slots that
// each node kind interprets by convention:
//   s1 s2 s3   strings (name, op, callee, member, ...)
//   i1 i2      integers (literal value, tensor dims, borrow flag)
//   f1         float literal
//   c1 c2 c3   single children, held as Node* cast to int (0 means absent)
//   v1 v2 v3   child lists, held as NodeVec* cast to int (0 means absent)
//
// Pointers are carried as int rather than as record fields so that "absent"
// is representable as 0 without a null-record concept in the language.

database Node {
    int kind;
    str s1; str s2; str s3;
    int i1; int i2;
    float f1;
    int c1; int c2; int c3;
    int v1; int v2; int v3;
    int line; int col;
}

database NodeVec { int ptr; int len; int cap; }

// ── Pointer helpers ──────────────────────────────────────────────────────────

Node node_new(int kind) {
    native "
    Node* _n=(Node*)calloc(1,sizeof(Node));
    _n->kind=$kind; _n->s1=\"\"; _n->s2=\"\"; _n->s3=\"\";
    return _n;
    ";
}

int node_ptr(Node n) { native "return (int64_t)(uintptr_t)$n;"; }
Node node_at(int p)  { native "return (Node*)(uintptr_t)$p;"; }

NodeVec nv_new() {
    native "
    NodeVec* _v=(NodeVec*)malloc(sizeof(NodeVec));
    _v->cap=16; _v->len=0;
    _v->ptr=(int64_t)(uintptr_t)malloc(16*sizeof(void*));
    return _v;
    ";
}

int nv_ptr(NodeVec v) { native "return (int64_t)(uintptr_t)$v;"; }
NodeVec nv_at(int p)  { native "return (NodeVec*)(uintptr_t)$p;"; }

def nv_push(NodeVec &v, Node n) {
    native "
    if($v->len>=$v->cap){
        $v->cap*=2;
        $v->ptr=(int64_t)(uintptr_t)realloc((void*)(uintptr_t)$v->ptr,$v->cap*sizeof(void*));
    }
    ((Node**)(uintptr_t)$v->ptr)[$v->len]=$n; $v->len+=1;
    ";
}

Node nv_get(NodeVec &v, int i) { native "return ((Node**)(uintptr_t)$v->ptr)[$i];"; }

// ── JSON emission ────────────────────────────────────────────────────────────

str json_escape(str v) {
    StringBuilder sb = sb_new();
    int n = str_len(v);
    for (int i = 0; i < n; i = i + 1) {
        int c = v[i];
        if (c == 34) { sb_append(&sb, "\\\""); }
        if (c == 92) { sb_append(&sb, "\\\\"); }
        if (c == 10) { sb_append(&sb, "\\n"); }
        if (c == 9)  { sb_append(&sb, "\\t"); }
        if (c == 13) { sb_append(&sb, "\\r"); }
        if (c != 34) { if (c != 92) { if (c != 10) { if (c != 9) { if (c != 13) {
                            sb_append(&sb, char_str(c));
                        } } } } }
    }
    return sb_to_str(&sb);
}

str jstr(str v) {
    StringBuilder sb = sb_new();
    sb_append(&sb, "\"");
    sb_append(&sb, json_escape(v));
    sb_append(&sb, "\"");
    return sb_to_str(&sb);
}

def jfield(StringBuilder &sb, str key, str value_json) {
    sb_append(&sb, ",");
    sb_append(&sb, jstr(key));
    sb_append(&sb, ":");
    sb_append(&sb, value_json);
}

// A child slot: emits the node's JSON, or null when the slot is 0.
str jchild(int p) {
    if (p == 0) { return "null"; }
    return node_json(node_at(p));
}

// A child list: emits a JSON array, or null when the slot is 0.
str jlist(int p) {
    if (p == 0) { return "null"; }
    NodeVec v = nv_at(p);
    StringBuilder sb = sb_new();
    sb_append(&sb, "[");
    int n = v.len;
    for (int i = 0; i < n; i = i + 1) {
        if (i > 0) { sb_append(&sb, ","); }
        sb_append(&sb, node_json(nv_get(&v, i)));
    }
    sb_append(&sb, "]");
    return sb_to_str(&sb);
}

// Node kinds:
//  1 CompilationUnit  2 ImportDecl   3 DatabaseDecl  4 ProtocolDecl
//  5 ModelDecl        6 ReportDecl   7 ReportMetric  8 FieldDecl
//  9 FunctionDecl    10 Param       11 PrimitiveType 12 ListType
// 13 TensorType      20 VarDecl     21 ReturnStmt    22 IfStmt
// 23 ExprStmt        24 AssertStmt  25 RenderStmt    26 VerifyBlock
// 27 InsertStmt      28 AssignStmt  29 WhileStmt     30 ForStmt
// 31 BreakStmt       32 ContinueStmt  33 HiddenLayer
// 40 BinaryExpr      41 UnaryExpr   42 CallExpr      43 BorrowExpr
// 44 CastExpr        45 PredictExpr 46 QueryExpr     47 ListLiteral
// 48 MemberAccess    49 IndexExpr   50 IntLiteral    51 FloatLiteral
// 52 StrLiteral      53 BoolLiteral 54 Identifier   55 RenderExpr

str node_name(int k) {
    if (k == 1)  { return "CompilationUnit"; }
    if (k == 2)  { return "ImportDecl"; }
    if (k == 3)  { return "DatabaseDecl"; }
    if (k == 4)  { return "ProtocolDecl"; }
    if (k == 5)  { return "ModelDecl"; }
    if (k == 33) { return "HiddenLayer"; }
    if (k == 55) { return "RenderExpr"; }
    if (k == 6)  { return "ReportDecl"; }
    if (k == 7)  { return "ReportMetric"; }
    if (k == 8)  { return "FieldDecl"; }
    if (k == 9)  { return "FunctionDecl"; }
    if (k == 10) { return "Param"; }
    if (k == 11) { return "PrimitiveType"; }
    if (k == 12) { return "ListType"; }
    if (k == 13) { return "TensorType"; }
    if (k == 20) { return "VarDecl"; }
    if (k == 21) { return "ReturnStmt"; }
    if (k == 22) { return "IfStmt"; }
    if (k == 23) { return "ExprStmt"; }
    if (k == 24) { return "AssertStmt"; }
    if (k == 25) { return "RenderStmt"; }
    if (k == 26) { return "VerifyBlock"; }
    if (k == 27) { return "InsertStmt"; }
    if (k == 28) { return "AssignStmt"; }
    if (k == 29) { return "WhileStmt"; }
    if (k == 30) { return "ForStmt"; }
    if (k == 31) { return "BreakStmt"; }
    if (k == 32) { return "ContinueStmt"; }
    if (k == 40) { return "BinaryExpr"; }
    if (k == 41) { return "UnaryExpr"; }
    if (k == 42) { return "CallExpr"; }
    if (k == 43) { return "BorrowExpr"; }
    if (k == 44) { return "CastExpr"; }
    if (k == 45) { return "PredictExpr"; }
    if (k == 46) { return "QueryExpr"; }
    if (k == 47) { return "ListLiteral"; }
    if (k == 48) { return "MemberAccess"; }
    if (k == 49) { return "IndexExpr"; }
    if (k == 50) { return "IntLiteral"; }
    if (k == 51) { return "FloatLiteral"; }
    if (k == 52) { return "StrLiteral"; }
    if (k == 53) { return "BoolLiteral"; }
    if (k == 54) { return "Identifier"; }
    if (k == 70) { return "LayoutDecl"; }
    if (k == 71) { return "Element"; }
    if (k == 72) { return "Prop"; }
    if (k == 73) { return "ForInStmt"; }
    if (k == 74) { return "ForeignDecl"; }
    if (k == 75) { return "TableIOStmt"; }
    return "Unknown";
}

str node_json(Node n) {
    int k = n.kind;
    StringBuilder sb = sb_new();
    sb_append(&sb, "{\"node\":");
    sb_append(&sb, jstr(node_name(k)));

    if (k == 1) {
        jfield(&sb, "imports", jlist(n.v1));
        jfield(&sb, "declarations", jlist(n.v2));
        jfield(&sb, "functions", jlist(n.v3));
    }
    if (k == 2) { jfield(&sb, "name", jstr(n.s1)); jfield(&sb, "source", jstr(n.s2)); }
    if (k == 3) { jfield(&sb, "name", jstr(n.s1)); jfield(&sb, "fields", jlist(n.v1)); }
    if (k == 4) { jfield(&sb, "name", jstr(n.s1)); jfield(&sb, "fields", jlist(n.v1)); }
    if (k == 5) {
        jfield(&sb, "name", jstr(n.s1));
        jfield(&sb, "input", jchild(n.c1));
        jfield(&sb, "output", jchild(n.c2));
        jfield(&sb, "hidden", jlist(n.v1));
    }
    if (k == 33) {
        jfield(&sb, "width", str(n.i1));
        jfield(&sb, "activation", jstr(n.s1));
    }
    if (k == 55) { jfield(&sb, "target", jstr(n.s1)); }
    if (k == 6) {
        jfield(&sb, "name", jstr(n.s1));
        jfield(&sb, "title", jstr(n.s2));
        jfield(&sb, "datasource", jchild(n.c1));
        jfield(&sb, "metrics", jlist(n.v1));
    }
    if (k == 7) {
        jfield(&sb, "type", jchild(n.c1));
        jfield(&sb, "name", jstr(n.s1));
        jfield(&sb, "expr", jchild(n.c2));
    }
    if (k == 8) { jfield(&sb, "type", jchild(n.c1)); jfield(&sb, "name", jstr(n.s1)); }
    if (k == 9) {
        jfield(&sb, "kind", jstr(n.s1));
        jfield(&sb, "return_type", jchild(n.c1));
        jfield(&sb, "name", jstr(n.s2));
        jfield(&sb, "params", jlist(n.v1));
        jfield(&sb, "body", jlist(n.v2));
    }
    if (k == 10) {
        jfield(&sb, "type", jchild(n.c1));
        jfield(&sb, "name", jstr(n.s1));
        if (n.i1 == 1) { jfield(&sb, "borrow", "true"); }
        if (n.i1 == 0) { jfield(&sb, "borrow", "false"); }
    }
    if (k == 11) { jfield(&sb, "name", jstr(n.s1)); }
    if (k == 12) { jfield(&sb, "element_type", jchild(n.c1)); }
    if (k == 13) {
        jfield(&sb, "dtype", jstr(n.s1));
        jfield(&sb, "rows", str(n.i1));
        jfield(&sb, "cols", str(n.i2));
    }
    if (k == 20) {
        jfield(&sb, "type", jchild(n.c1));
        jfield(&sb, "name", jstr(n.s1));
        jfield(&sb, "value", jchild(n.c2));
    }
    if (k == 21) { jfield(&sb, "value", jchild(n.c1)); }
    if (k == 22) {
        jfield(&sb, "condition", jchild(n.c1));
        jfield(&sb, "then_block", jlist(n.v1));
        jfield(&sb, "else_block", jlist(n.v2));
    }
    if (k == 23) { jfield(&sb, "expr", jchild(n.c1)); }
    if (k == 24) { jfield(&sb, "condition", jchild(n.c1)); }
    if (k == 25) { jfield(&sb, "report", jstr(n.s1)); jfield(&sb, "path", jstr(n.s2)); }
    if (k == 26) { jfield(&sb, "label", jstr(n.s1)); jfield(&sb, "assertions", jlist(n.v1)); }
    if (k == 27) { jfield(&sb, "target", jstr(n.s1)); jfield(&sb, "assignments", jassigns(n.v1)); }
    if (k == 28) { jfield(&sb, "target", jchild(n.c1)); jfield(&sb, "value", jchild(n.c2)); }
    if (k == 29) { jfield(&sb, "condition", jchild(n.c1)); jfield(&sb, "body", jlist(n.v1)); }
    if (k == 30) {
        jfield(&sb, "init", jchild(n.c1));
        jfield(&sb, "condition", jchild(n.c2));
        jfield(&sb, "step", jchild(n.c3));
        jfield(&sb, "body", jlist(n.v1));
    }
    if (k == 40) {
        jfield(&sb, "op", jstr(n.s1));
        jfield(&sb, "left", jchild(n.c1));
        jfield(&sb, "right", jchild(n.c2));
    }
    if (k == 41) { jfield(&sb, "op", jstr(n.s1)); jfield(&sb, "operand", jchild(n.c1)); }
    if (k == 42) { jfield(&sb, "callee", jstr(n.s1)); jfield(&sb, "args", jlist(n.v1)); }
    if (k == 43) { jfield(&sb, "target", jchild(n.c1)); }
    if (k == 44) { jfield(&sb, "source", jchild(n.c1)); jfield(&sb, "target_type", jstr(n.s1)); }
    if (k == 45) { jfield(&sb, "model", jstr(n.s1)); jfield(&sb, "arg", jchild(n.c1)); }
    if (k == 46) { jfield(&sb, "source", jstr(n.s1)); jfield(&sb, "condition", jchild(n.c1)); }
    if (k == 47) { jfield(&sb, "elements", jlist(n.v1)); }
    if (k == 48) { jfield(&sb, "obj", jchild(n.c1)); jfield(&sb, "member", jstr(n.s1)); }
    if (k == 49) { jfield(&sb, "target", jchild(n.c1)); jfield(&sb, "index", jchild(n.c2)); }
    if (k == 50) { jfield(&sb, "value", str(n.i1)); }
    if (k == 51) { jfield(&sb, "value", n.s1); }
    if (k == 52) { jfield(&sb, "value", jstr(n.s1)); }
    if (k == 53) {
        if (n.i1 == 1) { jfield(&sb, "value", "true"); }
        if (n.i1 == 0) { jfield(&sb, "value", "false"); }
    }
    if (k == 54) { jfield(&sb, "name", jstr(n.s1)); }
    if (k == 70) { jfield(&sb, "name", jstr(n.s1)); jfield(&sb, "body", jlist(n.v1)); }
    if (k == 71) {
        jfield(&sb, "tag", jstr(n.s1));
        jfield(&sb, "label", jchild(n.c1));
        jfield(&sb, "props", jlist(n.v1));
        jfield(&sb, "children", jlist(n.v2));
    }
    if (k == 72) { jfield(&sb, "name", jstr(n.s1)); jfield(&sb, "value", jchild(n.c1)); }
    if (k == 75) {
        jfield(&sb, "op", jstr(n.s1));
        jfield(&sb, "table", jstr(n.s2));
        jfield(&sb, "path", jstr(n.s3));
    }
    if (k == 74) {
        jfield(&sb, "header", jstr(n.s1));
        jfield(&sb, "link", jstr(n.s2));
        jfield(&sb, "functions", jlist(n.v1));
    }
    if (k == 73) {
        jfield(&sb, "var", jstr(n.s1));
        jfield(&sb, "collection", jchild(n.c1));
        jfield(&sb, "body", jlist(n.v1));
    }

    sb_append(&sb, "}");
    return sb_to_str(&sb);
}

// Insert assignments are {"column":..., "value":...} pairs rather than nodes.
str jassigns(int p) {
    if (p == 0) { return "null"; }
    NodeVec v = nv_at(p);
    StringBuilder sb = sb_new();
    sb_append(&sb, "[");
    int n = v.len;
    for (int i = 0; i < n; i = i + 1) {
        if (i > 0) { sb_append(&sb, ","); }
        Node pair = nv_get(&v, i);
        sb_append(&sb, "{\"column\":");
        sb_append(&sb, jstr(pair.s1));
        sb_append(&sb, ",\"value\":");
        sb_append(&sb, jchild(pair.c1));
        sb_append(&sb, "}");
    }
    sb_append(&sb, "]");
    return sb_to_str(&sb);
}

// ── Parser state ─────────────────────────────────────────────────────────────

database P { TokVec toks; int pos; int no_index; }

P p_new(TokVec t) {
    native "P* _p=(P*)calloc(1,sizeof(P)); _p->toks=$t; _p->pos=0; return _p;";
}

Token p_peek(P &p, int off) { return vec_get(&p.toks, p.pos + off); }
int p_kind(P &p, int off)   { Token t = p_peek(&p, off); return t.kind; }
int p_at_end(P &p)          { if (p_kind(&p, 0) == 5) { return 1; } return 0; }

Token p_advance(P &p) {
    Token t = vec_get(&p.toks, p.pos);
    p.pos = p.pos + 1;
    return t;
}

int p_check(P &p, int kind) { if (p_kind(&p, 0) == kind) { return 1; } return 0; }

// A word that is meaningful only in one position is matched by spelling, so it
// remains an ordinary identifier everywhere else.
int p_at_word(P &p, str w) {
    Token t = p_peek(&p, 0);
    if (t.kind != 4) { return 0; }
    if (str_eq(t.value, w) == 1) { return 1; }
    return 0;
}

Token p_expect_word(P &p, str w) {
    if (p_at_word(&p, w) == 0) {
        eprint("[STRATA PARSE ERROR] expected keyword");
        eprint(w);
    }
    return p_advance(&p);
}

Token p_expect(P &p, int kind) {
    if (p_check(&p, kind) == 0) {
        Token bad = p_peek(&p, 0);
        eprint("[STRATA PARSE ERROR] unexpected token");
        eprint(bad.value);
    }
    return p_advance(&p);
}

def n_pos(Node n, Token t) { n.line = t.line; n.col = t.col; }

// ── Types ────────────────────────────────────────────────────────────────────

int is_type_kind(int k) {
    if (k == 10) { return 1; }   // int
    if (k == 11) { return 1; }   // float
    if (k == 12) { return 1; }   // str
    if (k == 13) { return 1; }   // void
    if (k == 16) { return 1; }   // bool
    if (k == 14) { return 1; }   // list
    if (k == 15) { return 1; }   // tensor
    if (k == 4)  { return 1; }   // IDENT — a record type name
    return 0;
}

Node parse_type(P &p) {
    Token t = p_peek(&p, 0);

    if (t.kind == 14) {                       // list[T]
        Token open = p_advance(&p);
        p_expect(&p, 54);
        Node inner = parse_type(&p);
        p_expect(&p, 55);
        Node n = node_new(12);
        n.c1 = node_ptr(inner);
        n_pos(n, open);
        return n;
    }

    if (t.kind == 15) {                       // tensor[dtype, rows, cols]
        Token open = p_advance(&p);
        p_expect(&p, 54);
        Token dt = p_advance(&p);
        p_expect(&p, 58);
        Token rows = p_advance(&p);
        p_expect(&p, 58);
        Token cols = p_advance(&p);
        p_expect(&p, 55);
        Node n = node_new(13);
        n.s1 = dt.value;
        n.i1 = str_to_int(rows.value);
        n.i2 = str_to_int(cols.value);
        n_pos(n, open);
        return n;
    }

    Token prim = p_advance(&p);
    Node n = node_new(11);
    n.s1 = prim.value;
    n_pos(n, prim);
    return n;
}

// ── Declarations ─────────────────────────────────────────────────────────────

str parse_module_path(P &p) {
    StringBuilder sb = sb_new();
    Token first = p_advance(&p);
    sb_append(&sb, first.value);
    while (p_check(&p, 59) == 1) {            // '.'
        p_advance(&p);
        Token part = p_advance(&p);
        sb_append(&sb, ".");
        sb_append(&sb, part.value);
    }
    return sb_to_str(&sb);
}

Node parse_import(P &p) {
    Token t = p_expect(&p, 21);
    str name = parse_module_path(&p);
    p_expect(&p, 22);                          // from
    str source = parse_module_path(&p);
    p_expect(&p, 56);                          // ;
    Node n = node_new(2);
    n.s1 = name; n.s2 = source;
    n_pos(n, t);
    return n;
}

// database / protocol share a shape; `kind` selects the node type.
Node parse_record(P &p, int kw, int node_kind) {
    Token t = p_expect(&p, kw);
    Token name = p_expect(&p, 4);
    p_expect(&p, 50);                          // {
    NodeVec fields = nv_new();
    while (p_check(&p, 51) == 0) {
        if (p_at_end(&p) == 1) { break; }
        Node ftype = parse_type(&p);
        Token fname = p_expect(&p, 4);
        p_expect(&p, 56);
        Node f = node_new(8);
        f.c1 = node_ptr(ftype);
        f.s1 = fname.value;
        n_pos(f, fname);
        nv_push(&fields, f);
    }
    p_expect(&p, 51);                          // }
    Node n = node_new(node_kind);
    n.s1 = name.value;
    n.v1 = nv_ptr(fields);
    n_pos(n, t);
    return n;
}

Node parse_tensor_type(P &p) {
    Token t = p_expect(&p, 15);                // tensor
    p_expect(&p, 54);
    Token dt = p_advance(&p);
    p_expect(&p, 58);
    Token rows = p_expect(&p, 1);
    p_expect(&p, 58);
    Token cols = p_expect(&p, 1);
    p_expect(&p, 55);
    Node n = node_new(13);
    n.s1 = dt.value;
    n.i1 = str_to_int(rows.value);
    n.i2 = str_to_int(cols.value);
    n_pos(n, t);
    return n;
}

Node parse_model(P &p) {
    Token t = p_expect(&p, 27);
    Token name = p_expect(&p, 4);
    p_expect(&p, 50);
    p_expect_word(&p, "input");
    p_expect(&p, 57);                          // :
    Node in_t = parse_tensor_type(&p);
    p_expect(&p, 56);

    // Hidden layers sit between input and output. `hidden` and the activation
    // names are contextual, so a variable may still be called `relu` outside a
    // model block.
    NodeVec hidden = nv_new();
    while (p_at_word(&p, "hidden") == 1) {
        Token h = p_advance(&p);
        p_expect(&p, 57);                      // :
        Token w = p_expect(&p, 1);             // width
        str act = "none";
        if (p_check(&p, 4) == 1) {
            Token a = p_advance(&p);
            act = a.value;
            if (activation_char(act) == "?") {
                StringBuilder sb = sb_new();
                sb_append(&sb, "Unknown activation '");
                sb_append(&sb, act);
                sb_append(&sb, "'; Strata has relu, sigmoid and none");
                eprint("[STRATA PARSE ERROR] unknown activation");
                eprint(act);
            }
        }
        p_expect(&p, 56);
        Node hl = node_new(33);
        hl.i1 = str_to_int(w.value);
        hl.s1 = act;
        hl.line = h.line; hl.col = h.col;
        nv_push(&hidden, hl);
    }

    p_expect_word(&p, "output");
    p_expect(&p, 57);
    Node out_t = parse_tensor_type(&p);
    p_expect(&p, 56);
    p_expect(&p, 51);
    Node n = node_new(5);
    n.s1 = name.value;
    n.c1 = node_ptr(in_t);
    n.c2 = node_ptr(out_t);
    n.v1 = nv_ptr(hidden);
    n_pos(n, t);
    return n;
}

// The letter an activation carries in the generated model instance, or "?"
// for one the language does not have.
str activation_char(str a) {
    if (str_eq(a, "relu") == 1) { return "r"; }
    if (str_eq(a, "sigmoid") == 1) { return "s"; }
    if (str_eq(a, "none") == 1) { return "n"; }
    return "?";
}

Node parse_report(P &p) {
    Token t = p_expect(&p, 29);
    Token name = p_expect(&p, 4);
    p_expect(&p, 50);
    Node n = node_new(6);
    n.s1 = name.value;
    n.s2 = "";
    NodeVec mets = nv_new();
    n_pos(n, t);

    while (p_check(&p, 51) == 0) {
        if (p_at_end(&p) == 1) { break; }
        if (p_at_word(&p, "title") == 1) {
            p_advance(&p); p_expect(&p, 57);
            Token title_tok = p_advance(&p);
            n.s2 = title_tok.value;
            p_expect(&p, 58);
        }
        if (p_at_word(&p, "datasource") == 1) {
            p_advance(&p); p_expect(&p, 57);
            Token src = p_expect(&p, 4);
            p_expect(&p, 76);
            p_expect(&p, 54);
            Node cond = parse_expr(&p);
            p_expect(&p, 55);
            p_expect(&p, 58);
            Node q = node_new(46);
            q.s1 = src.value;
            q.c1 = node_ptr(cond);
            n_pos(q, t);
            n.c1 = node_ptr(q);
        }
        if (p_at_word(&p, "metrics") == 1) {
            p_advance(&p); p_expect(&p, 57);
            p_expect(&p, 50);
            while (p_check(&p, 51) == 0) {
                if (p_at_end(&p) == 1) { break; }
                Node mt = parse_type(&p);
                Token mname = p_expect(&p, 4);
                p_expect(&p, 60);
                Node mexpr = parse_expr(&p);
                p_expect(&p, 56);
                Node m = node_new(7);
                m.c1 = node_ptr(mt);
                m.s1 = mname.value;
                m.c2 = node_ptr(mexpr);
                // The oracle positions a metric at its TYPE, not its name, and
                // the E001 diagnostic quotes that column.
                m.line = mt.line; m.col = mt.col;
                nv_push(&mets, m);
            }
            p_expect(&p, 51);
        }
    }
    p_expect(&p, 51);
    n.v1 = nv_ptr(mets);
    return n;
}

// ── Functions ────────────────────────────────────────────────────────────────

NodeVec parse_params(P &p) {
    NodeVec params = nv_new();
    while (p_check(&p, 53) == 0) {            // until ')'
        if (p_at_end(&p) == 1) { break; }
        Node ptype = parse_type(&p);
        int borrow = 0;
        if (p_check(&p, 61) == 1) { p_advance(&p); borrow = 1; }
        Token pname = p_expect(&p, 4);
        Node prm = node_new(10);
        prm.c1 = node_ptr(ptype);
        prm.s1 = pname.value;
        prm.i1 = borrow;
        n_pos(prm, pname);
        nv_push(&params, prm);
        if (p_check(&p, 58) == 1) { p_advance(&p); }
    }
    return params;
}

NodeVec parse_body(P &p) {
    NodeVec body = nv_new();
    while (p_check(&p, 51) == 0) {            // until '}'
        if (p_at_end(&p) == 1) { break; }
        nv_push(&body, parse_statement(&p));
    }
    return body;
}

// kindsel: 0 = typed function, 1 = def, 2 = stream
Node parse_function(P &p, int kindsel) {
    Token t = p_peek(&p, 0);
    int rt = 0;
    if (kindsel == 0) {
        Node r = parse_type(&p);
        rt = node_ptr(r);
    }
    if (kindsel != 0) { p_advance(&p); }      // consume def / stream

    Token name = p_expect(&p, 4);
    p_expect(&p, 52);                          // (
    NodeVec params = parse_params(&p);
    p_expect(&p, 53);                          // )

    Node n = node_new(9);
    n.s1 = "function";
    if (kindsel == 1) { n.s1 = "def"; }
    if (kindsel == 2) { n.s1 = "stream"; }
    n.c1 = rt;
    n.s2 = name.value;
    n.v1 = nv_ptr(params);
    n_pos(n, t);

    // Forward declaration: no body.
    if (p_check(&p, 56) == 1) {
        p_advance(&p);
        n.v2 = nv_ptr(nv_new());
        return n;
    }

    p_expect(&p, 50);                          // {
    NodeVec body = parse_body(&p);
    p_expect(&p, 51);                          // }
    n.v2 = nv_ptr(body);
    return n;
}

// ── Statements ───────────────────────────────────────────────────────────────

Node parse_var_decl(P &p, int want_semicolon) {
    Node vtype = parse_type(&p);
    Token name = p_expect(&p, 4);

    // `T name;` declares without initialising; the value is the type's zero.
    if (want_semicolon == 1) {
        if (p_check(&p, 56) == 1) {
            p_advance(&p);
            Node u = node_new(20);
            u.c1 = node_ptr(vtype);
            u.s1 = name.value;
            u.line = vtype.line; u.col = vtype.col;
            return u;
        }
    }
    p_expect(&p, 60);                          // =

    Node n = node_new(20);
    n.c1 = node_ptr(vtype);
    n.s1 = name.value;
    // The oracle positions a declaration at its TYPE, not its name, and
    // diagnostics quote that column. Syntax-tree comparison cannot catch this
    // because to_dict() does not serialise positions.
    n.line = vtype.line; n.col = vtype.col;

    // Query form: list[T] name = Source <- [cond];
    if (p_kind(&p, 0) == 4) {
        if (p_kind(&p, 1) == 76) {
            Token src = p_advance(&p);
            p_advance(&p);                     // <-
            p_expect(&p, 54);                  // [
            Node cond = parse_expr(&p);
            p_expect(&p, 55);                  // ]
            if (want_semicolon == 1) { p_expect(&p, 56); }
            Node q = node_new(46);
            q.s1 = src.value;
            q.c1 = node_ptr(cond);
            n_pos(q, src);
            n.c2 = node_ptr(q);
            return n;
        }
    }

    Node val = parse_expr(&p);
    if (want_semicolon == 1) { p_expect(&p, 56); }
    n.c2 = node_ptr(val);
    return n;
}

Node parse_assignment(P &p, int want_semicolon) {
    Token t = p_peek(&p, 0);
    Node target = parse_unary(&p);
    p_expect(&p, 60);                          // =
    Node value = parse_expr(&p);
    if (want_semicolon == 1) { p_expect(&p, 56); }
    Node n = node_new(28);
    n.c1 = node_ptr(target);
    n.c2 = node_ptr(value);
    n_pos(n, t);
    return n;
}

// Is the statement beginning here an assignment? Scans past member and index
// access to find a '=' that is not part of '=='.
int looks_like_assignment(P &p) {
    if (p_kind(&p, 0) != 4) { return 0; }
    int j = 1;
    int depth = 0;
    while (j < 64) {
        int k = p_kind(&p, j);
        if (k == 54) { depth = depth + 1; }
        if (k == 55) { depth = depth - 1; }
        if (depth == 0) {
            if (k == 60) { return 1; }
            if (k != 59) { if (k != 4) { if (k != 55) { return 0; } } }
        }
        if (k == 56) { return 0; }
        if (k == 5)  { return 0; }
        j = j + 1;
    }
    return 0;
}

NodeVec parse_block(P &p) {
    p_expect(&p, 50);
    NodeVec body = parse_body(&p);
    p_expect(&p, 51);
    return body;
}

Node parse_statement(P &p) {
    Token t = p_peek(&p, 0);
    int k = t.kind;

    // native "..." — raw C, modelled as ExprStmt(CallExpr("native", [str]))
    if (k == 4) {
        if (str_eq(t.value, "native")) {
            p_advance(&p);
            Token lit = p_advance(&p);
            if (p_check(&p, 56) == 1) { p_advance(&p); }
            Node arg = node_new(52);
            arg.s1 = lit.value;
            n_pos(arg, lit);
            Node call = node_new(42);
            call.s1 = "native";
            NodeVec args = nv_new();
            nv_push(&args, arg);
            call.v1 = nv_ptr(args);
            n_pos(call, t);
            Node st = node_new(23);
            st.c1 = node_ptr(call);
            n_pos(st, t);
            return st;
        }
    }

    if (k == 19) {                             // return
        p_advance(&p);
        Node n = node_new(21);
        n_pos(n, t);
        if (p_check(&p, 56) == 1) { p_advance(&p); return n; }
        Node v = parse_expr(&p);
        p_expect(&p, 56);
        n.c1 = node_ptr(v);
        return n;
    }

    if (k == 17) {                             // if
        p_advance(&p);
        p_expect(&p, 52);
        Node cond = parse_expr(&p);
        p_expect(&p, 53);
        NodeVec then_block = parse_block(&p);
        Node n = node_new(22);
        n.c1 = node_ptr(cond);
        n.v1 = nv_ptr(then_block);
        n_pos(n, t);
        if (p_check(&p, 18) == 1) {            // else
            p_advance(&p);
            NodeVec else_block = parse_block(&p);
            n.v2 = nv_ptr(else_block);
        }
        return n;
    }

    if (k == 41) {                             // while
        p_advance(&p);
        p_expect(&p, 52);
        Node cond = parse_expr(&p);
        p_expect(&p, 53);
        NodeVec body = parse_block(&p);
        Node n = node_new(29);
        n.c1 = node_ptr(cond);
        n.v1 = nv_ptr(body);
        n_pos(n, t);
        return n;
    }

    if (k == 42) {                             // for
        p_advance(&p);
        p_expect(&p, 52);
        Node n = node_new(30);
        n_pos(n, t);
        if (p_check(&p, 56) == 0) {
            if (is_type_kind(p_kind(&p, 0)) == 1) {
                if (p_kind(&p, 1) == 4) {
                    Node init = parse_var_decl(&p, 0);
                    n.c1 = node_ptr(init);
                }
            }
            if (n.c1 == 0) {
                Node init = parse_assignment(&p, 0);
                n.c1 = node_ptr(init);
            }
        }
        p_expect(&p, 56);
        Node cond = parse_expr(&p);
        n.c2 = node_ptr(cond);
        p_expect(&p, 56);
        if (p_check(&p, 53) == 0) {
            Node step = parse_assignment(&p, 0);
            n.c3 = node_ptr(step);
        }
        p_expect(&p, 53);
        NodeVec body = parse_block(&p);
        n.v1 = nv_ptr(body);
        return n;
    }

    if (k == 43) { p_advance(&p); p_expect(&p, 56);
        Node n = node_new(31); n_pos(n, t); return n; }
    if (k == 44) { p_advance(&p); p_expect(&p, 56);
        Node n = node_new(32); n_pos(n, t); return n; }

    if (k == 20) {                             // assert
        p_advance(&p);
        // `assert "label" { ... }` groups assertions under a description.
        if (p_kind(&p, 0) == 3) {
            if (p_kind(&p, 1) == 50) {
                Token lab = p_advance(&p);
                p_expect(&p, 50);
                NodeVec vbody = nv_new();
                while (p_check(&p, 51) == 0) {
                    if (p_at_end(&p) == 1) { break; }
                    nv_push(&vbody, parse_statement(&p));
                }
                p_expect(&p, 51);
                Node vb = node_new(26);
                vb.s1 = lab.value;
                vb.v1 = nv_ptr(vbody);
                n_pos(vb, t);
                return vb;
            }
        }
        Node cond = parse_expr(&p);
        p_expect(&p, 56);
        Node n = node_new(24);
        n.c1 = node_ptr(cond);
        n_pos(n, t);
        return n;
    }

    // `save T to "p";` / `load T from "p";` — contextual words.
    if (k == 4) {
        int is_save = p_at_word(&p, "save");
        int is_load = p_at_word(&p, "load");
        if (is_save + is_load > 0) {
            if (p_kind(&p, 1) == 4) {
                Token op = p_advance(&p);
                Token table = p_expect(&p, 4);
                if (is_save == 1) { p_expect_word(&p, "to"); }
                // `from` lexes as a keyword, not an identifier, so it is
                // consumed by kind. Expecting it as a word printed a parse
                // error on every file using `load` — recoverable, so the AST
                // was right and the syntax-tree differential never saw it.
                if (is_save == 0) { p_expect(&p, 22); }
                Token path = p_advance(&p);
                p_expect(&p, 56);
                Node n = node_new(75);
                n.s1 = op.value; n.s2 = table.value; n.s3 = path.value;
                n_pos(n, op);
                return n;
            }
        }
    }

    // `render X to "path";` is a statement; a bare `render X` is an
    // expression, so the two are told apart by what follows the name.
    int render_stmt = 0;
    if (k == 30) {
        Token after = p_peek(&p, 2);
        if (after.kind != 4) { render_stmt = 1; }
        if (str_eq(after.value, "to") == 1) { render_stmt = 1; }
    }
    if (render_stmt == 1) {                    // render X to "path";
        p_advance(&p);
        Token rep = p_expect(&p, 4);
        p_expect_word(&p, "to");
        Token path = p_advance(&p);
        p_expect(&p, 56);
        Node n = node_new(25);
        n.s1 = rep.value;
        n.s2 = path.value;
        n_pos(n, t);
        return n;
    }

    // Table <- [col = value, ...];
    if (k == 4) {
        if (p_kind(&p, 1) == 76) {
            Token tgt = p_advance(&p);
            p_advance(&p);
            p_expect(&p, 54);
            NodeVec pairs = nv_new();
            int more = 1;
            while (more == 1) {
                if (p_at_end(&p) == 1) { more = 0; }
                if (p_check(&p, 55) == 1) { more = 0; }
                if (more == 1) {
                    Token col = p_advance(&p);
                    p_expect(&p, 60);
                    Node v = parse_expr(&p);
                    Node pair = node_new(0);
                    pair.s1 = col.value;
                    pair.c1 = node_ptr(v);
                    nv_push(&pairs, pair);
                    // Whether a comma followed must be read before consuming it.
                    int had_comma = p_check(&p, 58);
                    if (had_comma == 1) { p_advance(&p); }
                    if (had_comma == 0) { more = 0; }
                }
            }
            p_expect(&p, 55);
            p_expect(&p, 56);
            Node n = node_new(27);
            n.s1 = tgt.value;
            n.v1 = nv_ptr(pairs);
            n_pos(n, tgt);
            return n;
        }
    }

    if (is_type_kind(k) == 1) {
        if (p_kind(&p, 1) == 4) {              // type name = ...
            return parse_var_decl(&p, 1);
        }
        if (k == 14) { return parse_var_decl(&p, 1); }
        if (k == 15) { return parse_var_decl(&p, 1); }
    }

    if (looks_like_assignment(&p) == 1) { return parse_assignment(&p, 1); }

    Node e = parse_expr(&p);
    p_expect(&p, 56);
    Node n = node_new(23);
    n.c1 = node_ptr(e);
    n_pos(n, t);
    return n;
}

// ── Expressions (matching the oracle's precedence chain) ─────────────────────

Node mk_binary(str op, Node l, Node r) {
    Node n = node_new(40);
    n.s1 = op;
    n.c1 = node_ptr(l);
    n.c2 = node_ptr(r);
    n.line = l.line; n.col = l.col;
    return n;
}

Node parse_expr(P &p) { return parse_or(&p); }

Node parse_or(P &p) {
    Node left = parse_and(&p);
    while (p_check(&p, 75) == 1) {
        Token op = p_advance(&p);
        Node right = parse_and(&p);
        left = mk_binary(op.value, left, right);
    }
    return left;
}

Node parse_and(P &p) {
    Node left = parse_equality(&p);
    while (p_check(&p, 74) == 1) {
        Token op = p_advance(&p);
        Node right = parse_equality(&p);
        left = mk_binary(op.value, left, right);
    }
    return left;
}

int is_comparison(int k) {
    if (k == 70) { return 1; }   // ==
    if (k == 71) { return 1; }   // !=
    if (k == 67) { return 1; }   // <
    if (k == 68) { return 1; }   // >
    if (k == 72) { return 1; }   // <=
    if (k == 73) { return 1; }   // >=
    return 0;
}

Node parse_equality(P &p) {
    Node left = parse_addition(&p);
    while (is_comparison(p_kind(&p, 0)) == 1) {
        Token op = p_advance(&p);
        Node right = parse_addition(&p);
        left = mk_binary(op.value, left, right);
    }
    return left;
}

Node parse_addition(P &p) {
    Node left = parse_multiplication(&p);
    while (p_check(&p, 62) + p_check(&p, 63) > 0) {
        Token op = p_advance(&p);
        Node right = parse_multiplication(&p);
        left = mk_binary(op.value, left, right);
    }
    return left;
}

Node parse_multiplication(P &p) {
    Node left = parse_unary(&p);
    while (p_check(&p, 64) + p_check(&p, 65) + p_check(&p, 66) > 0) {
        Token op = p_advance(&p);
        Node right = parse_unary(&p);
        left = mk_binary(op.value, left, right);
    }
    return left;
}

Node parse_unary(P &p) {
    if (p_check(&p, 69) == 1) {                // !
        Token t = p_advance(&p);
        Node operand = parse_unary(&p);
        Node n = node_new(41);
        n.s1 = "!"; n.c1 = node_ptr(operand); n_pos(n, t);
        return n;
    }
    if (p_check(&p, 63) == 1) {                // -
        Token t = p_advance(&p);
        Node operand = parse_unary(&p);
        Node n = node_new(41);
        n.s1 = "-"; n.c1 = node_ptr(operand); n_pos(n, t);
        return n;
    }
    if (p_check(&p, 61) == 1) {                // &
        Token t = p_advance(&p);
        Node target = parse_primary(&p);
        Node n = node_new(43);
        n.c1 = node_ptr(target); n_pos(n, t);
        return n;
    }
    return parse_cast(&p);
}

Node parse_cast(P &p) {
    Node e = parse_primary(&p);
    if (p_check(&p, 77) == 1) {                // ::
        p_advance(&p);
        Token target = p_advance(&p);
        Node n = node_new(44);
        n.c1 = node_ptr(e);
        n.s1 = target.value;
        n.line = e.line; n.col = e.col;
        return n;
    }
    return e;
}

Node parse_primary(P &p) {
    Token t = p_peek(&p, 0);
    int k = t.kind;

    if (k == 1) { p_advance(&p); Node n = node_new(50);
        n.i1 = str_to_int(t.value); n_pos(n, t); return n; }
    if (k == 2) { p_advance(&p); Node n = node_new(51);
        n.s1 = t.value; n_pos(n, t); return n; }
    if (k == 3) { p_advance(&p); Node n = node_new(52);
        n.s1 = t.value; n_pos(n, t); return n; }
    if (k == 39) { p_advance(&p); Node n = node_new(53);
        n.i1 = 1; n_pos(n, t); return n; }
    if (k == 40) { p_advance(&p); Node n = node_new(53);
        n.i1 = 0; n_pos(n, t); return n; }

    if (k == 30) {                             // render X  -> the document
        p_advance(&p);
        Token target = p_expect(&p, 4);
        Node n = node_new(55);
        n.s1 = target.value;
        n_pos(n, t);
        return n;
    }

    if (k == 28) {                             // predict Model(arg)
        p_advance(&p);
        Token model_name = p_expect(&p, 4);
        p_expect(&p, 52);
        Node arg = parse_expr(&p);
        p_expect(&p, 53);
        Node n = node_new(45);
        n.s1 = model_name.value; n.c1 = node_ptr(arg); n_pos(n, t);
        return n;
    }

    if (k == 54) {                             // [a, b, c]
        p_advance(&p);
        NodeVec elems = nv_new();
        while (p_check(&p, 55) == 0) {
            if (p_at_end(&p) == 1) { break; }
            nv_push(&elems, parse_expr(&p));
            if (p_check(&p, 58) == 1) { p_advance(&p); }
        }
        p_expect(&p, 55);
        Node n = node_new(47);
        n.v1 = nv_ptr(elems); n_pos(n, t);
        return n;
    }

    if (k == 52) {                             // ( expr )
        p_advance(&p);
        Node e = parse_expr(&p);
        p_expect(&p, 53);
        return e;
    }

    // Identifier, call, then a postfix chain of member access and indexing.
    Token name = p_advance(&p);
    Node expr = node_new(54);
    expr.s1 = name.value;
    n_pos(expr, name);

    // Query expression: `Source <- [cond]` anywhere a value is expected, not
    // only on the right of a declaration.
    if (name.kind == 4) {
        if (p_check(&p, 76) == 1) {
            p_advance(&p);                     // <-
            p_expect(&p, 54);                  // [
            Node qcond = parse_expr(&p);
            p_expect(&p, 55);                  // ]
            Node q = node_new(46);
            q.s1 = name.value;
            q.c1 = node_ptr(qcond);
            n_pos(q, name);
            return q;
        }
    }

    if (p_check(&p, 52) == 1) {                // call
        p_advance(&p);
        NodeVec args = nv_new();
        while (p_check(&p, 53) == 0) {
            if (p_at_end(&p) == 1) { break; }
            nv_push(&args, parse_expr(&p));
            if (p_check(&p, 58) == 1) { p_advance(&p); }
        }
        p_expect(&p, 53);
        Node call = node_new(42);
        call.s1 = name.value;
        call.v1 = nv_ptr(args);
        n_pos(call, name);
        expr = call;
    }

    while (p_check(&p, 59) + p_check(&p, 54) > 0) {
        // Inside a layout element's label a '[' opens a property list, not an
        // index, so the postfix chain must stop there.
        if (p_check(&p, 54) == 1) { if (p.no_index == 1) { return expr; } }
        if (p_check(&p, 59) == 1) {
            p_advance(&p);
            Token member = p_expect(&p, 4);
            Node m = node_new(48);
            m.c1 = node_ptr(expr);
            m.s1 = member.value;
            n_pos(m, name);
            expr = m;
        }
        if (p_check(&p, 54) == 1) {
            // Re-checked here, not only at the top of the loop: a member
            // access consumed earlier in this same iteration would otherwise
            // fall straight through into the index branch.
            if (p.no_index == 1) { return expr; }
            p_advance(&p);
            Node idx = parse_expr(&p);
            p_expect(&p, 55);
            Node ix = node_new(49);
            ix.c1 = node_ptr(expr);
            ix.c2 = node_ptr(idx);
            n_pos(ix, name);
            expr = ix;
        }
    }
    return expr;
}

// ── Compilation unit ─────────────────────────────────────────────────────────

Node parse_unit(P &p) {
    NodeVec imports = nv_new();
    NodeVec decls = nv_new();
    NodeVec funcs = nv_new();

    while (p_at_end(&p) == 0) {
        int k = p_kind(&p, 0);
        if (k == 21) { nv_push(&imports, parse_import(&p)); }
        if (k == 24) { nv_push(&decls, parse_record(&p, 24, 3)); }
        if (k == 26) { nv_push(&decls, parse_record(&p, 26, 4)); }
        if (k == 27) { nv_push(&decls, parse_model(&p)); }
        if (k == 29) { nv_push(&decls, parse_report(&p)); }
        if (k == 31) { nv_push(&decls, parse_layout(&p)); }
        if (k == 32) { nv_push(&decls, parse_verify_block(&p)); }
        int is_foreign = p_at_word(&p, "foreign");
        if (is_foreign == 1) { nv_push(&decls, parse_foreign(&p)); }
        if (k == 23) { nv_push(&funcs, parse_function(&p, 1)); }
        if (k == 25) { nv_push(&funcs, parse_function(&p, 2)); }
        if (is_foreign == 0) {
            if (is_type_kind(k) == 1) { nv_push(&funcs, parse_function(&p, 0)); }
        }
        if (is_foreign == 0) { if (is_type_kind(k) == 0) {
                if (k != 21) { if (k != 24) { if (k != 26) { if (k != 27) { if (k != 29) {
                                    if (k != 32) { if (k != 31) { if (k != 23) { if (k != 25) {
                                                    eprint("[STRATA PARSE ERROR] unexpected top-level token");
                                                    p_advance(&p);
                                                } } } }
                                } } } } }
            } }
    }

    Node unit = node_new(1);
    unit.v1 = nv_ptr(imports);
    unit.v2 = nv_ptr(decls);
    unit.v3 = nv_ptr(funcs);
    return unit;
}

Node parse_source(str source) {
    TokVec toks = tokenise(source);
    P p = p_new(toks);
    return parse_unit(&p);
}

// ── Layout blocks ────────────────────────────────────────────────────────────
//
// A layout body is a declarative element tree. Element tags are contextual
// rather than reserved: an identifier in statement position is an element
// unless it is being assigned, accessed, called or queried.

int not_an_element(int k) {
    if (k == 60) { return 1; }   // =
    if (k == 59) { return 1; }   // .
    if (k == 52) { return 1; }   // (
    if (k == 76) { return 1; }   // <-
    return 0;
}

Node parse_foreign(P &p) {
    Token t = p_advance(&p);                   // contextual `foreign`
    Token header = p_advance(&p);
    Node n = node_new(74);
    n.s1 = header.value;
    n.s2 = "";
    n_pos(n, t);
    if (p_at_word(&p, "link") == 1) {
        p_advance(&p);
        Token lib = p_advance(&p);
        n.s2 = lib.value;
    }
    p_expect(&p, 50);
    NodeVec fns = nv_new();
    while (p_check(&p, 51) == 0) {
        if (p_at_end(&p) == 1) { break; }
        Node rt = parse_type(&p);
        Token name = p_expect(&p, 4);
        p_expect(&p, 52);
        NodeVec params = parse_params(&p);
        p_expect(&p, 53);
        p_expect(&p, 56);
        Node f = node_new(9);
        f.s1 = "foreign";
        f.c1 = node_ptr(rt);
        f.s2 = name.value;
        f.v1 = nv_ptr(params);
        f.v2 = nv_ptr(nv_new());
        n_pos(f, name);
        nv_push(&fns, f);
    }
    p_expect(&p, 51);
    n.v1 = nv_ptr(fns);
    return n;
}

Node parse_verify_block(P &p) {
    Token t = p_expect(&p, 32);
    Token label = p_advance(&p);
    p_expect(&p, 50);
    NodeVec body = nv_new();
    while (p_check(&p, 51) == 0) {
        if (p_at_end(&p) == 1) { break; }
        nv_push(&body, parse_statement(&p));
    }
    p_expect(&p, 51);
    Node n = node_new(26);
    n.s1 = label.value;
    n.v1 = nv_ptr(body);
    n_pos(n, t);
    return n;
}

Node parse_layout(P &p) {
    Token t = p_expect(&p, 31);
    Token name = p_expect(&p, 4);
    p_expect(&p, 52); p_expect(&p, 53);
    p_expect(&p, 50);
    NodeVec body = parse_layout_body(&p);
    p_expect(&p, 51);
    Node n = node_new(70);
    n.s1 = name.value;
    n.v1 = nv_ptr(body);
    n_pos(n, t);
    return n;
}

NodeVec parse_layout_body(P &p) {
    NodeVec out = nv_new();
    while (p_check(&p, 51) == 0) {
        if (p_at_end(&p) == 1) { break; }
        nv_push(&out, parse_layout_stmt(&p));
    }
    return out;
}

Node parse_layout_stmt(P &p) {
    Token t = p_peek(&p, 0);
    if (t.kind == 4) {
        if (not_an_element(p_kind(&p, 1)) == 0) { return parse_element(&p); }
    }
    if (p_check(&p, 42) == 1) { return parse_for_in(&p); }
    if (p_check(&p, 17) == 1) { return parse_layout_if(&p); }
    if (is_type_kind(t.kind) == 1) { return parse_var_decl(&p, 1); }
    Node e = parse_expr(&p);
    p_expect(&p, 56);
    Node n = node_new(23);
    n.c1 = node_ptr(e);
    n_pos(n, t);
    return n;
}

Node parse_element(P &p) {
    Token t = p_advance(&p);
    Node n = node_new(71);
    n.s1 = t.value;
    n_pos(n, t);
    if (p_check(&p, 54) + p_check(&p, 50) + p_check(&p, 56) == 0) {
        // `[` after a label opens properties, not an index.
        p.no_index = 1;
        Node label = parse_expr(&p);
        p.no_index = 0;
        n.c1 = node_ptr(label);
    }
    NodeVec props = nv_new();
    if (p_check(&p, 54) == 1) { props = parse_props(&p); }
    n.v1 = nv_ptr(props);
    NodeVec children = nv_new();
    if (p_check(&p, 50) == 1) {
        p_advance(&p);
        children = parse_layout_body(&p);
        p_expect(&p, 51);
    }
    if (p_check(&p, 56) == 1) { p_advance(&p); }
    n.v2 = nv_ptr(children);
    return n;
}

NodeVec parse_props(P &p) {
    p_expect(&p, 54);
    NodeVec props = nv_new();
    int more = 1;
    while (more == 1) {
        if (p_at_end(&p) == 1) { more = 0; }
        if (p_check(&p, 55) == 1) { more = 0; }
        if (more == 1) {
            Token pt = p_advance(&p);
            p_expect(&p, 60);
            Node v = parse_expr(&p);
            Node prop = node_new(72);
            prop.s1 = pt.value;
            prop.c1 = node_ptr(v);
            n_pos(prop, pt);
            nv_push(&props, prop);
            int had_comma = p_check(&p, 58);
            if (had_comma == 1) { p_advance(&p); }
            if (had_comma == 0) { more = 0; }
        }
    }
    p_expect(&p, 55);
    return props;
}

Node parse_for_in(P &p) {
    Token t = p_expect(&p, 42);
    Token v = p_expect(&p, 4);
    Token kw = p_advance(&p);                  // contextual `in`
    Node coll = parse_expr(&p);
    p_expect(&p, 50);
    NodeVec body = parse_layout_body(&p);
    p_expect(&p, 51);
    Node n = node_new(73);
    n.s1 = v.value;
    n.c1 = node_ptr(coll);
    n.v1 = nv_ptr(body);
    n_pos(n, t);
    return n;
}

Node parse_layout_if(P &p) {
    Token t = p_expect(&p, 17);
    p_expect(&p, 52);
    Node cond = parse_expr(&p);
    p_expect(&p, 53);
    p_expect(&p, 50);
    NodeVec then_block = parse_layout_body(&p);
    p_expect(&p, 51);
    Node n = node_new(22);
    n.c1 = node_ptr(cond);
    n.v1 = nv_ptr(then_block);
    n_pos(n, t);
    if (p_check(&p, 18) == 1) {
        p_advance(&p);
        p_expect(&p, 50);
        NodeVec else_block = parse_layout_body(&p);
        p_expect(&p, 51);
        n.v2 = nv_ptr(else_block);
    }
    return n;
}

// ── Module resolution ────────────────────────────────────────────────────────
//
// Lives here rather than in the code generator because the type checker needs
// it too: without the resolved import graph it cannot tell a typo'd call from
// a call into std/, and the mistake reaches the user as a C linker error
// naming a C symbol.

// `app` is the project's own src/ directory, so an application can be more
// than one file without putting its modules in the standard library. It
// resolves beside the file being compiled rather than under the tree root.
// The directory part of a path: "apps/orders/src/main.sta" -> "apps/orders/src".
str dir_of(str path) {
    int last = -1;
    int n = str_len(path);
    for (int i = 0; i < n; i = i + 1) { if (path[i] == 47) { last = i; } }
    if (last < 0) { return "."; }
    return str_slice(path, 0, last);
}

str app_module_path(str src_dir, str name) {
    int last_dot = -1;
    int n = str_len(name);
    for (int i = 0; i < n; i = i + 1) { if (name[i] == 46) { last_dot = i; } }
    str leaf = name;
    if (last_dot >= 0) { leaf = str_slice(name, last_dot + 1, n); }
    StringBuilder sb = sb_new();
    sb_append(&sb, src_dir); sb_append(&sb, "/"); sb_append(&sb, leaf);
    sb_append(&sb, ".sta");
    return sb_to_str(&sb);
}

str module_path(str root, str source, str name) {
    // The leaf of a dotted path names the file: core.io -> std/io.sta
    int last_dot = -1;
    int n = str_len(name);
    for (int i = 0; i < n; i = i + 1) { if (name[i] == 46) { last_dot = i; } }
    str leaf = name;
    if (last_dot >= 0) { leaf = str_slice(name, last_dot + 1, n); }
    StringBuilder sb = sb_new();
    sb_append(&sb, root); sb_append(&sb, "/"); sb_append(&sb, source);
    sb_append(&sb, "/"); sb_append(&sb, leaf); sb_append(&sb, ".sta");
    return sb_to_str(&sb);
}

// Transitively parse every locally-resolvable import, deepest first, so a
// module's own dependencies come before it. `seen` is a ",path,path," string
// rather than a map so this stays free of the code generator's machinery.
def collect_modules(str root, Node unit, NodeVec &out, str &seen, int &unresolved) {
    collect_modules_from(root, "", unit, &out, &seen, &unresolved);
}

def collect_modules_from(str root, str src_dir, Node unit, NodeVec &out,
str &seen, int &unresolved) {
    NodeVec imps = nv_at(unit.v1);
    int n = imps.len;
    for (int i = 0; i < n; i = i + 1) {
        Node imp = nv_get(&imps, i);
        int local = 0;
        if (str_eq(imp.s2, "std") == 1) { local = 1; }
        if (str_eq(imp.s2, "compiler") == 1) { local = 1; }
        int is_app = 0;
        if (str_eq(imp.s2, "app") == 1) { if (str_len(src_dir) > 0) { is_app = 1; local = 1; } }
        if (local == 0) { unresolved = unresolved + 1; }
        if (local == 1) {
            str path = module_path(root, imp.s2, imp.s1);
            if (is_app == 1) { path = app_module_path(src_dir, imp.s1); }
            if (file_exists(path) == 0) { unresolved = unresolved + 1; }
            if (file_exists(path) == 1) {
                StringBuilder needle = sb_new();
                sb_append(&needle, ",");
                sb_append(&needle, path);
                sb_append(&needle, ",");
                if (str_index_of(seen, sb_to_str(&needle)) < 0) {
                    StringBuilder grown = sb_new();
                    if (str_len(seen) == 0) { sb_append(&grown, ","); }
                    sb_append(&grown, seen);
                    sb_append(&grown, path);
                    sb_append(&grown, ",");
                    seen = sb_to_str(&grown);
                    Node mod = parse_source(file_read(path));
                    // The unit carries the import name so the emitted module
                    // separator matches the oracle's.
                    mod.s1 = imp.s1;
                    collect_modules_from(root, src_dir, mod, &out, &seen, &unresolved);
                    nv_push(&out, mod);
                }
            }
        }
    }
}
