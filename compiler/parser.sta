int TK_KW_INPUT=40; int TK_KW_OUTPUT=41; int TK_KW_METRICS=42;
int TK_KW_TITLE=43; int TK_KW_DATASRC=44; int TK_KW_TO=45;
int TK_KW_PRINT=46; int TK_KW_TRUE=47; int TK_KW_FALSE=48;
int TK_L_BRACE=50; int TK_R_BRACE=51; int TK_L_PAREN=52; int TK_R_PAREN=53;
int TK_L_BRACKET=54; int TK_R_BRACKET=55; int TK_SEMICOLON=56;
int TK_COLON=57; int TK_COMMA=58; int TK_DOT=59; int TK_ASSIGN=60;
int TK_ARROW_L=61; int TK_CAST_OP=62; int TK_BORROW_OP=63;
int TK_PLUS=64; int TK_MINUS=65; int TK_STAR=66; int TK_SLASH=67;
int TK_EQ=69; int TK_NEQ=70; int TK_LT=71; int TK_GT=72;
int TK_LTE=73; int TK_GTE=74; int TK_AND=75; int TK_OR=76;
int TK_NOT=77; int TK_EOF=99;
int NULL_NODE=0;

database Token { int kind; str value; int line; int col; }
database TokenArray { int buf_ptr; int count; int capacity; }
database ASTNode {
    int kind; int ival; float fval;
    str sval; str sval2;
    int line; int col;
    int left; int right; int cond; int body; int next; int alt;
}
database NodePool { int buf_ptr; int count; int capacity; }
database ParserState { int ta_ptr; int pos; str filename; }

NodePool pool_new() {
    native "
    static NodePool _p;
    _p.capacity=131072; _p.count=1;
    _p.buf_ptr=(int64_t)(uintptr_t)calloc(131072,sizeof(ASTNode));
    return _p;
    ";
}

int node_new(NodePool &pool, int kind, int line, int col) {
    native "
    int64_t _idx=$pool.count++;
    if(_idx>=$pool.capacity){fprintf(stderr,\"[STRATA] AST pool overflow\n\");exit(1);}
    ASTNode* _n=&((ASTNode*)(uintptr_t)$pool.buf_ptr)[_idx];
    memset(_n,0,sizeof(ASTNode));
    _n->kind=$kind;_n->line=$line;_n->col=$col;
    return _idx;
    ";
}

ASTNode pool_get_node(NodePool &pool, int idx) {
    native "return ((ASTNode*)(uintptr_t)$pool.buf_ptr)[$idx];";
}

def pool_set_field_i(NodePool &pool, int idx, str field, int val) {
    native "
    ASTNode* _n=&((ASTNode*)(uintptr_t)$pool.buf_ptr)[$idx];
    if(strcmp($field,\"left\")==0)  _n->left=$val;
    else if(strcmp($field,\"right\")==0) _n->right=$val;
    else if(strcmp($field,\"cond\")==0)  _n->cond=$val;
    else if(strcmp($field,\"body\")==0)  _n->body=$val;
    else if(strcmp($field,\"next\")==0)  _n->next=$val;
    else if(strcmp($field,\"alt\")==0)   _n->alt=$val;
    else if(strcmp($field,\"ival\")==0)  _n->ival=$val;
    ";
}

def pool_set_field_s(NodePool &pool, int idx, str field, str val) {
    native "
    ASTNode* _n=&((ASTNode*)(uintptr_t)$pool.buf_ptr)[$idx];
    if(strcmp($field,\"sval\")==0)  _n->sval=$val;
    else if(strcmp($field,\"sval2\")==0) _n->sval2=$val;
    ";
}

def pool_set_field_f(NodePool &pool, int idx, str field, float val) {
    native "((ASTNode*)(uintptr_t)$pool.buf_ptr)[$idx].fval=$val;";
}

Token ta_get_tok(TokenArray &ta, int idx) {
    native "return ((Token*)(uintptr_t)$ta.buf_ptr)[$idx];";
}

ParserState ps_new(TokenArray &ta, str filename) {
    native "
    static ParserState _ps;
    _ps.ta_ptr=(int64_t)(uintptr_t)&$ta;
    _ps.pos=0; _ps.filename=$filename;
    return _ps;
    ";
}

int ps_kind(ParserState &ps) {
    native "
    TokenArray* _ta=(TokenArray*)(uintptr_t)$ps.ta_ptr;
    return ((Token*)(uintptr_t)_ta->buf_ptr)[$ps.pos].kind;
    ";
}

int ps_kind_at(ParserState &ps, int offset) {
    native "
    TokenArray* _ta=(TokenArray*)(uintptr_t)$ps.ta_ptr;
    int64_t _i=$ps.pos+$offset;
    if(_i>=_ta->count)_i=_ta->count-1;
    return ((Token*)(uintptr_t)_ta->buf_ptr)[_i].kind;
    ";
}

Token ps_peek(ParserState &ps) {
    native "
    TokenArray* _ta=(TokenArray*)(uintptr_t)$ps.ta_ptr;
    return ((Token*)(uintptr_t)_ta->buf_ptr)[$ps.pos];
    ";
}

Token ps_advance(ParserState &ps) {
    native "
    TokenArray* _ta=(TokenArray*)(uintptr_t)$ps.ta_ptr;
    Token _t=((Token*)(uintptr_t)_ta->buf_ptr)[$ps.pos];
    if($ps.pos<_ta->count-1)$ps.pos++;
    return _t;
    ";
}

Token ps_consume(ParserState &ps, int kind) {
    native "
    TokenArray* _ta=(TokenArray*)(uintptr_t)$ps.ta_ptr;
    Token _t=((Token*)(uintptr_t)_ta->buf_ptr)[$ps.pos];
    if(_t.kind!=$kind){
        fprintf(stderr,\"[STRATA PARSE ERROR] Expected %lld got '%s'(%lld) at %s:%lld:%lld\n\",
            (long long)$kind,_t.value,(long long)_t.kind,
            $ps.filename,(long long)_t.line,(long long)_t.col);
        exit(1);
    }
    if($ps.pos<_ta->count-1)$ps.pos++;
    return _t;
    ";
}

int ps_at_end(ParserState &ps) {
    native "
    TokenArray* _ta=(TokenArray*)(uintptr_t)$ps.ta_ptr;
    return ((Token*)(uintptr_t)_ta->buf_ptr)[$ps.pos].kind==99?1:0;
    ";
}

int ps_is_prim_type(ParserState &ps) {
    native "
    int64_t _k=ps_kind(&$ps);
    return(_k==10||_k==11||_k==12||_k==13||_k==16)?1:0;
    ";
}

int ps_is_type_tok(ParserState &ps) {
    native "
    int64_t _k0=ps_kind(&$ps);
    int64_t _k1=ps_kind_at(&$ps,1);
    if(_k0==10||_k0==11||_k0==12||_k0==13||_k0==14||_k0==15||_k0==16)return 1;
    if(_k0==4&&(_k1==4||_k1==63))return 1;
    return 0;
    ";
}

int parse_tensor_type(ParserState &ps, NodePool &pool) {
    Token t=ps_consume(&ps,15);
    int idx=node_new(&pool,AST_TYPE_TENSOR,t.line,t.col);
    ps_consume(&ps,54);
    Token dt=ps_advance(&ps);
    ps_consume(&ps,58);
    Token rows=ps_consume(&ps,1);
    ps_consume(&ps,58);
    Token cols=ps_consume(&ps,1);
    ps_consume(&ps,55);
    native "
    ASTNode* _n=&((ASTNode*)(uintptr_t)$pool.buf_ptr)[$idx];
    _n->sval=$dt.value;
    _n->ival=(int64_t)atoll($rows.value);
    _n->right=(int64_t)atoll($cols.value);
    ";
    return idx;
}

int parse_type(ParserState &ps, NodePool &pool) {
    if(ps_kind(&ps)==15){return parse_tensor_type(&ps,&pool);}
    if(ps_kind(&ps)==14){
        Token t=ps_advance(&ps);
        int idx=node_new(&pool,AST_TYPE_LIST,t.line,t.col);
        ps_consume(&ps,54);
        int elem=parse_type(&ps,&pool);
        ps_consume(&ps,55);
        native "((ASTNode*)(uintptr_t)$pool.buf_ptr)[$idx].left=$elem;";
        return idx;
    }
    Token t=ps_advance(&ps);
    int idx=node_new(&pool,AST_TYPE_PRIM,t.line,t.col);
    native "((ASTNode*)(uintptr_t)$pool.buf_ptr)[$idx].sval=$t.value;";
    return idx;
}

int parse_expr(ParserState &ps, NodePool &pool);

int parse_primary(ParserState &ps, NodePool &pool) {
    Token t=ps_peek(&ps);
    if(ps_kind(&ps)==1){
        ps_advance(&ps);
        int idx=node_new(&pool,AST_INT_LIT,t.line,t.col);
