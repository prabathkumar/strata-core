        if(ps_kind(&ps)==4&&ps_kind_at(&ps,1)==61){
            Token src=ps_advance(&ps);ps_consume(&ps,61);
            ps_consume(&ps,54);int cond=parse_expr(&ps,&pool);ps_consume(&ps,55);ps_consume(&ps,56);
            int qi=node_new(&pool,AST_QUERY,t.line,t.col);
            native "ASTNode* _qn=&((ASTNode*)(uintptr_t)$pool.buf_ptr)[$qi];_qn->sval=$src.value;_qn->cond=$cond;ASTNode* _vn=&((ASTNode*)(uintptr_t)$pool.buf_ptr)[$idx];_vn->sval=$nm.value;_vn->left=$tn;_vn->right=$qi;";
            return idx;
        }
        int v=parse_expr(&ps,&pool);ps_consume(&ps,56);
        native "ASTNode* _n=&((ASTNode*)(uintptr_t)$pool.buf_ptr)[$idx];_n->sval=$nm.value;_n->left=$tn;_n->right=$v;";
        return idx;
    }
    int ex=parse_expr(&ps,&pool);ps_consume(&ps,56);
    int idx=node_new(&pool,AST_EXPR_STMT,t.line,t.col);
    native "((ASTNode*)(uintptr_t)$pool.buf_ptr)[$idx].left=$ex;";
    return idx;
}

int parse_params(ParserState &ps, NodePool &pool) {
    int head=0;int tail=0;
    native "
    while(ps_kind(&$ps)!=53){
        Token _t=ps_peek(&$ps);
        int64_t _pt=parse_type(&$ps,&$pool);
        int64_t _borrow=0;
        if(ps_kind(&$ps)==63){ps_advance(&$ps);_borrow=1;}
        Token _nt=ps_consume(&$ps,4);
        int64_t _pi=node_new(&$pool,37,_nt.line,_nt.col);
        ASTNode* _pn=&((ASTNode*)(uintptr_t)$pool.buf_ptr)[_pi];
        _pn->left=_pt;_pn->sval=_nt.value;_pn->ival=_borrow;
        if($head==0){$head=_pi;$tail=_pi;}
        else{((ASTNode*)(uintptr_t)$pool.buf_ptr)[$tail].next=_pi;$tail=_pi;}
        if(ps_kind(&$ps)==58)ps_advance(&$ps);
    }
    ";
    return head;
}

int parse_function(ParserState &ps, NodePool &pool, int kind_val) {
    Token t=ps_peek(&ps);
    int rt=0;
    if(kind_val==0){rt=parse_type(&ps,&pool);}else{ps_advance(&ps);}
    Token nm=ps_consume(&ps,4);
    ps_consume(&ps,52);int params=parse_params(&ps,&pool);ps_consume(&ps,53);
    ps_consume(&ps,50);int body=parse_body(&ps,&pool);ps_consume(&ps,51);
    int idx=node_new(&pool,AST_FUNCTION,t.line,t.col);
    native "ASTNode* _n=&((ASTNode*)(uintptr_t)$pool.buf_ptr)[$idx];_n->sval=$nm.value;_n->ival=$kind_val;_n->left=$rt;_n->cond=$params;_n->body=$body;";
    return idx;
}

int parse(ParserState &ps, NodePool &pool) {
    int ih=0;int it=0;int dh=0;int dt=0;int fh=0;int ft=0;
    native "
    while(!ps_at_end(&$ps)){
        int64_t _k=ps_kind(&$ps);
        int64_t _node=0;int64_t _dest=0;
        if(_k==24){
            Token _t=ps_advance(&$ps);
            Token _nm=ps_consume(&$ps,4);
            ps_consume(&$ps,25);Token _src=ps_consume(&$ps,4);ps_consume(&$ps,56);
            _node=node_new(&$pool,30,_t.line,_t.col);
            ASTNode* _n=&((ASTNode*)(uintptr_t)$pool.buf_ptr)[_node];
            _n->sval=_nm.value;_n->sval2=_src.value;_dest=1;
        } else if(_k==30){
            Token _t=ps_advance(&$ps);Token _nm=ps_consume(&$ps,4);ps_consume(&$ps,50);
            int64_t _fh=0,_ft=0;
            while(ps_kind(&$ps)!=51){
                int64_t _ft2=parse_type(&$ps,&$pool);Token _fn=ps_consume(&$ps,4);ps_consume(&$ps,56);
                int64_t _fi=node_new(&$pool,31,_fn.line,_fn.col);
                ASTNode* _f=&((ASTNode*)(uintptr_t)$pool.buf_ptr)[_fi];
                _f->left=_ft2;_f->sval=_fn.value;
                if(_fh==0){_fh=_fi;_ft=_fi;}
                else{((ASTNode*)(uintptr_t)$pool.buf_ptr)[_ft].next=_fi;_ft=_fi;}
            }
            ps_consume(&$ps,51);
            _node=node_new(&$pool,32,_t.line,_t.col);
            ASTNode* _n=&((ASTNode*)(uintptr_t)$pool.buf_ptr)[_node];
            _n->sval=_nm.value;_n->body=_fh;_dest=2;
        } else if(_k==32){
            Token _t=ps_advance(&$ps);Token _nm=ps_consume(&$ps,4);ps_consume(&$ps,50);
            int64_t _fh=0,_ft=0;
            while(ps_kind(&$ps)!=51){
                int64_t _ft2=parse_type(&$ps,&$pool);Token _fn=ps_consume(&$ps,4);ps_consume(&$ps,56);
                int64_t _fi=node_new(&$pool,31,_fn.line,_fn.col);
                ((ASTNode*)(uintptr_t)$pool.buf_ptr)[_fi].left=_ft2;
                ((ASTNode*)(uintptr_t)$pool.buf_ptr)[_fi].sval=_fn.value;
                if(_fh==0){_fh=_fi;_ft=_fi;}
                else{((ASTNode*)(uintptr_t)$pool.buf_ptr)[_ft].next=_fi;_ft=_fi;}
            }
            ps_consume(&$ps,51);
            _node=node_new(&$pool,33,_t.line,_t.col);
            ((ASTNode*)(uintptr_t)$pool.buf_ptr)[_node].sval=_nm.value;
            ((ASTNode*)(uintptr_t)$pool.buf_ptr)[_node].body=_fh;_dest=2;
        } else if(_k==33){
            Token _t=ps_consume(&$ps,33);Token _nm=ps_consume(&$ps,4);ps_consume(&$ps,50);
            ps_consume(&$ps,40);ps_consume(&$ps,57);
            int64_t _it=parse_tensor_type(&$ps,&$pool);ps_consume(&$ps,56);
            ps_consume(&$ps,41);ps_consume(&$ps,57);
            int64_t _ot=parse_tensor_type(&$ps,&$pool);ps_consume(&$ps,56);
            ps_consume(&$ps,51);
            _node=node_new(&$pool,34,_t.line,_t.col);
            ASTNode* _n=&((ASTNode*)(uintptr_t)$pool.buf_ptr)[_node];
            _n->sval=_nm.value;_n->left=_it;_n->right=_ot;_dest=2;
        } else if(_k==26){_node=parse_function(&$ps,&$pool,1);_dest=3;
        } else if(_k==31){_node=parse_function(&$ps,&$pool,2);_dest=3;
        } else if(ps_is_type_tok(&$ps)){_node=parse_function(&$ps,&$pool,0);_dest=3;
        } else {
            Token _et=ps_peek(&$ps);
            fprintf(stderr,\"[STRATA PARSE ERROR] Unexpected '%s' at %s:%lld:%lld\n\",
                _et.value,$ps.filename,(long long)_et.line,(long long)_et.col);
            exit(1);
        }
        if(_dest==1){if($ih==0){$ih=_node;$it=_node;}else{((ASTNode*)(uintptr_t)$pool.buf_ptr)[$it].next=_node;$it=_node;}}
        else if(_dest==2){if($dh==0){$dh=_node;$dt=_node;}else{((ASTNode*)(uintptr_t)$pool.buf_ptr)[$dt].next=_node;$dt=_node;}}
        else{if($fh==0){$fh=_node;$ft=_node;}else{((ASTNode*)(uintptr_t)$pool.buf_ptr)[$ft].next=_node;$ft=_node;}}
    }
    ";
    int root=node_new(&pool,AST_COMPILE_UNIT,0,0);
    native "ASTNode* _r=&((ASTNode*)(uintptr_t)$pool.buf_ptr)[$root];_r->left=$ih;_r->cond=$dh;_r->body=$fh;";
    return root;
}

