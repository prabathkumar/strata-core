        ps_advance(&ps);
        int idx=node_new(&pool,AST_STR_LIT,t.line,t.col);
        native "((ASTNode*)(uintptr_t)$pool.buf_ptr)[$idx].sval=$t.value;";
        return idx;
    }
    if(ps_kind(&ps)==47){ps_advance(&ps);int idx=node_new(&pool,AST_BOOL_LIT,t.line,t.col);native "((ASTNode*)(uintptr_t)$pool.buf_ptr)[$idx].ival=1;";return idx;}
    if(ps_kind(&ps)==48){ps_advance(&ps);int idx=node_new(&pool,AST_BOOL_LIT,t.line,t.col);native "((ASTNode*)(uintptr_t)$pool.buf_ptr)[$idx].ival=0;";return idx;}
    if(ps_kind(&ps)==54){
        Token tb=ps_consume(&ps,54);
        int idx=node_new(&pool,AST_LIST_LIT,tb.line,tb.col);
        int head=0;int tail=0;
        native "
        while(ps_kind(&$ps)!=55){
            int64_t _e=parse_expr(&$ps,&$pool);
            if($head==0){$head=_e;$tail=_e;}
            else{((ASTNode*)(uintptr_t)$pool.buf_ptr)[$tail].next=_e;$tail=_e;}
            if(ps_kind(&$ps)==58)ps_advance(&$ps);
        }
        ";
