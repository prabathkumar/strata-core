import io  from std;
import mem from std;
import str from std;

// AST Node Type IDs
int AST_INT_LIT=1; int AST_FLOAT_LIT=2; int AST_STR_LIT=3; int AST_BOOL_LIT=4;
int AST_IDENT=5; int AST_BINARY=6; int AST_UNARY=7; int AST_CALL=8;
int AST_BORROW=9; int AST_CAST=10; int AST_PREDICT=11; int AST_QUERY=12;
int AST_LIST_LIT=13; int AST_MEMBER=14; int AST_VAR_DECL=15; int AST_RETURN=16;
int AST_IF=17; int AST_PRINT=18; int AST_ASSERT=19; int AST_EXPR_STMT=20;
int AST_VERIFY=21; int AST_RENDER=22; int AST_IMPORT=30; int AST_FIELD=31;
int AST_DATABASE=32; int AST_PROTOCOL=33; int AST_MODEL=34; int AST_REPORT=35;
int AST_FUNCTION=36; int AST_PARAM=37; int AST_COMPILE_UNIT=38;
int AST_TYPE_PRIM=50; int AST_TYPE_LIST=51; int AST_TYPE_TENSOR=52;

// Token IDs
int TK_INT_LIT=1; int TK_FLOAT_LIT=2; int TK_STR_LIT=3; int TK_IDENT=4;
