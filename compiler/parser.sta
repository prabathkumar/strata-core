        Token rt=ps_consume(&ps,4);ps_consume(&ps,45);Token pt=ps_consume(&ps,3);ps_consume(&ps,56);
        native "ASTNode* _n=&((ASTNode*)(uintptr_t)$pool.buf_ptr)[$idx];_n->sval=$rt.value;_n->sval2=$pt.value;";
        return idx;
