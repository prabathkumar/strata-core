int parse_stmt(ParserState &ps, NodePool &pool);

int parse_body(ParserState &ps, NodePool &pool) {
    int head=0;int tail=0;
    native "
    while(ps_kind(&$ps)!=51&&ps_kind(&$ps)!=99){
        int64_t _s=parse_stmt(&$ps,&$pool);
        if($head==0){$head=_s;$tail=_s;}
        else{((ASTNode*)(uintptr_t)$pool.buf_ptr)[$tail].next=_s;$tail=_s;}
    }
    ";
    return head;
}

int parse_stmt(ParserState &ps, NodePool &pool) {
