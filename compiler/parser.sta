        Token mt=ps_consume(&ps,4);
        ps_consume(&ps,52);
        int arg=parse_expr(&ps,&pool);
        ps_consume(&ps,53);
        native "ASTNode* _n=&((ASTNode*)(uintptr_t)$pool.buf_ptr)[$idx];_n->sval=$mt.value;_n->left=$arg;";
        return idx;
    }
    if(ps_is_prim_type(&ps)==1){
        Token tn=ps_advance(&ps);
        ps_consume(&ps,52);
        int arg=parse_expr(&ps,&pool);
        ps_consume(&ps,53);
        int idx=node_new(&pool,AST_CALL,t.line,t.col);
        native "ASTNode* _n=&((ASTNode*)(uintptr_t)$pool.buf_ptr)[$idx];_n->sval=$tn.value;_n->body=$arg;";
        return idx;
    }
    if(ps_kind(&ps)==4){
        Token nt=ps_advance(&ps);
        if(ps_kind(&ps)==52){
            ps_consume(&ps,52);
            int head=0;int tail=0;
            native "
            while(ps_kind(&$ps)!=53){
                int64_t _a=parse_expr(&$ps,&$pool);
                if($head==0){$head=_a;$tail=_a;}
                else{((ASTNode*)(uintptr_t)$pool.buf_ptr)[$tail].next=_a;$tail=_a;}
                if(ps_kind(&$ps)==58)ps_advance(&$ps);
            }
            ";
            ps_consume(&ps,53);
            int idx=node_new(&pool,AST_CALL,t.line,t.col);
            native "ASTNode* _n=&((ASTNode*)(uintptr_t)$pool.buf_ptr)[$idx];_n->sval=$nt.value;_n->body=$head;";
            native "
            while(ps_kind(&$ps)==59){
                ps_advance(&$ps);
                Token _mt=ps_consume(&$ps,4);
                int64_t _mi=node_new(&$pool,14,_mt.line,_mt.col);
                ASTNode* _mn=&((ASTNode*)(uintptr_t)$pool.buf_ptr)[_mi];
                _mn->left=$idx;_mn->sval=_mt.value;$idx=_mi;
            }
            ";
            return idx;
        }
        int idx=node_new(&pool,AST_IDENT,t.line,t.col);
        native "((ASTNode*)(uintptr_t)$pool.buf_ptr)[$idx].sval=$nt.value;";
        native "
        while(ps_kind(&$ps)==59){
            ps_advance(&$ps);
