            else{((ASTNode*)(uintptr_t)$pool.buf_ptr)[$tail].next=_a;$tail=_a;}
        }
        ";
        ps_consume(&ps,51);
        native "ASTNode* _n=&((ASTNode*)(uintptr_t)$pool.buf_ptr)[$idx];_n->sval=$lb.value;_n->body=$head;";
        return idx;
