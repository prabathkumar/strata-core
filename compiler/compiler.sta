// STRATA COMPILER — compiler/compiler.sta
// Orchestrator written IN Strata — replaces bootstrap/stage0.py
// Self-hosting target: bin/strata compiler/compiler.sta -o bin/strata

import io  from std;
import mem from std;
import str from std;

database Token { int kind; str value; int line; int col; }
database TokenArray { int buf_ptr; int count; int capacity; }
database ASTNode {
    int kind; int ival; float fval;
    str sval; str sval2;
    int line; int col;
    int left; int right; int cond; int body; int next; int alt;
}
database NodePool { int buf_ptr; int count; int capacity; }
database ParserState { int ta_ptr; int pos; str filename; }
database StringBuilder { int buf_ptr; int length; int capacity; }

TokenArray tokenise(str source, str filename);
NodePool   pool_new();
ParserState ps_new(TokenArray &ta, str filename);
int        parse(ParserState &ps, NodePool &pool);
str        codegen(int pool_ptr, int root_idx);

int compile_file(str src_path, str out_path, str target, int verbose) {
    str source = file_read(src_path);
    if (str_len(source) == 0) {
        print(str_concat("[STRATA ERROR] Cannot read: ", src_path));
        return 1;
    }
    if (verbose == 1) { print(str_concat("[Strata] Compiling: ", src_path)); }
    TokenArray ta   = tokenise(source, src_path);
    NodePool pool   = pool_new();
    ParserState ps  = ps_new(&ta, src_path);
    int root        = parse(&ps, &pool);
    str c_source    = codegen(&pool.buf_ptr, root);
    str c_path      = "";
    native "
    char* _cp=(char*)malloc(strlen($src_path)+3);
    strcpy(_cp,$src_path);
    char* _dot=strrchr(_cp,'.');
    if(_dot)strcpy(_dot,\".c\"); else strcat(_cp,\".c\");
    $c_path=_cp;
    ";
    int ok = file_write(c_path, c_source);
    if (ok == 0) { print(str_concat("[STRATA ERROR] Cannot write: ", c_path)); return 1; }
    if (verbose == 1) { print(str_concat("  C: ", c_path)); }
    native "
    char* _cc=NULL;
    char* _cands[]={\"clang\",\"gcc\",\"cc\",NULL};
    for(int _ci=0;_cands[_ci];_ci++){
        char _t[64];sprintf(_t,\"which %s>/dev/null 2>&1\",_cands[_ci]);
        if(system(_t)==0){_cc=_cands[_ci];break;}
    }
    if(!_cc){fprintf(stderr,\"[STRATA] No C compiler found.\n\");return 1;}
    char* _cmd=(char*)malloc(strlen(_cc)+strlen($c_path)+strlen($out_path)+64);
    if(strcmp($target,\"wasm\")==0)
        sprintf(_cmd,\"%s -O2 --target=wasm32 --no-standard-libraries -Wl,--export-all -Wl,--no-entry -o %s %s\"
                ,_cc,$out_path,$c_path);
    else
        sprintf(_cmd,\"%s -O2 -o %s %s -lm\",_cc,$out_path,$c_path);
    if($verbose)printf(\"  CC: %s\n\",_cmd);
    int _r=system(_cmd);
    if(_r!=0){fprintf(stderr,\"[STRATA] C compile failed\n\");return 1;}
    ";
    if (verbose == 1) { print(str_concat("  Binary: ", out_path)); }
    print("[Strata] Done. OK");
    return 0;
}

int check_file(str src_path) {
    str source = file_read(src_path);
    TokenArray ta = tokenise(source, src_path);
    NodePool pool = pool_new();
    ParserState ps = ps_new(&ta, src_path);
    int root = parse(&ps, &pool);
    native "
    ASTNode* _r=&((ASTNode*)(uintptr_t)$pool.buf_ptr)[$root];
    int64_t _ni=0,_nd=0,_nf=0;
    int64_t _i=_r->left;while(_i){_ni++;_i=((ASTNode*)(uintptr_t)$pool.buf_ptr)[_i].next;}
    _i=_r->cond;while(_i){_nd++;_i=((ASTNode*)(uintptr_t)$pool.buf_ptr)[_i].next;}
    _i=_r->body;while(_i){_nf++;_i=((ASTNode*)(uintptr_t)$pool.buf_ptr)[_i].next;}
    printf(\"[Strata Check] OK - %lld imports, %lld decls, %lld functions\n\",
        (long long)_ni,(long long)_nd,(long long)_nf);
    ";
    return 0;
}

def print_usage() {
    print("Strata Compiler v1.0.0 - Self-Hosted");
    print("  strata build <file.sta> [-o out] [--target native|wasm] [-v]");
    print("  strata check <file.sta>");
    print("  strata version");
}

int main() {
    native "
    extern int __strata_argc; extern char** __strata_argv;
    if(__strata_argc<2){print_usage();return 0;}
    strata_str _cmd=__strata_argv[1];
    if(strcmp(_cmd,\"version\")==0){puts(\"Strata v1.0.0 | Self-Hosted\");return 0;}
    if(strcmp(_cmd,\"check\")==0){
        if(__strata_argc<3){fprintf(stderr,\"Usage: strata check <file.sta>\n\");return 1;}
        return(int)check_file(__strata_argv[2]);
    }
    if(strcmp(_cmd,\"build\")==0){
        if(__strata_argc<3){fprintf(stderr,\"Usage: strata build <file.sta>\n\");return 1;}
        strata_str _src=__strata_argv[2];
        char* _out=(char*)malloc(strlen(_src)+1);strcpy(_out,_src);
        char* _dot=strrchr(_out,'.');if(_dot)*_dot='\\0';
        strata_str _target=\"native\"; int64_t _v=0;
        for(int _i=3;_i<__strata_argc;_i++){
            if(strcmp(__strata_argv[_i],\"-o\")==0&&_i+1<__strata_argc)_out=__strata_argv[++_i];
            else if(strcmp(__strata_argv[_i],\"--target\")==0&&_i+1<__strata_argc)_target=__strata_argv[++_i];
            else if(strcmp(__strata_argv[_i],\"-v\")==0)_v=1;
        }
        return(int)compile_file(_src,_out,_target,_v);
    }
    if(strstr(_cmd,\".sta\")){
        char* _out=(char*)malloc(strlen(_cmd)+1);strcpy(_out,_cmd);
        char* _dot=strrchr(_out,'.');if(_dot)*_dot='\\0';
        return(int)compile_file(_cmd,_out,\"native\",1);
    }
    fprintf(stderr,\"Unknown command: %s\n\",_cmd);
    print_usage(); return 1;
    ";
}
