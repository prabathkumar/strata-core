// STRATA COMPILER — compiler/codegen.sta
// The Strata code generator, written in Strata.
//
// Stage 4 of the self-hosting pipeline. Must emit C byte-identical to the
// generator in bootstrap/stage0.py; test_suite/codegen_diff.py enforces that.
// This is the strictest of the four comparisons — a token stream or a syntax
// tree has some freedom of representation, emitted code has none.
//
// Uses only the frozen seed subset (see SEED_SUBSET.md).

import io          from std;
import str         from std;
import lexer       from compiler;
import parser      from compiler;

// ── Generator state ──────────────────────────────────────────────────────────

database Bind { str name; str value; int next; }

int bind_cons(str name, str value, int next) {
    native "
    Bind* _b=(Bind*)malloc(sizeof(Bind));
    _b->name=$name; _b->value=$value; _b->next=$next;
    return (int64_t)(uintptr_t)_b;
    ";
}
Bind bind_at(int p) { native "return (Bind*)(uintptr_t)$p;"; }

str bind_get(int head, str name) {
    int cur = head;
    while (cur != 0) {
        Bind b = bind_at(cur);
        if (str_eq(b.name, name) == 1) { return b.value; }
        cur = b.next;
    }
    return "";
}

int bind_has(int head, str name) {
    int cur = head;
    while (cur != 0) {
        Bind b = bind_at(cur);
        if (str_eq(b.name, name) == 1) { return 1; }
        cur = b.next;
    }
    return 0;
}

database Gen {
    int out;          // StringBuilder*
    int test_mode;    // entry point runs verify blocks instead of main()
    int verifies;     // NodeVec* of verify blocks, for the runner
    str target;       // "native" or "wasm"
    str query_row;    // table whose condition is being generated, else ""
    int query_depth;  // nesting of query expressions, for unique C names
    int schema_decls; // Bind list: table -> its declaration node, for field types
    int indent;
    int borrowed;     // Bind list: borrowed scalar params needing deref
    int var_types;    // Bind list: variable -> C type
    int func_returns; // Bind list: function -> C return type
    int records;      // Bind list: record type name -> "1"
    int schemas;      // Bind list: table -> ",col,col,"
    int field_types;  // Bind list: "Table.col" -> C type
    int models;       // Bind list: model name -> "1"
    // Bind list: constant -> C type. File-scope, so it survives the reset at
    // the start of every function and layout.
    int const_types;
    // Whether code is being generated for a layout body, where a statement
    // may be an element, or for a function body, where it may not.
    // `for X in xs` is the one construct that appears in both.
    int in_layout;
}

Gen gen_new() {
    native "Gen* _g=(Gen*)calloc(1,sizeof(Gen)); _g->query_row=\"\"; _g->target=\"native\"; return _g;";
}

def emit_raw(Gen &g, str line) {
    StringBuilder sb = sb_at(g.out);
    sb_append_line(&sb, line);
}

StringBuilder sb_at(int p) { native "return (StringBuilder*)(uintptr_t)$p;"; }
int sb_ptr(StringBuilder s) { native "return (int64_t)(uintptr_t)$s;"; }

str indent_str(int n) {
    StringBuilder sb = sb_new();
    for (int i = 0; i < n; i = i + 1) { sb_append(&sb, "    "); }
    return sb_to_str(&sb);
}

def cg_emit(Gen &g, str line) {
    StringBuilder sb = sb_at(g.out);
    StringBuilder l = sb_new();
    sb_append(&l, indent_str(g.indent));
    sb_append(&l, line);
    sb_append_line(&sb, sb_to_str(&l));
}

// ── C types ──────────────────────────────────────────────────────────────────

str c_type(Gen &g, int tnode) {
    if (tnode == 0) { return "void"; }
    Node t = node_at(tnode);
    if (t.kind == 11) {
        if (str_eq(t.s1, "int"))   { return "strata_int"; }
        if (str_eq(t.s1, "float")) { return "strata_float"; }
        if (str_eq(t.s1, "str"))   { return "strata_str"; }
        if (str_eq(t.s1, "void"))  { return "void"; }
        if (str_eq(t.s1, "bool"))  { return "strata_bool"; }
        if (bind_has(g.records, t.s1) == 1) {
            StringBuilder sb = sb_new();
            sb_append(&sb, t.s1);
            sb_append(&sb, "*");
            return sb_to_str(&sb);
        }
        return t.s1;
    }
    if (t.kind == 12) {
        StringBuilder sb = sb_new();
        sb_append(&sb, c_type(&g, t.c1));
        sb_append(&sb, "*");
        return sb_to_str(&sb);
    }
    if (t.kind == 13) { return "double*"; }
    return "void*";
}

int ends_with_star(str s) {
    int n = str_len(s);
    if (n == 0) { return 0; }
    if (s[n - 1] == 42) { return 1; }
    return 0;
}

str c_param(Gen &g, Node p) {
    str ct = c_type(&g, p.c1);
    StringBuilder sb = sb_new();
    sb_append(&sb, ct);
    if (p.i1 == 1) { if (ends_with_star(ct) == 0) { sb_append(&sb, "*"); } }
    sb_append(&sb, " ");
    sb_append(&sb, cname(p.s1));
    return sb_to_str(&sb);
}

// Identifiers legal in Strata but reserved in C are mangled on the way out.
int is_c_reserved(str w) {
    if (str_eq(w, "auto")) { return 1; }      if (str_eq(w, "break")) { return 1; }
    if (str_eq(w, "case")) { return 1; }      if (str_eq(w, "char")) { return 1; }
    if (str_eq(w, "const")) { return 1; }     if (str_eq(w, "continue")) { return 1; }
    if (str_eq(w, "default")) { return 1; }   if (str_eq(w, "do")) { return 1; }
    if (str_eq(w, "double")) { return 1; }    if (str_eq(w, "else")) { return 1; }
    if (str_eq(w, "enum")) { return 1; }      if (str_eq(w, "extern")) { return 1; }
    if (str_eq(w, "float")) { return 1; }     if (str_eq(w, "for")) { return 1; }
    if (str_eq(w, "goto")) { return 1; }      if (str_eq(w, "if")) { return 1; }
    if (str_eq(w, "inline")) { return 1; }    if (str_eq(w, "int")) { return 1; }
    if (str_eq(w, "long")) { return 1; }      if (str_eq(w, "register")) { return 1; }
    if (str_eq(w, "restrict")) { return 1; }  if (str_eq(w, "return")) { return 1; }
    if (str_eq(w, "short")) { return 1; }     if (str_eq(w, "signed")) { return 1; }
    if (str_eq(w, "sizeof")) { return 1; }    if (str_eq(w, "static")) { return 1; }
    if (str_eq(w, "struct")) { return 1; }    if (str_eq(w, "switch")) { return 1; }
    if (str_eq(w, "typedef")) { return 1; }   if (str_eq(w, "union")) { return 1; }
    if (str_eq(w, "unsigned")) { return 1; }  if (str_eq(w, "void")) { return 1; }
    if (str_eq(w, "volatile")) { return 1; }  if (str_eq(w, "while")) { return 1; }
    if (str_eq(w, "bool")) { return 1; }      if (str_eq(w, "complex")) { return 1; }
    if (str_eq(w, "imaginary")) { return 1; }
    return 0;
}

// A query used where a value is expected, not on the right of a declaration.
// It becomes a statement expression that collects the matching rows into a
// NULL-terminated array and yields it, so `len(Orders <- [id > 0])` means what
// it reads as.
str gen_query_expr(Gen &g, Node e) {
    str src = e.s1;
    // The checker has already reported an unknown table; keep going so it can
    // report the rest of the file.
    if (bind_has(g.schemas, src) == 0) { return "NULL"; }

    g.query_depth = g.query_depth + 1;
    StringBuilder tagb = sb_new();
    sb_append(&tagb, "_q");
    sb_append(&tagb, str(g.query_depth));
    str tag = sb_to_str(&tagb);

    str prev = g.query_row;
    g.query_row = src;
    str cond = gen_expr(&g, e.c1);
    g.query_row = prev;
    g.query_depth = g.query_depth - 1;

    StringBuilder sb = sb_new();
    sb_append(&sb, "({ "); sb_append(&sb, src); sb_append(&sb, "** ");
    sb_append(&sb, tag); sb_append(&sb, " = ("); sb_append(&sb, src);
    sb_append(&sb, "**)strata_list_new("); sb_append(&sb, src);
    sb_append(&sb, "__count, sizeof(void*)); strata_int "); sb_append(&sb, tag);
    sb_append(&sb, "n = 0; for (strata_int "); sb_append(&sb, tag);
    sb_append(&sb, "i = 0; "); sb_append(&sb, tag); sb_append(&sb, "i < ");
    sb_append(&sb, src); sb_append(&sb, "__count; "); sb_append(&sb, tag);
    sb_append(&sb, "i++) { "); sb_append(&sb, src); sb_append(&sb, "* _row = ");
    sb_append(&sb, src); sb_append(&sb, "__rows["); sb_append(&sb, tag);
    sb_append(&sb, "i]; if ("); sb_append(&sb, cond); sb_append(&sb, ") { ");
    sb_append(&sb, tag); sb_append(&sb, "["); sb_append(&sb, tag);
    sb_append(&sb, "n++] = _row; } } strata_list_set_len(");
    sb_append(&sb, tag); sb_append(&sb, ", "); sb_append(&sb, tag);
    sb_append(&sb, "n); "); sb_append(&sb, tag); sb_append(&sb, "; })");
    return sb_to_str(&sb);
}

// sum/avg/min/max over a list of numbers, or over one column projected out
// of a list of rows. One runtime function serves every schema: for a
// projection it is handed the byte offset of the column inside the row, so it
// reads the field without knowing the type it came from.
str gen_aggregate(Gen &g, Node e, int kind) {
    NodeVec args = nv_at(e.v1);
    if (args.len == 0) { return "0"; }
    Node arg = nv_get(&args, 0);

    str elem = "i";
    str target = "";
    str offset = "-1";
    str row = "";
    if (arg.kind == 48) {
        str col = projection_ctype(&g, arg);
        if (str_len(col) > 0) {
            str base = expr_ctype(&g, arg.c1);
            row = str_slice(base, 0, str_len(base) - 2);
            if (str_eq(col, "strata_float") == 1) { elem = "f"; }
            target = gen_expr(&g, arg.c1);
            StringBuilder off = sb_new();
            sb_append(&off, "(long)offsetof("); sb_append(&off, row);
            sb_append(&off, ", "); sb_append(&off, arg.s1); sb_append(&off, ")");
            offset = sb_to_str(&off);
        }
    }
    if (str_len(target) == 0) {
        // A plain list of numbers: the elements are the values.
        target = gen_expr(&g, node_ptr(arg));
        str ct = expr_ctype(&g, node_ptr(arg));
        if (str_eq(ct, "strata_float*") == 1) { elem = "f"; }
    }

    StringBuilder call = sb_new();
    sb_append(&call, "strata_agg("); sb_append(&call, target);
    sb_append(&call, ", "); sb_append(&call, str(kind));
    sb_append(&call, ", '"); sb_append(&call, elem);
    sb_append(&call, "', "); sb_append(&call, offset); sb_append(&call, ")");

    if (kind == 1) { return sb_to_str(&call); }
    if (str_eq(elem, "f") == 1) { return sb_to_str(&call); }
    StringBuilder cast = sb_new();
    sb_append(&cast, "((strata_int)("); sb_append(&cast, sb_to_str(&call));
    sb_append(&cast, "))");
    return sb_to_str(&cast);
}

// The column type behind a projection like `rows.amount`, or "" when the
// argument is not a projection of a known record.
str projection_ctype(Gen &g, Node arg) {
    Node obj = node_at(arg.c1);
    str base = expr_ctype(&g, arg.c1);
    if (ends_with_star(base) == 0) { return ""; }
    str row = str_slice(base, 0, str_len(base) - 2);
    if (bind_has(g.schema_decls, row) == 0) { return ""; }
    Node db = node_at(str_to_int(bind_get(g.schema_decls, row)));
    NodeVec fs = nv_at(db.v1);
    int n = fs.len;
    for (int i = 0; i < n; i = i + 1) {
        Node f = nv_get(&fs, i);
        if (str_eq(f.s1, arg.s1) == 1) { return c_type(&g, f.c1); }
    }
    return "";
}

// The C type sum/min/max yields: that of the values being aggregated.
str agg_ctype(Gen &g, Node e) {
    NodeVec args = nv_at(e.v1);
    if (args.len == 0) { return "strata_float"; }
    Node arg = nv_get(&args, 0);
    if (arg.kind == 48) {
        str col = projection_ctype(&g, arg);
        if (str_len(col) > 0) { return col; }
        return "strata_float";
    }
    str ct = expr_ctype(&g, node_ptr(arg));
    if (str_eq(ct, "strata_float*") == 1) { return "strata_float"; }
    return "strata_int";
}

str cname(str w) {
    if (is_c_reserved(w) == 1) {
        StringBuilder sb = sb_new();
        sb_append(&sb, w);
        sb_append(&sb, "_");
        return sb_to_str(&sb);
    }
    return w;
}

// ── Static type of an expression, as a C type name ───────────────────────────

str expr_ctype(Gen &g, int p) {
    if (p == 0) { return ""; }
    Node e = node_at(p);
    int k = e.kind;
    if (k == 50) { return "strata_int"; }
    if (k == 51) { return "strata_float"; }
    if (k == 52) { return "strata_str"; }
    if (k == 53) { return "strata_int"; }
    if (k == 54) { return bind_get(g.var_types, e.s1); }
    if (k == 41) { return expr_ctype(&g, e.c1); }
    if (k == 43) { return expr_ctype(&g, e.c1); }
    if (k == 40) {
        if (is_cmp_op(e.s1) == 1) { return "strata_int"; }
        str lt = expr_ctype(&g, e.c1);
        str rt = expr_ctype(&g, e.c2);
        if (str_eq(lt, "strata_str")) { return "strata_str"; }
        if (str_eq(rt, "strata_str")) { return "strata_str"; }
        if (str_eq(lt, "strata_float")) { return "strata_float"; }
        if (str_eq(rt, "strata_float")) { return "strata_float"; }
        if (str_eq(lt, rt)) { return lt; }
        return "";
    }
    if (k == 44) {
        StringBuilder sb = sb_new();
        sb_append(&sb, e.s1);
        sb_append(&sb, "*");
        return sb_to_str(&sb);
    }
    if (k == 48) {
        str ot = expr_ctype(&g, e.c1);
        str rec = ot;
        if (ends_with_star(ot) == 1) { rec = str_slice(ot, 0, str_len(ot) - 1); }
        StringBuilder key = sb_new();
        sb_append(&key, rec); sb_append(&key, "."); sb_append(&key, e.s1);
        return bind_get(g.field_types, sb_to_str(&key));
    }
    if (k == 49) {
        str base = expr_ctype(&g, e.c1);
        if (str_eq(base, "strata_str")) { return "strata_int"; }
        if (ends_with_star(base) == 1) { return str_slice(base, 0, str_len(base) - 1); }
        return "";
    }
    if (k == 55) { return "strata_str"; }
    if (k == 46) {
        if (bind_has(g.records, e.s1) == 1) {
            StringBuilder sb = sb_new();
            sb_append(&sb, e.s1);
            sb_append(&sb, "**");
            return sb_to_str(&sb);
        }
        return "";
    }
    if (k == 42) {
        if (str_eq(e.s1, "str"))   { return "strata_str"; }
        if (str_eq(e.s1, "int"))   { return "strata_int"; }
        if (str_eq(e.s1, "float")) { return "strata_float"; }
        // An aggregate keeps its element's type, except avg which is always
        // float and count which is always int. Without this,
        // str(sum(rows.amount)) routes a double through the int converter and
        // 60.75 prints as 60.
        if (str_eq(e.s1, "count")) { return "strata_int"; }
        if (str_eq(e.s1, "len"))   { return "strata_int"; }
        if (str_eq(e.s1, "avg"))   { return "strata_float"; }
        int agg = 0;
        if (str_eq(e.s1, "sum") == 1) { agg = 1; }
        if (str_eq(e.s1, "min") == 1) { agg = 1; }
        if (str_eq(e.s1, "max") == 1) { agg = 1; }
        if (agg == 1) { return agg_ctype(&g, e); }
        str declared = bind_get(g.func_returns, e.s1);
        if (str_len(declared) > 0) { return declared; }
        return builtin_return(e.s1);
    }
    return "";
}

// Return types of the prelude's own functions. Without these a conversion such
// as str(strata_tensor_get(t, 0)) cannot tell a float from an int and silently
// truncates 6.5 to 6.
str builtin_return(str name) {
    if (str_eq(name, "strata_concat")) { return "strata_str"; }
    if (str_eq(name, "strata_int_to_str")) { return "strata_str"; }
    if (str_eq(name, "strata_float_to_str")) { return "strata_str"; }
    if (str_eq(name, "str_concat")) { return "strata_str"; }
    if (str_eq(name, "int_to_str")) { return "strata_str"; }
    if (str_eq(name, "float_to_str")) { return "strata_str"; }
    if (str_eq(name, "str_slice")) { return "strata_str"; }
    if (str_eq(name, "file_read")) { return "strata_str"; }
    if (str_eq(name, "str_len")) { return "strata_int"; }
    if (str_eq(name, "str_eq")) { return "strata_int"; }
    if (str_eq(name, "str_to_int")) { return "strata_int"; }
    if (str_eq(name, "str_index_of")) { return "strata_int"; }
    if (str_eq(name, "str_starts_with")) { return "strata_int"; }
    if (str_eq(name, "file_write")) { return "strata_int"; }
    if (str_eq(name, "file_exists")) { return "strata_int"; }
    if (str_eq(name, "strata_len")) { return "strata_int"; }
    if (str_eq(name, "strata_publish")) { return "strata_int"; }
    if (str_eq(name, "strata_run")) { return "strata_int"; }
    if (str_eq(name, "strata_model_load")) { return "strata_int"; }
    if (str_eq(name, "current_message")) { return "strata_str"; }
    if (str_eq(name, "strata_tensor")) { return "double*"; }
    if (str_eq(name, "strata_predict")) { return "double*"; }
    if (str_eq(name, "strata_tensor_add")) { return "double*"; }
    if (str_eq(name, "strata_tensor_get")) { return "strata_float"; }
    if (str_eq(name, "strata_tensor_set")) { return "void"; }
    return "";
}

int is_cmp_op(str op) {
    if (str_eq(op, "==")) { return 1; }   if (str_eq(op, "!=")) { return 1; }
    if (str_eq(op, "<"))  { return 1; }   if (str_eq(op, ">"))  { return 1; }
    if (str_eq(op, "<=")) { return 1; }   if (str_eq(op, ">=")) { return 1; }
    if (str_eq(op, "&&")) { return 1; }   if (str_eq(op, "||")) { return 1; }
    return 0;
}

// ── Expressions ──────────────────────────────────────────────────────────────

// A Strata string literal as a C string literal.
//
// The lexer decodes escapes, so by here a `\r` is a real carriage return.
// Re-escaping only backslash, quote and newline left tabs and carriage
// returns raw in the emitted C: a raw tab happens to be legal inside a C
// literal, and a raw CR ends the line, so "\r\n" failed to compile with
// "missing terminating \" character" pointing at generated code the author
// never wrote.
str c_escape(str v) {
    StringBuilder sb = sb_new();
    int n = str_len(v);
    for (int i = 0; i < n; i = i + 1) {
        int c = v[i];
        int special = 0;
        if (c == 92) { sb_append(&sb, "\\\\");  special = 1; }
        if (c == 34) { sb_append(&sb, "\\\"");  special = 1; }
        if (c == 10) { sb_append(&sb, "\\n");  special = 1; }
        if (c == 13) { sb_append(&sb, "\\r");  special = 1; }
        if (c == 9)  { sb_append(&sb, "\\t");  special = 1; }
        if (special == 0) { sb_append(&sb, char_str(c)); }
    }
    return sb_to_str(&sb);
}

// The oracle stores a float literal as a double and prints it, so trailing
// zeros disappear: 1000000.00 becomes 1000000.0 and 0.90 becomes 0.9. The
// literal's source text has to be normalised the same way or the generated C
// differs by characters that mean nothing.
str norm_float(str t) {
    int n = str_len(t);
    if (str_index_of(t, "e") >= 0) { return t; }
    if (str_index_of(t, "E") >= 0) { return t; }
    if (str_index_of(t, ".") < 0) {
        StringBuilder sb = sb_new();
        sb_append(&sb, t);
        sb_append(&sb, ".0");
        return sb_to_str(&sb);
    }
    int last = n - 1;
    while (last > 0) {
        if (t[last] != 48) { break; }            // '0'
        if (t[last - 1] == 46) { break; }        // keep one digit after '.'
        last = last - 1;
    }
    return str_slice(t, 0, last + 1);
}

int schema_has_column(Gen &g, str table, str col) {
    str cols = bind_get(g.schemas, table);
    if (str_len(cols) == 0) { return 0; }
    StringBuilder needle = sb_new();
    sb_append(&needle, ",");
    sb_append(&needle, col);
    sb_append(&needle, ",");
    if (str_index_of(cols, sb_to_str(&needle)) >= 0) { return 1; }
    return 0;
}

str gen_expr(Gen &g, int p) {
    if (p == 0) { return "0"; }
    Node e = node_at(p);
    int k = e.kind;

    if (k == 50) { return str(e.i1); }
    if (k == 51) { return norm_float(e.s1); }
    if (k == 52) {
        StringBuilder sb = sb_new();
        sb_append(&sb, "\"");
        sb_append(&sb, c_escape(e.s1));
        sb_append(&sb, "\"");
        return sb_to_str(&sb);
    }
    if (k == 53) { if (e.i1 == 1) { return "1"; } return "0"; }
    if (k == 54) {
        // A bare model name is the model itself, so Strata code never has to
        // name the generated C global.
        if (bind_has(g.models, e.s1) == 1) {
            StringBuilder sb = sb_new();
            sb_append(&sb, "&"); sb_append(&sb, e.s1); sb_append(&sb, "_instance");
            return sb_to_str(&sb);
        }
        // Inside a query condition a bare identifier naming a column of the
        // table under test refers to the candidate row.
        if (str_len(g.query_row) > 0) {
            if (schema_has_column(&g, g.query_row, e.s1) == 1) {
                StringBuilder sb = sb_new();
                sb_append(&sb, "_row->"); sb_append(&sb, e.s1);
                return sb_to_str(&sb);
            }
        }
        // A `T &x` parameter arrives as T* and must be dereferenced at use.
        if (bind_has(g.borrowed, e.s1) == 1) {
            StringBuilder sb = sb_new();
            sb_append(&sb, "(*"); sb_append(&sb, cname(e.s1)); sb_append(&sb, ")");
            return sb_to_str(&sb);
        }
        return cname(e.s1);
    }

    if (k == 40) {
        str l = gen_expr(&g, e.c1);
        str r = gen_expr(&g, e.c2);
        StringBuilder sb = sb_new();
        if (str_eq(e.s1, "+") == 1) {
            str lt = expr_ctype(&g, e.c1);
            str rt = expr_ctype(&g, e.c2);
            if (str_eq(lt, "strata_str") + str_eq(rt, "strata_str") > 0) {
                sb_append(&sb, "strata_concat(");
                sb_append(&sb, l); sb_append(&sb, ","); sb_append(&sb, r);
                sb_append(&sb, ")");
                return sb_to_str(&sb);
            }
            sb_append(&sb, "("); sb_append(&sb, l);
            sb_append(&sb, " + "); sb_append(&sb, r); sb_append(&sb, ")");
            return sb_to_str(&sb);
        }
        // Comparing two strings with C's == compares POINTERS. It looks right
        // whenever both sides are literals in the same binary, and silently
        // fails the moment one side was read from a file or built at runtime:
        // `status == "OPEN"` matched every row before a save and no row after
        // a load.
        int is_eq = str_eq(e.s1, "==");
        int is_ne = str_eq(e.s1, "!=");
        if (is_eq + is_ne > 0) {
            str lt = expr_ctype(&g, e.c1);
            str rt = expr_ctype(&g, e.c2);
            if (str_eq(lt, "strata_str") + str_eq(rt, "strata_str") > 0) {
                if (is_ne == 1) { sb_append(&sb, "(!"); }
                sb_append(&sb, "(strcmp("); sb_append(&sb, l);
                sb_append(&sb, ","); sb_append(&sb, r); sb_append(&sb, ") == 0)");
                if (is_ne == 1) { sb_append(&sb, ")"); }
                return sb_to_str(&sb);
            }
        }
        sb_append(&sb, "("); sb_append(&sb, l); sb_append(&sb, " ");
        sb_append(&sb, e.s1); sb_append(&sb, " "); sb_append(&sb, r);
        sb_append(&sb, ")");
        return sb_to_str(&sb);
    }

    if (k == 41) {
        StringBuilder sb = sb_new();
        sb_append(&sb, "("); sb_append(&sb, e.s1);
        sb_append(&sb, gen_expr(&g, e.c1)); sb_append(&sb, ")");
        return sb_to_str(&sb);
    }

    if (k == 42) { return gen_call(&g, e); }

    if (k == 43) {
        str inner = gen_expr(&g, e.c1);
        str ct = expr_ctype(&g, e.c1);
        if (ends_with_star(ct) == 1) { return inner; }
        if (str_index_of(inner, ".") >= 0) { return inner; }
        if (str_index_of(inner, "->") >= 0) { return inner; }
        StringBuilder sb = sb_new();
        sb_append(&sb, "(&"); sb_append(&sb, inner); sb_append(&sb, ")");
        return sb_to_str(&sb);
    }

    if (k == 44) {
        StringBuilder sb = sb_new();
        sb_append(&sb, "(("); sb_append(&sb, e.s1); sb_append(&sb, "*)(");
        sb_append(&sb, gen_expr(&g, e.c1)); sb_append(&sb, "))");
        return sb_to_str(&sb);
    }

    if (k == 45) {
        StringBuilder sb = sb_new();
        sb_append(&sb, "strata_predict(&"); sb_append(&sb, e.s1);
        sb_append(&sb, "_instance,"); sb_append(&sb, gen_expr(&g, e.c1));
        sb_append(&sb, ")");
        return sb_to_str(&sb);
    }

    if (k == 47) {
        NodeVec els = nv_at(e.v1);
        if (els.len == 0) { return "NULL"; }
        // Allocated with a length header rather than written as a C99
        // compound literal: a bare array carries no count, and len() then has
        // nothing to read.
        StringBuilder sb = sb_new();
        str et = expr_ctype(&g, node_ptr(nv_get(&els, 0)));
        if (str_len(et) == 0) { et = "strata_int"; }
        int n = els.len;
        g.query_depth = g.query_depth + 1;
        StringBuilder tagb = sb_new();
        sb_append(&tagb, "_lit");
        sb_append(&tagb, str(g.query_depth));
        str tag = sb_to_str(&tagb);
        g.query_depth = g.query_depth - 1;

        sb_append(&sb, "({ "); sb_append(&sb, et); sb_append(&sb, "* ");
        sb_append(&sb, tag); sb_append(&sb, " = ("); sb_append(&sb, et);
        sb_append(&sb, "*)strata_list_new("); sb_append(&sb, str(n));
        sb_append(&sb, ", sizeof("); sb_append(&sb, et); sb_append(&sb, "));");
        for (int i = 0; i < n; i = i + 1) {
            sb_append(&sb, " "); sb_append(&sb, tag);
            sb_append(&sb, "["); sb_append(&sb, str(i)); sb_append(&sb, "] = ");
            sb_append(&sb, gen_expr(&g, node_ptr(nv_get(&els, i))));
            sb_append(&sb, ";");
        }
        sb_append(&sb, " "); sb_append(&sb, tag); sb_append(&sb, "; })");
        return sb_to_str(&sb);
    }

    if (k == 49) {
        StringBuilder sb = sb_new();
        sb_append(&sb, gen_expr(&g, e.c1)); sb_append(&sb, "[");
        sb_append(&sb, gen_expr(&g, e.c2)); sb_append(&sb, "]");
        return sb_to_str(&sb);
    }

    if (k == 48) {
        str obj = gen_expr(&g, e.c1);
        str ct = expr_ctype(&g, e.c1);
        StringBuilder sb = sb_new();
        sb_append(&sb, obj);
        if (ends_with_star(ct) == 1) { sb_append(&sb, "->"); }
        if (ends_with_star(ct) == 0) { sb_append(&sb, "."); }
        sb_append(&sb, e.s1);
        return sb_to_str(&sb);
    }

    if (k == 55) {
        // The layout writes to a FILE*; open_memstream makes that FILE* a
        // buffer, so the same generated function serves a file and an HTTP
        // response body.
        g.query_depth = g.query_depth + 1;
        StringBuilder tagb = sb_new();
        sb_append(&tagb, "_r"); sb_append(&tagb, str(g.query_depth));
        str tag = sb_to_str(&tagb);
        g.query_depth = g.query_depth - 1;
        StringBuilder sb = sb_new();
        sb_append(&sb, "({ char* "); sb_append(&sb, tag);
        sb_append(&sb, "b = NULL; size_t "); sb_append(&sb, tag);
        sb_append(&sb, "n = 0; FILE* "); sb_append(&sb, tag);
        sb_append(&sb, "f = open_memstream(&"); sb_append(&sb, tag);
        sb_append(&sb, "b, &"); sb_append(&sb, tag); sb_append(&sb, "n); ");
        sb_append(&sb, e.s1); sb_append(&sb, "_render("); sb_append(&sb, tag);
        sb_append(&sb, "f");
        NodeVec rargs = nv_at(e.v1);
        int nra = rargs.len;
        for (int i = 0; i < nra; i = i + 1) {
            sb_append(&sb, ",");
            sb_append(&sb, gen_expr(&g, node_ptr(nv_get(&rargs, i))));
        }
        sb_append(&sb, "); strata_render_end("); sb_append(&sb, tag);
        sb_append(&sb, "f, &"); sb_append(&sb, tag); sb_append(&sb, "b); })");
        return sb_to_str(&sb);
    }
    if (k == 46) { return gen_query_expr(&g, e); }

    return "0";
}

str gen_call(Gen &g, Node e) {
    NodeVec args = nv_at(e.v1);
    int n = args.len;

    if (str_eq(e.s1, "len") == 1) {
        StringBuilder sb = sb_new();
        sb_append(&sb, "strata_len(");
        sb_append(&sb, gen_expr(&g, node_ptr(nv_get(&args, 0))));
        sb_append(&sb, ")");
        return sb_to_str(&sb);
    }
    if (str_eq(e.s1, "count") == 1) {
        StringBuilder sb = sb_new();
        sb_append(&sb, "strata_len(");
        sb_append(&sb, gen_expr(&g, node_ptr(nv_get(&args, 0))));
        sb_append(&sb, ")");
        return sb_to_str(&sb);
    }
    int aggk = -1;
    if (str_eq(e.s1, "sum") == 1) { aggk = 0; }
    if (str_eq(e.s1, "avg") == 1) { aggk = 1; }
    if (str_eq(e.s1, "min") == 1) { aggk = 2; }
    if (str_eq(e.s1, "max") == 1) { aggk = 3; }
    if (aggk >= 0) { return gen_aggregate(&g, e, aggk); }
    if (str_eq(e.s1, "str") == 1) {
        // Routing a float through the integer converter truncates it.
        str at = expr_ctype(&g, node_ptr(nv_get(&args, 0)));
        StringBuilder sb = sb_new();
        if (str_eq(at, "strata_float") == 1) { sb_append(&sb, "strata_float_to_str("); }
        if (str_eq(at, "strata_float") == 0) { sb_append(&sb, "strata_int_to_str("); }
        sb_append(&sb, gen_expr(&g, node_ptr(nv_get(&args, 0))));
        sb_append(&sb, ")");
        return sb_to_str(&sb);
    }
    if (str_eq(e.s1, "int") == 1) {
        StringBuilder sb = sb_new();
        sb_append(&sb, "((strata_int)(");
        sb_append(&sb, gen_expr(&g, node_ptr(nv_get(&args, 0))));
        sb_append(&sb, "))");
        return sb_to_str(&sb);
    }
    if (str_eq(e.s1, "float") == 1) {
        StringBuilder sb = sb_new();
        sb_append(&sb, "((strata_float)(");
        sb_append(&sb, gen_expr(&g, node_ptr(nv_get(&args, 0))));
        sb_append(&sb, "))");
        return sb_to_str(&sb);
    }

    StringBuilder sb = sb_new();
    sb_append(&sb, cname(e.s1));
    sb_append(&sb, "(");
    for (int i = 0; i < n; i = i + 1) {
        if (i > 0) { sb_append(&sb, ", "); }
        sb_append(&sb, gen_expr(&g, node_ptr(nv_get(&args, i))));
    }
    sb_append(&sb, ")");
    return sb_to_str(&sb);
}

// ── Native block substitution ────────────────────────────────────────────────
// `$name` in a native block refers to a Strata binding; the sigil is dropped.

str subst_native(str code) {
    StringBuilder sb = sb_new();
    int n = str_len(code);
    for (int i = 0; i < n; i = i + 1) {
        if (code[i] != 36) { sb_append(&sb, char_str(code[i])); }
    }
    return sb_to_str(&sb);
}

// ── Statements ───────────────────────────────────────────────────────────────

def gen_block(Gen &g, int vec_p) {
    NodeVec body = nv_at(vec_p);
    int n = body.len;
    for (int i = 0; i < n; i = i + 1) { gen_stmt(&g, nv_get(&body, i)); }
}

def gen_stmt(Gen &g, Node st) {
    int k = st.kind;

    if (k == 23) {                                    // ExprStmt
        Node e = node_at(st.c1);
        if (e.kind == 42) {
            if (str_eq(e.s1, "native") == 1) {
                NodeVec args = nv_at(e.v1);
                Node lit = nv_get(&args, 0);
                // Emitted verbatim, newlines and all — the oracle does not
                // wrap a statement-position native block in braces.
                emit_raw(&g, subst_native(lit.s1));
                return;
            }
        }
        StringBuilder sb = sb_new();
        sb_append(&sb, gen_expr(&g, st.c1));
        sb_append(&sb, ";");
        cg_emit(&g, sb_to_str(&sb));
        return;
    }

    if (k == 20) { gen_var_decl(&g, st); return; }

    if (k == 21) {                                    // return
        if (st.c1 == 0) { cg_emit(&g, "return;"); return; }
        StringBuilder sb = sb_new();
        sb_append(&sb, "return ");
        sb_append(&sb, gen_expr(&g, st.c1));
        sb_append(&sb, ";");
        cg_emit(&g, sb_to_str(&sb));
        return;
    }

    if (k == 22) {                                    // if / else
        StringBuilder sb = sb_new();
        sb_append(&sb, "if ("); sb_append(&sb, gen_expr(&g, st.c1));
        sb_append(&sb, ") {");
        cg_emit(&g, sb_to_str(&sb));
        g.indent = g.indent + 1;
        gen_block(&g, st.v1);
        g.indent = g.indent - 1;
        if (st.v2 != 0) {
            cg_emit(&g, "} else {");
            g.indent = g.indent + 1;
            gen_block(&g, st.v2);
            g.indent = g.indent - 1;
        }
        cg_emit(&g, "}");
        return;
    }

    if (k == 29) {                                    // while
        StringBuilder sb = sb_new();
        sb_append(&sb, "while ("); sb_append(&sb, gen_expr(&g, st.c1));
        sb_append(&sb, ") {");
        cg_emit(&g, sb_to_str(&sb));
        g.indent = g.indent + 1;
        gen_block(&g, st.v1);
        g.indent = g.indent - 1;
        cg_emit(&g, "}");
        return;
    }

    if (k == 30) { gen_for(&g, st); return; }
    if (k == 73) { gen_for_in(&g, st); return; }

    if (k == 28) {                                    // assignment
        StringBuilder sb = sb_new();
        sb_append(&sb, gen_expr(&g, st.c1));
        sb_append(&sb, " = ");
        sb_append(&sb, gen_expr(&g, st.c2));
        sb_append(&sb, ";");
        cg_emit(&g, sb_to_str(&sb));
        return;
    }

    if (k == 31) { cg_emit(&g, "break;"); return; }
    if (k == 32) { cg_emit(&g, "continue;"); return; }

    if (k == 24) {                                    // assert
        if (g.test_mode == 1) {
            // Record and continue: one failure should not hide the rest of
            // the block.
            StringBuilder sb = sb_new();
            sb_append(&sb, "__strata_assert(("); sb_append(&sb, gen_expr(&g, st.c1));
            sb_append(&sb, "), \""); sb_append(&sb, assert_text(st.c1));
            sb_append(&sb, "\", "); sb_append(&sb, str(st.line)); sb_append(&sb, ");");
            cg_emit(&g, sb_to_str(&sb));
            return;
        }
    }
    if (k == 24) {                                    // assert
        StringBuilder sb = sb_new();
        sb_append(&sb, "if(!(");
        sb_append(&sb, gen_expr(&g, st.c1));
        sb_append(&sb, ")){fprintf(stderr,\"[STRATA ASSERT FAILED] line ");
        sb_append(&sb, str(st.line));
        sb_append(&sb, "\\n\");exit(1);}");
        cg_emit(&g, sb_to_str(&sb));
        return;
    }

    if (k == 25) {                                    // render X to "path"
        StringBuilder sb = sb_new();
        sb_append(&sb, "{ FILE* _f=fopen(\""); sb_append(&sb, st.s2);
        sb_append(&sb, "\",\"w\"); if(_f){ "); sb_append(&sb, st.s1);
        sb_append(&sb, "_render(_f); fclose(_f); } }");
        cg_emit(&g, sb_to_str(&sb));
        return;
    }

    if (k == 75) {                                    // save / load
        StringBuilder sb = sb_new();
        sb_append(&sb, st.s2);
        if (str_eq(st.s1, "save") == 1) { sb_append(&sb, "__save(\""); }
        if (str_eq(st.s1, "save") == 0) { sb_append(&sb, "__load(\""); }
        sb_append(&sb, st.s3); sb_append(&sb, "\");");
        cg_emit(&g, sb_to_str(&sb));
        return;
    }

    if (k == 26) {                                    // assert group
        StringBuilder note = sb_new();
        sb_append(&note, "/* assert group: "); sb_append(&note, st.s1); sb_append(&note, " */");
        cg_emit(&g, sb_to_str(&note));
        NodeVec vb = nv_at(st.v1);
        int nvb = vb.len;
        for (int i = 0; i < nvb; i = i + 1) { gen_stmt(&g, nv_get(&vb, i)); }
        return;
    }

    if (k == 76) {                                    // delete
        // The surviving rows are moved down and the count is reduced. The row
        // is not freed: something else may still be holding it — a list a
        // query returned a moment ago points at the same rows — and this
        // language has no way to know. A leak is a better bug than a
        // dangling pointer.
        str prev_row = g.query_row;
        g.query_row = st.s1;
        str dcond = gen_expr(&g, st.c1);
        g.query_row = prev_row;

        cg_emit(&g, "{");
        g.indent = g.indent + 1;
        cg_emit(&g, "strata_int _kept = 0;");
        StringBuilder dh = sb_new();
        sb_append(&dh, "for (strata_int _di = 0; _di < "); sb_append(&dh, st.s1);
        sb_append(&dh, "__count; _di++) {");
        cg_emit(&g, sb_to_str(&dh));
        g.indent = g.indent + 1;
        StringBuilder db = sb_new();
        sb_append(&db, st.s1); sb_append(&db, "* _row = "); sb_append(&db, st.s1);
        sb_append(&db, "__rows[_di];");
        cg_emit(&g, sb_to_str(&db));
        StringBuilder dk = sb_new();
        sb_append(&dk, "if (!("); sb_append(&dk, dcond); sb_append(&dk, ")) { ");
        sb_append(&dk, st.s1); sb_append(&dk, "__rows[_kept++] = _row; }");
        cg_emit(&g, sb_to_str(&dk));
        g.indent = g.indent - 1;
        cg_emit(&g, "}");
        StringBuilder dc = sb_new();
        sb_append(&dc, st.s1); sb_append(&dc, "__count = _kept;");
        cg_emit(&g, sb_to_str(&dc));
        g.indent = g.indent - 1;
        cg_emit(&g, "}");
        return;
    }

    if (k == 27) {                                    // insert
        NodeVec pairs = nv_at(st.v1);
        cg_emit(&g, "{");
        g.indent = g.indent + 1;
        StringBuilder alloc = sb_new();
        sb_append(&alloc, st.s1); sb_append(&alloc, "* _r = (");
        sb_append(&alloc, st.s1); sb_append(&alloc, "*)calloc(1, sizeof(");
        sb_append(&alloc, st.s1); sb_append(&alloc, "));");
        cg_emit(&g, sb_to_str(&alloc));
        int n = pairs.len;
        for (int i = 0; i < n; i = i + 1) {
            Node pair = nv_get(&pairs, i);
            StringBuilder set = sb_new();
            sb_append(&set, "_r->"); sb_append(&set, pair.s1);
            sb_append(&set, " = "); sb_append(&set, gen_expr(&g, pair.c1));
            sb_append(&set, ";");
            cg_emit(&g, sb_to_str(&set));
        }
        StringBuilder push = sb_new();
        sb_append(&push, "if ("); sb_append(&push, st.s1);
        sb_append(&push, "__count < STRATA_TABLE_CAP) "); sb_append(&push, st.s1);
        sb_append(&push, "__rows["); sb_append(&push, st.s1); sb_append(&push, "__count++] = _r;");
        cg_emit(&g, sb_to_str(&push));
        g.indent = g.indent - 1;
        cg_emit(&g, "}");
        return;
    }
}

def gen_for(Gen &g, Node st) {
    str init = "";
    if (st.c1 != 0) {
        Node i = node_at(st.c1);
        if (i.kind == 20) {
            str ct = c_type(&g, i.c1);
            StringBuilder sb = sb_new();
            sb_append(&sb, ct); sb_append(&sb, " "); sb_append(&sb, cname(i.s1));
            sb_append(&sb, " = "); sb_append(&sb, gen_expr(&g, i.c2));
            init = sb_to_str(&sb);
            g.var_types = bind_cons(i.s1, ct, g.var_types);
        }
        if (i.kind == 28) {
            StringBuilder sb = sb_new();
            sb_append(&sb, gen_expr(&g, i.c1)); sb_append(&sb, " = ");
            sb_append(&sb, gen_expr(&g, i.c2));
            init = sb_to_str(&sb);
        }
    }
    str step = "";
    if (st.c3 != 0) {
        Node s = node_at(st.c3);
        if (s.kind == 28) {
            StringBuilder sb = sb_new();
            sb_append(&sb, gen_expr(&g, s.c1)); sb_append(&sb, " = ");
            sb_append(&sb, gen_expr(&g, s.c2));
            step = sb_to_str(&sb);
        }
    }
    StringBuilder head = sb_new();
    sb_append(&head, "for ("); sb_append(&head, init); sb_append(&head, "; ");
    sb_append(&head, gen_expr(&g, st.c2)); sb_append(&head, "; ");
    sb_append(&head, step); sb_append(&head, ") {");
    cg_emit(&g, sb_to_str(&head));
    g.indent = g.indent + 1;
    gen_block(&g, st.v1);
    g.indent = g.indent - 1;
    cg_emit(&g, "}");
}

def gen_var_decl(Gen &g, Node st) {
    str ctype = c_type(&g, st.c1);

    if (st.c2 == 0) {
        // Zero rather than whatever the stack held. A pointer zeroes to NULL,
        // which the rest of the runtime already treats as empty.
        str zero = "0";
        if (ends_with_star(ctype) == 1) { zero = "NULL"; }
        if (str_eq(ctype, "strata_str") == 1) { zero = "\"\""; }
        StringBuilder z = sb_new();
        sb_append(&z, ctype); sb_append(&z, " "); sb_append(&z, cname(st.s1));
        sb_append(&z, " = "); sb_append(&z, zero); sb_append(&z, ";");
        cg_emit(&g, sb_to_str(&z));
        g.var_types = bind_cons(st.s1, ctype, g.var_types);
        return;
    }

    Node val = node_at(st.c2);

    if (val.kind == 42) {
        if (str_eq(val.s1, "native") == 1) {
            NodeVec args = nv_at(val.v1);
            Node lit = nv_get(&args, 0);
            StringBuilder d = sb_new();
            sb_append(&d, ctype); sb_append(&d, " "); sb_append(&d, cname(st.s1));
            sb_append(&d, ";");
            cg_emit(&g, sb_to_str(&d));
            emit_raw(&g, "{");
            emit_raw(&g, subst_native(lit.s1));
            emit_raw(&g, "}");
            g.var_types = bind_cons(st.s1, ctype, g.var_types);
            return;
        }
    }

    if (val.kind == 46) {
        g.var_types = bind_cons(st.s1, ctype, g.var_types);
        if (bind_has(g.schemas, val.s1) == 0) {
            // No such table; the checker has already reported it.
            StringBuilder sb = sb_new();
            sb_append(&sb, ctype); sb_append(&sb, " "); sb_append(&sb, cname(st.s1));
            sb_append(&sb, " = NULL;");
            cg_emit(&g, sb_to_str(&sb));
            return;
        }
        g.query_row = val.s1;
        str cond = gen_expr(&g, val.c1);
        g.query_row = "";

        // Querying into a record rather than a list means "the first row that
        // matches, or none".
        Node vt = node_at(st.c1);
        if (vt.kind != 12) {
            StringBuilder d0 = sb_new();
            sb_append(&d0, ctype); sb_append(&d0, " "); sb_append(&d0, cname(st.s1));
            sb_append(&d0, " = NULL;");
            cg_emit(&g, sb_to_str(&d0));
            cg_emit(&g, "{");
            g.indent = g.indent + 1;
            StringBuilder l0 = sb_new();
            sb_append(&l0, "for (strata_int _i = 0; _i < "); sb_append(&l0, val.s1);
            sb_append(&l0, "__count; _i++) {");
            cg_emit(&g, sb_to_str(&l0));
            g.indent = g.indent + 1;
            StringBuilder r0 = sb_new();
            sb_append(&r0, val.s1); sb_append(&r0, "* _row = "); sb_append(&r0, val.s1);
            sb_append(&r0, "__rows[_i];");
            cg_emit(&g, sb_to_str(&r0));
            StringBuilder t0 = sb_new();
            sb_append(&t0, "if ("); sb_append(&t0, cond); sb_append(&t0, ") { ");
            sb_append(&t0, cname(st.s1)); sb_append(&t0, " = _row; break; }");
            cg_emit(&g, sb_to_str(&t0));
            g.indent = g.indent - 1;
            cg_emit(&g, "}");
            g.indent = g.indent - 1;
            cg_emit(&g, "}");
            return;
        }

        StringBuilder d = sb_new();
        sb_append(&d, ctype); sb_append(&d, " "); sb_append(&d, cname(st.s1));
        sb_append(&d, " = ("); sb_append(&d, ctype); sb_append(&d, ")strata_list_new(");
        sb_append(&d, val.s1); sb_append(&d, "__count, sizeof(void*));");
        cg_emit(&g, sb_to_str(&d));
        cg_emit(&g, "{");
        g.indent = g.indent + 1;
        cg_emit(&g, "strata_int _n = 0;");
        StringBuilder loop = sb_new();
        sb_append(&loop, "for (strata_int _i = 0; _i < "); sb_append(&loop, val.s1);
        sb_append(&loop, "__count; _i++) {");
        cg_emit(&g, sb_to_str(&loop));
        g.indent = g.indent + 1;
        StringBuilder row = sb_new();
        sb_append(&row, val.s1); sb_append(&row, "* _row = "); sb_append(&row, val.s1);
        sb_append(&row, "__rows[_i];");
        cg_emit(&g, sb_to_str(&row));
        StringBuilder test = sb_new();
        sb_append(&test, "if ("); sb_append(&test, cond); sb_append(&test, ") { ");
        sb_append(&test, cname(st.s1)); sb_append(&test, "[_n++] = _row; }");
        cg_emit(&g, sb_to_str(&test));
        g.indent = g.indent - 1;
        cg_emit(&g, "}");
        StringBuilder term = sb_new();
        sb_append(&term, "strata_list_set_len("); sb_append(&term, cname(st.s1));
        sb_append(&term, ", _n);");
        cg_emit(&g, sb_to_str(&term));
        g.indent = g.indent - 1;
        cg_emit(&g, "}");
        return;
    }

    StringBuilder sb = sb_new();
    sb_append(&sb, ctype); sb_append(&sb, " "); sb_append(&sb, cname(st.s1));
    sb_append(&sb, " = "); sb_append(&sb, gen_expr(&g, st.c2)); sb_append(&sb, ";");
    cg_emit(&g, sb_to_str(&sb));
    g.var_types = bind_cons(st.s1, ctype, g.var_types);
}

// ── Declarations and functions ───────────────────────────────────────────────

def forward_declare(Gen &g, Node d) {
    if (d.kind == 3) { fwd_struct(&g, d.s1); }
    if (d.kind == 4) { fwd_struct(&g, d.s1); }
}

def fwd_struct(Gen &g, str name) {
    StringBuilder sb = sb_new();
    sb_append(&sb, "typedef struct "); sb_append(&sb, name);
    sb_append(&sb, " "); sb_append(&sb, name); sb_append(&sb, ";");
    emit_raw(&g, sb_to_str(&sb));
}

// Serialisers generated from the schema. Field order is the declaration
// order, which is also the contract: a file written by one schema is not
// readable by another.
// The type letter a column carries in the schema header.
str col_tchar(Gen &g, Node fd) {
    str ct = c_type(&g, fd.c1);
    if (str_eq(ct, "strata_str") == 1) { return "s"; }
    if (str_eq(ct, "strata_float") == 1) { return "f"; }
    return "i";
}

// Serialisers generated from the schema.
//
// The file carries a header naming each column and its type, so a table saved
// by one version of a schema loads under another: a dropped column is skipped,
// a new one keeps its zero value, and a column whose type changed is refused
// rather than misread. Field order is no longer the contract — the names are.
// A column is written and read only if it is a scalar. A record-typed column
// is a pointer into this process, and a pointer means nothing in a file — see
// bootstrap/stage0.py for the C this used to generate and the compilers that
// rejected it.
int is_scalar_col(Gen &g, Node fd) {
    str ct = c_type(&g, fd.c1);
    if (str_eq(ct, "strata_int") == 1) { return 1; }
    if (str_eq(ct, "strata_float") == 1) { return 1; }
    if (str_eq(ct, "strata_str") == 1) { return 1; }
    return 0;
}

def gen_table_io(Gen &g, str name, int fields_vec) {
    NodeVec all_cols = nv_at(fields_vec);
    NodeVec fs = nv_new();
    int all_n = all_cols.len;
    for (int ci = 0; ci < all_n; ci = ci + 1) {
        Node col = nv_get(&all_cols, ci);
        if (is_scalar_col(&g, col) == 1) { nv_push(&fs, col); }
    }
    int n = fs.len;

    StringBuilder a = sb_new();
    sb_append(&a, "static strata_int "); sb_append(&a, name);
    sb_append(&a, "__save(strata_str path) {");
    emit_raw(&g, sb_to_str(&a));
    emit_raw(&g, "    FILE* f = fopen(path, \"w\"); if (!f) return 0;");

    StringBuilder hd = sb_new();
    sb_append(&hd, "    fprintf(f, \"#strata\\t"); sb_append(&hd, name);
    for (int i = 0; i < n; i = i + 1) {
        Node fd = nv_get(&fs, i);
        sb_append(&hd, "\\t"); sb_append(&hd, fd.s1); sb_append(&hd, ":");
        sb_append(&hd, col_tchar(&g, fd));
    }
    sb_append(&hd, "\\n\");");
    emit_raw(&g, sb_to_str(&hd));

    StringBuilder lp = sb_new();
    sb_append(&lp, "    for (strata_int i = 0; i < "); sb_append(&lp, name);
    sb_append(&lp, "__count; i++) {");
    emit_raw(&g, sb_to_str(&lp));
    StringBuilder rr = sb_new();
    sb_append(&rr, "        "); sb_append(&rr, name); sb_append(&rr, "* r = ");
    sb_append(&rr, name); sb_append(&rr, "__rows[i];");
    emit_raw(&g, sb_to_str(&rr));
    for (int i = 0; i < n; i = i + 1) {
        Node fd = nv_get(&fs, i);
        if (i > 0) { emit_raw(&g, "        fputc(0x09, f);"); }
        str ct = c_type(&g, fd.c1);
        StringBuilder w = sb_new();
        if (str_eq(ct, "strata_str") == 1) {
            sb_append(&w, "        strata_write_escaped(f, r->"); sb_append(&w, fd.s1);
            sb_append(&w, ");");
        }
        if (str_eq(ct, "strata_float") == 1) {
            sb_append(&w, "        fprintf(f, \"%.17g\", r->"); sb_append(&w, fd.s1);
            sb_append(&w, ");");
        }
        if (str_eq(ct, "strata_str") == 0) { if (str_eq(ct, "strata_float") == 0) {
                sb_append(&w, "        fprintf(f, \"%lld\", (long long)r->"); sb_append(&w, fd.s1);
                sb_append(&w, ");");
            } }
        emit_raw(&g, sb_to_str(&w));
    }
    emit_raw(&g, "        fputc(0x0a, f);");
    emit_raw(&g, "    }");
    emit_raw(&g, "    fclose(f); return 1;");
    emit_raw(&g, "}");

    StringBuilder b = sb_new();
    sb_append(&b, "static strata_int "); sb_append(&b, name);
    sb_append(&b, "__load(strata_str path) {");
    emit_raw(&g, sb_to_str(&b));
    emit_raw(&g, "    FILE* f = fopen(path, \"r\"); if (!f) return 0;");
    emit_raw(&g, "    char buf[4096];");
    emit_raw(&g, "    char _names[STRATA_MAX_COLS][STRATA_NAME_CAP];");
    emit_raw(&g, "    char _types[STRATA_MAX_COLS];");
    emit_raw(&g, "    int _map[STRATA_MAX_COLS];");
    emit_raw(&g, "    int _ncol = strata_read_header(f, _names, _types, STRATA_MAX_COLS);");
    StringBuilder e0 = sb_new();
    sb_append(&e0, "    if (_ncol == -2) { fclose(f); "); sb_append(&e0, name);
    sb_append(&e0, "__count = 0; return 1; }");
    emit_raw(&g, sb_to_str(&e0));
    emit_raw(&g, "    if (_ncol == -1) {");
    StringBuilder e1 = sb_new();
    sb_append(&e1, "        strata_load_refuse(\""); sb_append(&e1, name);
    sb_append(&e1, "\", path, \"no schema header; it was written before headers existed. Re-save it.\");");
    emit_raw(&g, sb_to_str(&e1));
    emit_raw(&g, "        fclose(f); return 0;");
    emit_raw(&g, "    }");
    emit_raw(&g, "    for (int _c = 0; _c < _ncol; _c++) {");
    emit_raw(&g, "        _map[_c] = -1;");
    for (int i = 0; i < n; i = i + 1) {
        Node fd = nv_get(&fs, i);
        StringBuilder m0 = sb_new();
        sb_append(&m0, "        if (strcmp(_names[_c], \""); sb_append(&m0, fd.s1);
        sb_append(&m0, "\") == 0) {");
        emit_raw(&g, sb_to_str(&m0));
        StringBuilder m1 = sb_new();
        sb_append(&m1, "            if (_types[_c] != '"); sb_append(&m1, col_tchar(&g, fd));
        sb_append(&m1, "') {");
        emit_raw(&g, sb_to_str(&m1));
        StringBuilder m2 = sb_new();
        sb_append(&m2, "                strata_load_refuse(\""); sb_append(&m2, name);
        sb_append(&m2, "\", path, \"column '"); sb_append(&m2, fd.s1);
        sb_append(&m2, "' changed type since it was saved\");");
        emit_raw(&g, sb_to_str(&m2));
        emit_raw(&g, "                fclose(f); return 0;");
        emit_raw(&g, "            }");
        StringBuilder m3 = sb_new();
        sb_append(&m3, "            _map[_c] = "); sb_append(&m3, str(i)); sb_append(&m3, ";");
        emit_raw(&g, sb_to_str(&m3));
        emit_raw(&g, "        }");
    }
    emit_raw(&g, "    }");
    StringBuilder z = sb_new();
    sb_append(&z, "    "); sb_append(&z, name); sb_append(&z, "__count = 0;");
    emit_raw(&g, sb_to_str(&z));
    emit_raw(&g, "    while (1) {");
    StringBuilder al = sb_new();
    sb_append(&al, "        "); sb_append(&al, name); sb_append(&al, "* r = (");
    sb_append(&al, name); sb_append(&al, "*)calloc(1, sizeof("); sb_append(&al, name);
    sb_append(&al, "));");
    emit_raw(&g, sb_to_str(&al));
    // A column the file does not carry keeps its zero value; for a str that is
    // "" rather than NULL, so a new column cannot crash a printf.
    for (int i = 0; i < n; i = i + 1) {
        Node fd = nv_get(&fs, i);
        if (str_eq(c_type(&g, fd.c1), "strata_str") == 1) {
            StringBuilder zs = sb_new();
            sb_append(&zs, "        r->"); sb_append(&zs, fd.s1); sb_append(&zs, " = \"\";");
            emit_raw(&g, sb_to_str(&zs));
        }
    }
    emit_raw(&g, "        int _more = 0, _eof = 0;");
    emit_raw(&g, "        for (int _c = 0; _c < _ncol; _c++) {");
    emit_raw(&g, "            _more = strata_read_field(f, buf, 4096);");
    emit_raw(&g, "            if (_more < 0) { _eof = 1; break; }");
    emit_raw(&g, "            switch (_map[_c]) {");
    for (int i = 0; i < n; i = i + 1) {
        Node fd = nv_get(&fs, i);
        str ct = c_type(&g, fd.c1);
        StringBuilder cs = sb_new();
        sb_append(&cs, "                case "); sb_append(&cs, str(i));
        sb_append(&cs, ": r->"); sb_append(&cs, fd.s1); sb_append(&cs, " = ");
        if (str_eq(ct, "strata_str") == 1) { sb_append(&cs, "strata_dup(buf);"); }
        if (str_eq(ct, "strata_float") == 1) { sb_append(&cs, "strtod(buf, NULL);"); }
        if (str_eq(ct, "strata_str") == 0) { if (str_eq(ct, "strata_float") == 0) {
                sb_append(&cs, "(strata_int)atoll(buf);");
            } }
        sb_append(&cs, " break;");
        emit_raw(&g, sb_to_str(&cs));
    }
    emit_raw(&g, "                default: break;   /* a column this schema no longer has */");
    emit_raw(&g, "            }");
    emit_raw(&g, "        }");
    emit_raw(&g, "        if (_eof) { free(r); break; }");
    StringBuilder ps = sb_new();
    sb_append(&ps, "        if ("); sb_append(&ps, name);
    sb_append(&ps, "__count < STRATA_TABLE_CAP) "); sb_append(&ps, name);
    sb_append(&ps, "__rows["); sb_append(&ps, name); sb_append(&ps, "__count++] = r;");
    emit_raw(&g, sb_to_str(&ps));
    emit_raw(&g, "    }");
    emit_raw(&g, "    fclose(f); return 1;");
    emit_raw(&g, "}");
}

def gen_table_storage(Gen &g, str name) {
    // Backing store for a database block, emitted after the struct so the row
    // type is complete.
    StringBuilder a = sb_new();
    sb_append(&a, "static "); sb_append(&a, name); sb_append(&a, "* ");
    sb_append(&a, name); sb_append(&a, "__rows[STRATA_TABLE_CAP];");
    emit_raw(&g, sb_to_str(&a));
    StringBuilder b = sb_new();
    sb_append(&b, "static strata_int "); sb_append(&b, name); sb_append(&b, "__count = 0;");
    emit_raw(&g, sb_to_str(&b));
}

def gen_struct(Gen &g, str name, int fields_vec) {
    StringBuilder open = sb_new();
    sb_append(&open, "\nstruct "); sb_append(&open, name); sb_append(&open, " {");
    emit_raw(&g, sb_to_str(&open));
    NodeVec fs = nv_at(fields_vec);
    int n = fs.len;
    for (int i = 0; i < n; i = i + 1) {
        Node f = nv_get(&fs, i);
        StringBuilder line = sb_new();
        sb_append(&line, "    "); sb_append(&line, c_type(&g, f.c1));
        sb_append(&line, " "); sb_append(&line, f.s1); sb_append(&line, ";");
        emit_raw(&g, sb_to_str(&line));
    }
    emit_raw(&g, "};");
}

def gen_decl(Gen &g, Node d) {
    if (d.kind == 77) {                           // const
        // A file-scope constant, emitted with the declarations so it is in
        // scope for every function below. The type comes from the declaration
        // rather than from the value.
        str ct = c_type(&g, d.c1);
        g.const_types = bind_cons(d.s1, ct, g.const_types);
        g.var_types = bind_cons(d.s1, ct, g.var_types);
        str value = gen_expr(&g, d.c2);
        StringBuilder cb = sb_new();
        if (str_eq(ct, "strata_str") == 1) { sb_append(&cb, "static "); }
        else { sb_append(&cb, "static const "); }
        sb_append(&cb, ct); sb_append(&cb, " "); sb_append(&cb, cname(d.s1));
        sb_append(&cb, " = "); sb_append(&cb, value); sb_append(&cb, ";");
        emit_raw(&g, sb_to_str(&cb));
        return;
    }
    if (d.kind == 3) { gen_struct(&g, d.s1, d.v1); gen_table_storage(&g, d.s1);
        gen_table_io(&g, d.s1, d.v1); return; }
    if (d.kind == 4) { gen_struct(&g, d.s1, d.v1); return; }
    if (d.kind == 5) { gen_model(&g, d); return; }
    if (d.kind == 6) { gen_report(&g, d); return; }
    if (d.kind == 70) { gen_layout(&g, d); return; }
    if (d.kind == 26) { return; }                 // verify: emitted after functions
    if (d.kind == 74) {
        // The header declares the functions; re-declaring them risks
        // conflicting with the real signature.
        StringBuilder sb = sb_new();
        sb_append(&sb, "#include <"); sb_append(&sb, d.s1); sb_append(&sb, ">");
        emit_raw(&g, sb_to_str(&sb));
        // Return types are recorded so conversions dispatch correctly:
        // without this str(sqrt(x)) routes a float through the int converter.
        NodeVec ffns = nv_at(d.v1);
        int nf = ffns.len;
        for (int i = 0; i < nf; i = i + 1) {
            Node ff = nv_get(&ffns, i);
            g.func_returns = bind_cons(ff.s2, c_type(&g, ff.c1), g.func_returns);
        }
        return;
    }
}

def gen_model(Gen &g, Node d) {
    StringBuilder a = sb_new();
    // Same layout as StrataModel in the prelude, so strata_predict can read
    // it without depending on field order.
    sb_append(&a, "\ntypedef StrataModel ");
    sb_append(&a, d.s1); sb_append(&a, ";");
    emit_raw(&g, sb_to_str(&a));
    Node in_t = node_at(d.c1);
    Node out_t = node_at(d.c2);
    // `dims` is the input width, then each layer's output width; `acts` the
    // activation after each layer. A model with no hidden layers is one layer,
    // so the forward pass has no special case for it.
    NodeVec hidden = nv_at(d.v1);
    int nh = hidden.len;
    StringBuilder dims = sb_new();
    StringBuilder acts = sb_new();
    sb_append(&dims, str(in_t.i2));
    for (int i = 0; i < nh; i = i + 1) {
        Node h = nv_get(&hidden, i);
        sb_append(&dims, ","); sb_append(&dims, str(h.i1));
        sb_append(&acts, "'"); sb_append(&acts, activation_char(h.s1));
        sb_append(&acts, "',");
    }
    sb_append(&dims, ","); sb_append(&dims, str(out_t.i2));
    sb_append(&acts, "'n'");                  // the output layer is linear

    StringBuilder b = sb_new();
    sb_append(&b, "static "); sb_append(&b, d.s1); sb_append(&b, " ");
    sb_append(&b, d.s1); sb_append(&b, "_instance = {");
    sb_append(&b, str(in_t.i1)); sb_append(&b, ",");
    sb_append(&b, str(in_t.i2)); sb_append(&b, ",");
    sb_append(&b, str(out_t.i1)); sb_append(&b, ",");
    sb_append(&b, str(out_t.i2)); sb_append(&b, ",NULL,");
    sb_append(&b, str(nh + 1)); sb_append(&b, ",{");
    sb_append(&b, sb_to_str(&dims)); sb_append(&b, "},{");
    sb_append(&b, sb_to_str(&acts)); sb_append(&b, "}};");
    emit_raw(&g, sb_to_str(&b));
}

// A report renders its datasource and its metrics as Markdown. It used to
// emit the title and nothing else, so `render` produced a one-line file that
// looked like it had worked — and it named a function that was never emitted,
// so it did not even link. The metrics are evaluated with `rows` bound to the
// datasource result, which is what makes `int deals = strata_len(rows);` mean
// something.
def gen_report(Gen &g, Node d) {
    str title = escape_quotes(d.s2);
    StringBuilder head = sb_new();
    sb_append(&head, "\nvoid "); sb_append(&head, d.s1);
    sb_append(&head, "_render(FILE* _out) {");
    emit_raw(&g, sb_to_str(&head));

    str src = "";
    if (d.c1 != 0) {
        Node q0 = node_at(d.c1);
        if (q0.kind == 46) { src = q0.s1; }
    }
    if (bind_has(g.schemas, src) == 0) {
        // The checker has already reported an unknown or missing table.
        StringBuilder t0 = sb_new();
        sb_append(&t0, "    fprintf(_out, \"# "); sb_append(&t0, title);
        sb_append(&t0, "\\n\");");
        emit_raw(&g, sb_to_str(&t0));
        emit_raw(&g, "}");
        return;
    }

    int prev_vars = g.var_types;
    StringBuilder rt = sb_new();
    sb_append(&rt, src); sb_append(&rt, "**");
    g.var_types = bind_cons("rows", sb_to_str(&rt), g.const_types);

    Node q = node_at(d.c1);
    str rows = gen_query_expr(&g, q);
    StringBuilder r0 = sb_new();
    sb_append(&r0, "    "); sb_append(&r0, src); sb_append(&r0, "** rows = ");
    sb_append(&r0, rows); sb_append(&r0, ";");
    emit_raw(&g, sb_to_str(&r0));
    emit_raw(&g, "    strata_int _rn = strata_len(rows);");
    StringBuilder t1 = sb_new();
    sb_append(&t1, "    fprintf(_out, \"# "); sb_append(&t1, title);
    sb_append(&t1, "\\n\\n\");");
    emit_raw(&g, sb_to_str(&t1));

    NodeVec mets = nv_at(d.v1);
    int nm = mets.len;
    for (int i = 0; i < nm; i = i + 1) {
        Node m = nv_get(&mets, i);
        str ct = c_type(&g, m.c1);
        str val = gen_expr(&g, m.c2);
        StringBuilder ln = sb_new();
        sb_append(&ln, "    fprintf(_out, \"- ");
        sb_append(&ln, escape_quotes(m.s1));
        if (str_eq(ct, "strata_str") == 1) {
            sb_append(&ln, ": %s\\n\", (strata_str)(");
        }
        if (str_eq(ct, "strata_float") == 1) {
            sb_append(&ln, ": %.17g\\n\", (double)(");
        }
        if (str_eq(ct, "strata_str") + str_eq(ct, "strata_float") == 0) {
            sb_append(&ln, ": %lld\\n\", (long long)(");
        }
        sb_append(&ln, val); sb_append(&ln, "));");
        emit_raw(&g, sb_to_str(&ln));
    }
    if (nm > 0) { emit_raw(&g, "    fprintf(_out, \"\\n\");"); }

    Node db = node_at(str_to_int(bind_get(g.schema_decls, src)));
    NodeVec fields = nv_at(db.v1);
    int nf = fields.len;
    StringBuilder hdr = sb_new();
    sb_append(&hdr, "    fprintf(_out, \"|");
    StringBuilder rule = sb_new();
    sb_append(&rule, "\\n|");
    StringBuilder fmt = sb_new();
    sb_append(&fmt, "        fprintf(_out, \"|");
    StringBuilder args = sb_new();
    for (int i = 0; i < nf; i = i + 1) {
        Node f = nv_get(&fields, i);
        sb_append(&hdr, " "); sb_append(&hdr, f.s1); sb_append(&hdr, " |");
        sb_append(&rule, " --- |");
        str ct = c_type(&g, f.c1);
        if (str_eq(ct, "strata_str") == 1) {
            sb_append(&fmt, " %s |");
            sb_append(&args, ", _row->"); sb_append(&args, f.s1);
        }
        if (str_eq(ct, "strata_float") == 1) {
            sb_append(&fmt, " %.17g |");
            sb_append(&args, ", (double)_row->"); sb_append(&args, f.s1);
        }
        if (str_eq(ct, "strata_str") + str_eq(ct, "strata_float") == 0) {
            sb_append(&fmt, " %lld |");
            sb_append(&args, ", (long long)_row->"); sb_append(&args, f.s1);
        }
    }
    sb_append(&hdr, sb_to_str(&rule));
    sb_append(&hdr, "\\n\");");
    emit_raw(&g, sb_to_str(&hdr));
    emit_raw(&g, "    for (strata_int _i = 0; _i < _rn; _i++) {");
    StringBuilder rw = sb_new();
    sb_append(&rw, "        "); sb_append(&rw, src); sb_append(&rw, "* _row = rows[_i];");
    emit_raw(&g, sb_to_str(&rw));
    sb_append(&fmt, "\\n\""); sb_append(&fmt, sb_to_str(&args)); sb_append(&fmt, ");");
    emit_raw(&g, sb_to_str(&fmt));
    emit_raw(&g, "    }");
    emit_raw(&g, "    fprintf(_out, \"\\n%lld row(s).\\n\", (long long)_rn);");
    emit_raw(&g, "}");
    g.var_types = prev_vars;
}

str fn_signature(Gen &g, Node fn) {
    str rt = "void";
    if (fn.c1 != 0) { rt = c_type(&g, fn.c1); }
    if (str_eq(fn.s1, "def") == 1) { rt = "void"; }
    NodeVec ps = nv_at(fn.v1);
    int n = ps.len;
    StringBuilder params = sb_new();
    if (n == 0) { sb_append(&params, "void"); }
    for (int i = 0; i < n; i = i + 1) {
        if (i > 0) { sb_append(&params, ", "); }
        sb_append(&params, c_param(&g, nv_get(&ps, i)));
    }
    StringBuilder sb = sb_new();
    sb_append(&sb, rt); sb_append(&sb, " "); sb_append(&sb, cname(fn.s2));
    sb_append(&sb, "("); sb_append(&sb, sb_to_str(&params)); sb_append(&sb, ")");
    return sb_to_str(&sb);
}

def forward_fn(Gen &g, Node fn) {
    StringBuilder sb = sb_new();
    sb_append(&sb, fn_signature(&g, fn)); sb_append(&sb, ";");
    emit_raw(&g, sb_to_str(&sb));
}

def gen_function(Gen &g, Node fn) {
    str rt = "void";
    if (fn.c1 != 0) { rt = c_type(&g, fn.c1); }
    if (str_eq(fn.s1, "def") == 1) { rt = "void"; }
    g.func_returns = bind_cons(fn.s2, rt, g.func_returns);
    g.var_types = g.const_types;
    g.borrowed = 0;

    NodeVec ps = nv_at(fn.v1);
    int np = ps.len;
    for (int i = 0; i < np; i = i + 1) {
        Node prm = nv_get(&ps, i);
        str ct = c_type(&g, prm.c1);
        if (prm.i1 == 1) {
            if (ends_with_star(ct) == 0) { g.borrowed = bind_cons(prm.s1, "1", g.borrowed); }
        }
        g.var_types = bind_cons(prm.s1, ct, g.var_types);
    }

    if (str_eq(g.target, "wasm") == 1) {
        if (str_eq(fn.s1, "foreign") == 0) {
            // Every top-level function is part of the module's interface; a
            // wasm module has no main() to start from.
            StringBuilder ex = sb_new();
            sb_append(&ex, "\n__attribute__((export_name(\"");
            sb_append(&ex, fn.s2); sb_append(&ex, "\")))");
            emit_raw(&g, sb_to_str(&ex));
        }
    }
    StringBuilder head = sb_new();
    sb_append(&head, "\n"); sb_append(&head, fn_signature(&g, fn)); sb_append(&head, " {");
    emit_raw(&g, sb_to_str(&head));
    g.indent = 1;
    gen_block(&g, fn.v2);
    g.indent = 0;
    emit_raw(&g, "}");
}

// ── Import resolution ────────────────────────────────────────────────────────
// Mirrors the resolver in stage0: `from std` and `from compiler` map to a
// directory in the project tree, anything else is an external registry.

// A title or a metric name goes inside a C string literal.
str escape_quotes(str s) {
    return replace_all(s, "\"", "\\\"");
}

// Strata has no string-replace builtin; the driver needs one for the final
// rename pass, so it is written here in terms of index-of and slice.
str replace_all(str hay, str needle, str rep) {
    int nlen = str_len(needle);
    if (nlen == 0) { return hay; }
    StringBuilder sb = sb_new();
    int i = 0;
    int hlen = str_len(hay);
    while (i < hlen) {
        int rest_start = i;
        str rest = str_slice(hay, rest_start, hlen);
        int at = str_index_of(rest, needle);
        if (at < 0) {
            sb_append(&sb, rest);
            i = hlen;
        }
        if (at >= 0) {
            sb_append(&sb, str_slice(rest, 0, at));
            sb_append(&sb, rep);
            i = rest_start + at + nlen;
        }
    }
    return sb_to_str(&sb);
}

// ── Driver ───────────────────────────────────────────────────────────────────

str generate(str root, str source_path) {
    return generate_for(root, source_path, "native");
}

str generate_for(str root, str source_path, str target) {
    return generate_mode(root, source_path, target, 0);
}

str generate_mode(str root, str source_path, str target, int test_mode) {
    Gen g = gen_new();
    g.target = target;
    g.test_mode = test_mode;
    g.verifies = nv_ptr(nv_new());
    StringBuilder out = sb_new();
    g.out = sb_ptr(out);

    Node unit = parse_source(file_read(source_path));

    NodeVec mods = nv_new();
    str seen = "";
    int unresolved = 0;
    // `app` imports resolve beside the file being compiled, so the project's
    // own src/ directory is derived from the source path rather than the tree
    // root.
    collect_modules_from(root, dir_of(source_path), unit, &mods, &seen, &unresolved);

    // A freestanding WebAssembly build has no libc and uses its own prelude.
    StringBuilder preamble_path = sb_new();
    sb_append(&preamble_path, root);
    sb_append(&preamble_path, "/compiler/runtime_preamble");
    if (str_eq(g.target, "wasm") == 1) { sb_append(&preamble_path, "_wasm"); }
    sb_append(&preamble_path, ".c");
    emit_raw(&g, file_read(sb_to_str(&preamble_path)));

    // Record type names are needed before any type is rendered.
    int nm = mods.len;
    for (int i = 0; i < nm; i = i + 1) { note_records(&g, nv_get(&mods, i)); }
    note_records(&g, unit);

    int emitted_decls = 0;
    int emitted_fns = preamble_builtins();

    for (int i = 0; i < nm; i = i + 1) {
        Node m = nv_get(&mods, i);
        emit_unit(&g, m, 0, &emitted_decls, &emitted_fns, m.s1);
    }
    emit_unit(&g, unit, 1, &emitted_decls, &emitted_fns, "");

    // Verify blocks come last: they call functions, and emitting them with the
    // declarations would make those calls implicit declarations.
    for (int v = 0; v < nm; v = v + 1) { gen_verifies(&g, nv_get(&mods, v)); }
    gen_verifies(&g, unit);

    // A module with no main() is a library unit; the registry is emitted
    // either way so both entry points can call it.
    gen_stream_registry(&g, unit, &mods);

    if (g.test_mode == 1) { gen_test_main(&g); }
    int emit_entry = has_main(unit);
    if (g.test_mode == 1) { emit_entry = 0; }
    if (str_eq(g.target, "wasm") == 1) { emit_entry = 0; }
    if (emit_entry == 1) {
        emit_raw(&g, "\nint main(int argc, char** argv) {\n    __strata_argc = argc;\n    __strata_argv = argv;\n    __strata_register_streams();\n    return (int)strata_main();\n}\n");
    }

    // The Strata entry point is renamed so the C entry point can wrap it.
    str result = sb_to_str(&out);
    result = replace_all(result, "\nstrata_int main(void);", "\nstrata_int strata_main(void);");
    result = replace_all(result, "\nstrata_int main(void) {", "\nstrata_int strata_main(void) {");
    result = replace_all(result, "\nvoid main(void);", "\nvoid strata_main(void);");
    return result;
}

def gen_verifies(Gen &g, Node unit) {
    NodeVec decls = nv_at(unit.v2);
    int n = decls.len;
    for (int i = 0; i < n; i = i + 1) {
        Node d = nv_get(&decls, i);
        if (d.kind == 26) {
            NodeVec vs = nv_at(g.verifies);
            nv_push(&vs, d);
            gen_verify(&g, d);
        }
    }
}

// Short source-like rendering of an assertion, for the failure line.
str assert_text(int p) {
    if (p == 0) { return "<expr>"; }
    Node e = node_at(p);
    if (e.kind == 40) {
        StringBuilder sb = sb_new();
        sb_append(&sb, assert_text(e.c1)); sb_append(&sb, " ");
        sb_append(&sb, e.s1); sb_append(&sb, " ");
        sb_append(&sb, assert_text(e.c2));
        return sb_to_str(&sb);
    }
    if (e.kind == 54) { return e.s1; }
    if (e.kind == 50) { return str(e.i1); }
    if (e.kind == 52) {
        StringBuilder sb = sb_new();
        sb_append(&sb, "'"); sb_append(&sb, e.s1); sb_append(&sb, "'");
        return sb_to_str(&sb);
    }
    if (e.kind == 42) {
        StringBuilder sb = sb_new();
        sb_append(&sb, e.s1); sb_append(&sb, "(...)");
        return sb_to_str(&sb);
    }
    if (e.kind == 48) {
        StringBuilder sb = sb_new();
        sb_append(&sb, assert_text(e.c1)); sb_append(&sb, ".");
        sb_append(&sb, e.s1);
        return sb_to_str(&sb);
    }
    return "<expr>";
}

str verify_symbol(str label) {
    StringBuilder safe = sb_new();
    int n = str_len(label);
    int cap = n;
    if (cap > 48) { cap = 48; }
    for (int i = 0; i < cap; i = i + 1) {
        int c = label[i];
        int alnum = 0;
        if (c >= 48) { if (c <= 57) { alnum = 1; } }
        if (c >= 65) { if (c <= 90) { alnum = 1; } }
        if (c >= 97) { if (c <= 122) { alnum = 1; } }
        if (alnum == 1) { sb_append(&safe, char_str(c)); }
        if (alnum == 0) { sb_append(&safe, "_"); }
    }
    return sb_to_str(&safe);
}

// An entry point that runs every verify block and reports.
def gen_test_main(Gen &g) {
    emit_raw(&g, "\nint main(int argc, char** argv) {");
    emit_raw(&g, "    __strata_argc = argc; __strata_argv = argv;");
    emit_raw(&g, "    __strata_register_streams();");
    emit_raw(&g, "    int blocks = 0, failed_blocks = 0;");
    NodeVec vs = nv_at(g.verifies);
    int n = vs.len;
    for (int i = 0; i < n; i = i + 1) {
        Node d = nv_get(&vs, i);
        emit_raw(&g, "    {");
        emit_raw(&g, "        int before = __strata_fail_count;");
        StringBuilder lab = sb_new();
        sb_append(&lab, "        fprintf(stderr, \""); sb_append(&lab, d.s1);
        sb_append(&lab, "\\n\");");
        emit_raw(&g, sb_to_str(&lab));
        StringBuilder call = sb_new();
        sb_append(&call, "        __strata_verify_"); sb_append(&call, verify_symbol(d.s1));
        sb_append(&call, "();");
        emit_raw(&g, sb_to_str(&call));
        emit_raw(&g, "        blocks++;");
        emit_raw(&g, "        if (__strata_fail_count > before) failed_blocks++;");
        emit_raw(&g, "    }");
    }
    emit_raw(&g, "    fprintf(stderr, \"\\n  %d block(s), %d assertion(s), %d failed\\n\", blocks, __strata_assert_count, __strata_fail_count);");
    emit_raw(&g, "    return __strata_fail_count == 0 ? 0 : 1;");
    emit_raw(&g, "}");
}

def gen_verify(Gen &g, Node decl) {
    // A verify block becomes a function a test driver can call.
    str safe = verify_symbol(decl.s1);
    StringBuilder head = sb_new();
    sb_append(&head, "\n/* verify: "); sb_append(&head, decl.s1); sb_append(&head, " */");
    emit_raw(&g, sb_to_str(&head));
    StringBuilder sig = sb_new();
    sb_append(&sig, "void __strata_verify_"); sb_append(&sig, safe);
    sb_append(&sig, "(void) {");
    emit_raw(&g, sb_to_str(&sig));
    g.indent = 1;
    g.var_types = 0;
    NodeVec body = nv_at(decl.v1);
    int nb = body.len;
    for (int i = 0; i < nb; i = i + 1) { gen_stmt(&g, nv_get(&body, i)); }
    g.indent = 0;
    emit_raw(&g, "}");
}

def note_records(Gen &g, Node unit) {
    NodeVec decls = nv_at(unit.v2);
    int n = decls.len;
    for (int i = 0; i < n; i = i + 1) {
        Node d = nv_get(&decls, i);
        if (d.kind == 3) { note_record(&g, d); }
        if (d.kind == 4) { note_record(&g, d); }
        if (d.kind == 5) { g.models = bind_cons(d.s1, "1", g.models); }
    }
}

def note_record(Gen &g, Node d) {
    g.records = bind_cons(d.s1, "1", g.records);
    NodeVec fs = nv_at(d.v1);
    int n = fs.len;
    StringBuilder cols = sb_new();
    sb_append(&cols, ",");
    for (int i = 0; i < n; i = i + 1) {
        Node f = nv_get(&fs, i);
        sb_append(&cols, f.s1);
        sb_append(&cols, ",");
        StringBuilder key = sb_new();
        sb_append(&key, d.s1); sb_append(&key, "."); sb_append(&key, f.s1);
        g.field_types = bind_cons(sb_to_str(&key), c_type(&g, f.c1), g.field_types);
    }
    g.schemas = bind_cons(d.s1, sb_to_str(&cols), g.schemas);
    g.schema_decls = bind_cons(d.s1, str(node_ptr(d)), g.schema_decls);
}

// Register every stream handler against its channel. The channel is the
// handler's name: `stream Ingest(str m)` receives messages published to
// "Ingest".
def gen_stream_registry(Gen &g, Node unit, NodeVec &mods) {
    emit_raw(&g, "\nstatic void __strata_register_streams(void) {");
    int found = 0;
    NodeVec rfns = nv_at(unit.v3);
    int rn = rfns.len;
    for (int i = 0; i < rn; i = i + 1) {
        Node f = nv_get(&rfns, i);
        if (str_eq(f.s1, "stream") == 1) { found = found + 1; }
    }
    int nm = mods.len;
    for (int m = 0; m < nm; m = m + 1) {
        Node mu = nv_get(&mods, m);
        NodeVec mfns = nv_at(mu.v3);
        int mn = mfns.len;
        for (int j = 0; j < mn; j = j + 1) {
            Node f = nv_get(&mfns, j);
            if (str_eq(f.s1, "stream") == 1) { found = found + 1; }
        }
    }
    if (found == 0) { emit_raw(&g, "    /* no stream handlers */"); }
    emit_stream_regs(&g, unit);
    for (int m = 0; m < nm; m = m + 1) { emit_stream_regs(&g, nv_get(&mods, m)); }
    emit_raw(&g, "}");
}

def emit_stream_regs(Gen &g, Node unit) {
    NodeVec fns = nv_at(unit.v3);
    int n = fns.len;
    for (int i = 0; i < n; i = i + 1) {
        Node f = nv_get(&fns, i);
        if (str_eq(f.s1, "stream") == 1) {
            StringBuilder line = sb_new();
            sb_append(&line, "    strata_on(\"");
            sb_append(&line, f.s2);
            sb_append(&line, "\", (StrataHandler)");
            sb_append(&line, cname(f.s2));
            sb_append(&line, ");");
            emit_raw(&g, sb_to_str(&line));
        }
    }
}

int has_main(Node unit) {
    NodeVec fns = nv_at(unit.v3);
    int n = fns.len;
    for (int i = 0; i < n; i = i + 1) {
        Node f = nv_get(&fns, i);
        if (str_eq(f.s2, "main") == 1) { return 1; }
    }
    return 0;
}

def emit_unit(Gen &g, Node unit, int is_root, int &emitted_decls, int &emitted_fns, str label) {
    NodeVec decls = nv_at(unit.v2);
    NodeVec fns = nv_at(unit.v3);

    NodeVec pending_d = nv_new();
    int nd = decls.len;
    for (int i = 0; i < nd; i = i + 1) {
        Node d = nv_get(&decls, i);
        if (bind_has(emitted_decls, d.s1) == 0) {
            emitted_decls = bind_cons(d.s1, "1", emitted_decls);
            nv_push(&pending_d, d);
        }
    }
    NodeVec pending_f = nv_new();
    int nf = fns.len;
    for (int j = 0; j < nf; j = j + 1) {
        Node f = nv_get(&fns, j);
        if (bind_has(emitted_fns, f.s2) == 0) {
            emitted_fns = bind_cons(f.s2, "1", emitted_fns);
            nv_push(&pending_f, f);
        }
    }

    int dn = pending_d.len;
    int fnc = pending_f.len;
    if (is_root == 0) {
        if (dn + fnc > 0) {
            StringBuilder sep = sb_new();
            sb_append(&sep, "\n/* ── module ");
            sb_append(&sep, label);
            sb_append(&sep, " ── */");
            emit_raw(&g, sb_to_str(&sep));
        }
    }
    for (int a = 0; a < dn; a = a + 1) { forward_declare(&g, nv_get(&pending_d, a)); }
    // Constants first, whatever order they were written in — see stage0.py.
    for (int b0 = 0; b0 < dn; b0 = b0 + 1) {
        Node cdecl = nv_get(&pending_d, b0);
        if (cdecl.kind == 77) { gen_decl(&g, cdecl); }
    }
    for (int b = 0; b < dn; b = b + 1) {
        Node odecl = nv_get(&pending_d, b);
        if (odecl.kind != 77) { gen_decl(&g, odecl); }
    }
    int fn2 = pending_f.len;
    for (int c = 0; c < fn2; c = c + 1) { forward_fn(&g, nv_get(&pending_f, c)); }
    for (int d2 = 0; d2 < fn2; d2 = d2 + 1) { gen_function(&g, nv_get(&pending_f, d2)); }
}

int preamble_builtins() {
    int h = 0;
    h = bind_cons("file_exists", "1", h);      h = bind_cons("file_read", "1", h);
    h = bind_cons("file_write", "1", h);       h = bind_cons("float_to_str", "1", h);
    h = bind_cons("int_to_str", "1", h);       h = bind_cons("sb_append_f", "1", h);
    h = bind_cons("sb_append_line_f", "1", h); h = bind_cons("sb_new_f", "1", h);
    h = bind_cons("str_concat", "1", h);       h = bind_cons("str_eq", "1", h);
    h = bind_cons("str_index_of", "1", h);     h = bind_cons("str_len", "1", h);
    h = bind_cons("str_slice", "1", h);        h = bind_cons("str_starts_with", "1", h);
    h = bind_cons("str_to_int", "1", h);       h = bind_cons("strata_concat", "1", h);
    h = bind_cons("strata_float_to_str", "1", h);
    h = bind_cons("strata_int_to_str", "1", h);
    return h;
}

// ── Layout rendering ─────────────────────────────────────────────────────────
//
// A layout becomes a function that writes HTML to a stream. Declarative
// properties map onto inline CSS; a property with no mapping is dropped rather
// than guessed at.

str html_tag(str tag) {
    if (str_eq(tag, "window")) { return "div"; }
    if (str_eq(tag, "row"))    { return "div"; }
    if (str_eq(tag, "column")) { return "div"; }
    if (str_eq(tag, "grid"))   { return "div"; }
    if (str_eq(tag, "text"))   { return "span"; }
    if (str_eq(tag, "spacer")) { return "div"; }
    if (str_eq(tag, "canvas")) { return "canvas"; }
    if (str_eq(tag, "button")) { return "button"; }
    if (str_eq(tag, "image"))  { return "img"; }
    // The UI tier could render data but not collect any, so an application
    // could show a list and never add to it.
    if (str_eq(tag, "form"))   { return "form"; }
    if (str_eq(tag, "field"))  { return "input"; }
    return "div";
}

int is_void_tag(str tag) {
    if (str_eq(tag, "input") == 1) { return 1; }
    if (str_eq(tag, "img") == 1)   { return 1; }
    return 0;
}

// Properties that are HTML attributes rather than style. Anything not here and
// not a CSS property is still emitted as a data- attribute, so an unrecognised
// one is visible rather than silently dropped.
int is_attr_prop(str name) {
    str known = ",action,method,name,type,placeholder,value,required,href,src,alt,step,min,max,";
    StringBuilder needle = sb_new();
    sb_append(&needle, ","); sb_append(&needle, name); sb_append(&needle, ",");
    if (str_index_of(known, sb_to_str(&needle)) >= 0) { return 1; }
    return 0;
}

str attrs_for(Gen &g, Node el) {
    StringBuilder sb = sb_new();
    NodeVec props = nv_at(el.v1);
    int n = props.len;
    for (int i = 0; i < n; i = i + 1) {
        Node p = nv_get(&props, i);
        if (is_attr_prop(p.s1) == 1) {
            str raw = raw_literal(p.c1);
            if (str_len(raw) > 0) {
                sb_append(&sb, " "); sb_append(&sb, p.s1);
                sb_append(&sb, "=\\\""); sb_append(&sb, html_escape(raw));
                sb_append(&sb, "\\\"");
            }
        }
    }
    return sb_to_str(&sb);
}

str css_for_prop(str name, str raw) {
    StringBuilder sb = sb_new();
    if (str_eq(name, "background")) { sb_append(&sb, "background:"); sb_append(&sb, raw); return sb_to_str(&sb); }
    if (str_eq(name, "color"))      { sb_append(&sb, "color:"); sb_append(&sb, raw); return sb_to_str(&sb); }
    if (str_eq(name, "weight"))     { sb_append(&sb, "font-weight:"); sb_append(&sb, raw); return sb_to_str(&sb); }
    if (str_eq(name, "size"))       { sb_append(&sb, "font-size:"); sb_append(&sb, raw); sb_append(&sb, "px"); return sb_to_str(&sb); }
    if (str_eq(name, "width"))      { sb_append(&sb, "width:"); sb_append(&sb, raw); sb_append(&sb, "px"); return sb_to_str(&sb); }
    if (str_eq(name, "height"))     { sb_append(&sb, "height:"); sb_append(&sb, raw); sb_append(&sb, "px"); return sb_to_str(&sb); }
    if (str_eq(name, "padding"))    { sb_append(&sb, "padding:"); sb_append(&sb, raw); sb_append(&sb, "px"); return sb_to_str(&sb); }
    if (str_eq(name, "padding_top")){ sb_append(&sb, "padding-top:"); sb_append(&sb, raw); sb_append(&sb, "px"); return sb_to_str(&sb); }
    if (str_eq(name, "margin_top")) { sb_append(&sb, "margin-top:"); sb_append(&sb, raw); sb_append(&sb, "px"); return sb_to_str(&sb); }
    if (str_eq(name, "border_radius")) { sb_append(&sb, "border-radius:"); sb_append(&sb, raw); sb_append(&sb, "px"); return sb_to_str(&sb); }
    if (str_eq(name, "border_color")) { sb_append(&sb, "border:1px solid "); sb_append(&sb, raw); return sb_to_str(&sb); }
    if (str_eq(name, "spacing"))    { sb_append(&sb, "gap:"); sb_append(&sb, raw); sb_append(&sb, "px"); return sb_to_str(&sb); }
    if (str_eq(name, "padding_x"))  {
        sb_append(&sb, "padding-left:"); sb_append(&sb, raw);
        sb_append(&sb, "px;padding-right:"); sb_append(&sb, raw); sb_append(&sb, "px");
        return sb_to_str(&sb);
    }
    if (str_eq(name, "padding_y"))  {
        sb_append(&sb, "padding-top:"); sb_append(&sb, raw);
        sb_append(&sb, "px;padding-bottom:"); sb_append(&sb, raw); sb_append(&sb, "px");
        return sb_to_str(&sb);
    }
    if (str_eq(name, "columns"))    {
        sb_append(&sb, "grid-template-columns:repeat("); sb_append(&sb, raw); sb_append(&sb, ",1fr)");
        return sb_to_str(&sb);
    }
    return "";
}

str raw_literal(int p) {
    if (p == 0) { return ""; }
    Node v = node_at(p);
    if (v.kind == 52) { return v.s1; }
    if (v.kind == 50) { return str(v.i1); }
    if (v.kind == 51) { return norm_float(v.s1); }
    return "";
}

str css_for(Gen &g, Node el) {
    StringBuilder sb = sb_new();
    int first = 1;
    if (str_eq(el.s1, "row") == 1) {
        sb_append(&sb, "display:flex;flex-direction:row;align-items:center"); first = 0;
    }
    if (str_eq(el.s1, "column") == 1) {
        sb_append(&sb, "display:flex;flex-direction:column"); first = 0;
    }
    if (str_eq(el.s1, "grid") == 1) { sb_append(&sb, "display:grid"); first = 0; }
    NodeVec props = nv_at(el.v1);
    int n = props.len;
    for (int i = 0; i < n; i = i + 1) {
        Node pr = nv_get(&props, i);
        str raw = raw_literal(pr.c1);
        if (str_len(raw) > 0) {
            str css = css_for_prop(pr.s1, raw);
            if (str_len(css) > 0) {
                if (first == 0) { sb_append(&sb, ";"); }
                sb_append(&sb, css);
                first = 0;
            }
        }
    }
    return sb_to_str(&sb);
}

str html_escape(str t) {
    StringBuilder sb = sb_new();
    int n = str_len(t);
    for (int i = 0; i < n; i = i + 1) {
        int c = t[i];
        if (c == 34) { sb_append(&sb, "&quot;"); }
        if (c == 60) { sb_append(&sb, "&lt;"); }
        if (c == 62) { sb_append(&sb, "&gt;"); }
        if (c == 92) { }
        if (c != 34) { if (c != 60) { if (c != 62) { if (c != 92) {
                        sb_append(&sb, char_str(c));
                    } } } }
    }
    return sb_to_str(&sb);
}

def emit_fprintf(Gen &g, str literal) {
    StringBuilder sb = sb_new();
    sb_append(&sb, "fprintf(_out,\"");
    sb_append(&sb, literal);
    sb_append(&sb, "\");");
    cg_emit(&g, sb_to_str(&sb));
}

def gen_layout(Gen &g, Node decl) {
    StringBuilder head = sb_new();
    sb_append(&head, "\nvoid "); sb_append(&head, decl.s1);
    sb_append(&head, "_render(FILE* _out");
    // A view's inputs — a filter, an id. Strata has no module-level variables,
    // so a view that can only read globals is a view that cannot be reused.
    NodeVec lparams = nv_at(decl.v2);
    int nlp = lparams.len;
    for (int i = 0; i < nlp; i = i + 1) {
        Node prm = nv_get(&lparams, i);
        sb_append(&head, ", "); sb_append(&head, c_param(&g, prm));
        g.var_types = bind_cons(prm.s1, c_type(&g, prm.c1), g.var_types);
    }
    sb_append(&head, ") {");
    emit_raw(&g, sb_to_str(&head));
    g.indent = 1;
    emit_fprintf(&g, "<!doctype html><meta charset=\\\"utf-8\\\">");
    NodeVec body = nv_at(decl.v1);
    int n = body.len;
    g.in_layout = 1;
    for (int i = 0; i < n; i = i + 1) { gen_layout_node(&g, nv_get(&body, i)); }
    g.in_layout = 0;
    g.indent = 0;
    emit_raw(&g, "}");
}

def gen_layout_node(Gen &g, Node node) {
    if (node.kind == 71) { gen_element(&g, node); return; }
    if (node.kind == 73) { gen_for_in(&g, node); return; }
    gen_stmt(&g, node);
}

str style_attr(Gen &g, Node el) {
    str css = css_for(&g, el);
    if (str_len(css) == 0) { return ""; }
    StringBuilder sb = sb_new();
    sb_append(&sb, " style=\\\""); sb_append(&sb, css); sb_append(&sb, "\\\"");
    return sb_to_str(&sb);
}

// Attributes whose value is an expression rather than a literal. A row's own
// id has to reach the form that acts on it, and a literal cannot carry it.
// Emitted as their own fprintf because the value is only known at run time.
def emit_computed_attrs(Gen &g, Node el) {
    NodeVec props = nv_at(el.v1);
    int n = props.len;
    for (int i = 0; i < n; i = i + 1) {
        Node p = nv_get(&props, i);
        if (is_attr_prop(p.s1) == 1) {
            Node v = node_at(p.c1);
            int literal = 0;
            if (v.kind == 50) { literal = 1; }
            if (v.kind == 51) { literal = 1; }
            if (v.kind == 52) { literal = 1; }
            if (literal == 0) {
                StringBuilder sb = sb_new();
                sb_append(&sb, "fprintf(_out,\" ");
                sb_append(&sb, p.s1);
                sb_append(&sb, "=\\\"%s\\\"\",");
                sb_append(&sb, gen_expr(&g, p.c1));
                sb_append(&sb, ");");
                cg_emit(&g, sb_to_str(&sb));
            }
        }
    }
}

def gen_element(Gen &g, Node el) {
    str tag = html_tag(el.s1);
    str style = style_attr(&g, el);
    str attrs = attrs_for(&g, el);
    // `field "customer"` names the form field it submits; the label is the
    // name rather than text, because an input has no text content.
    if (str_eq(el.s1, "field") == 1) {
        if (el.c1 != 0) {
            Node lab = node_at(el.c1);
            if (lab.kind == 52) {
                if (str_index_of(attrs, " name=") < 0) {
                    StringBuilder nm = sb_new();
                    sb_append(&nm, " name=\\\""); sb_append(&nm, html_escape(lab.s1));
                    sb_append(&nm, "\\\""); sb_append(&nm, attrs);
                    attrs = sb_to_str(&nm);
                }
            }
        }
    }

    if (str_eq(el.s1, "window") == 1) {
        str win_title = "window";
        if (el.c1 != 0) {
            Node lab = node_at(el.c1);
            if (lab.kind == 52) { win_title = lab.s1; }
        }
        StringBuilder t = sb_new();
        sb_append(&t, "<title>"); sb_append(&t, html_escape(win_title)); sb_append(&t, "</title>");
        emit_fprintf(&g, sb_to_str(&t));
        StringBuilder b = sb_new();
        sb_append(&b, "<body"); sb_append(&b, attrs); sb_append(&b, style);
        sb_append(&b, ">");
        emit_fprintf(&g, sb_to_str(&b));
        NodeVec kids = nv_at(el.v2);
        int nk = kids.len;
        for (int i = 0; i < nk; i = i + 1) { gen_layout_node(&g, nv_get(&kids, i)); }
        emit_fprintf(&g, "</body>");
        return;
    }

    StringBuilder open = sb_new();
    sb_append(&open, "<"); sb_append(&open, tag); sb_append(&open, attrs);
    emit_fprintf(&g, sb_to_str(&open));
    emit_computed_attrs(&g, el);
    StringBuilder close_open = sb_new();
    sb_append(&close_open, style); sb_append(&close_open, ">");
    emit_fprintf(&g, sb_to_str(&close_open));
    // A void element has no closing tag and no children.
    if (is_void_tag(tag) == 1) { return; }

    if (el.c1 != 0) {
        if (str_eq(el.s1, "canvas") == 0) {
            Node lab = node_at(el.c1);
            if (lab.kind == 52) {
                StringBuilder s = sb_new();
                sb_append(&s, "fprintf(_out,\"%s\",\"");
                sb_append(&s, html_escape(lab.s1));
                sb_append(&s, "\");");
                cg_emit(&g, sb_to_str(&s));
            }
            if (lab.kind != 52) {
                if (lab.kind != 54) {
                    StringBuilder s = sb_new();
                    sb_append(&s, "fprintf(_out,\"%s\","); sb_append(&s, gen_expr(&g, el.c1));
                    sb_append(&s, ");");
                    cg_emit(&g, sb_to_str(&s));
                }
                // A bare identifier names the element — `canvas topology_view`
                // — unless it resolves to a value in scope, which is the same
                // rule the type checker applies. Without this a layout
                // parameter renders as nothing at all.
                if (lab.kind == 54) {
                    if (str_len(bind_get(g.var_types, lab.s1)) > 0) {
                        StringBuilder s2 = sb_new();
                        sb_append(&s2, "fprintf(_out,\"%s\","); sb_append(&s2, gen_expr(&g, el.c1));
                        sb_append(&s2, ");");
                        cg_emit(&g, sb_to_str(&s2));
                    }
                }
            }
        }
    }

    NodeVec kids = nv_at(el.v2);
    int nk = kids.len;
    for (int i = 0; i < nk; i = i + 1) { gen_layout_node(&g, nv_get(&kids, i)); }

    StringBuilder close = sb_new();
    sb_append(&close, "</"); sb_append(&close, tag); sb_append(&close, ">");
    emit_fprintf(&g, sb_to_str(&close));
}

def gen_for_in(Gen &g, Node node) {
    str coll = gen_expr(&g, node.c1);
    str ct = expr_ctype(&g, node.c1);
    str elem = "void*";
    if (ends_with_star(ct) == 1) { elem = str_slice(ct, 0, str_len(ct) - 1); }
    g.var_types = bind_cons(node.s1, elem, g.var_types);

    StringBuilder it = sb_new();
    sb_append(&it, "_it_"); sb_append(&it, cname(node.s1));
    str iter = sb_to_str(&it);

    // Iterated by length. This used to walk to the first NULL, which was
    // wrong for any list of scalars — 0 is a valid int — and became wrong for
    // query results too once lists started carrying a length header.
    cg_emit(&g, "{");
    g.indent = g.indent + 1;
    StringBuilder decl = sb_new();
    sb_append(&decl, elem); sb_append(&decl, "* "); sb_append(&decl, iter);
    sb_append(&decl, " = "); sb_append(&decl, coll); sb_append(&decl, ";");
    cg_emit(&g, sb_to_str(&decl));
    StringBuilder cnt = sb_new();
    sb_append(&cnt, "strata_int "); sb_append(&cnt, iter);
    sb_append(&cnt, "_n = strata_len("); sb_append(&cnt, iter); sb_append(&cnt, ");");
    cg_emit(&g, sb_to_str(&cnt));
    StringBuilder head = sb_new();
    sb_append(&head, "for (strata_int "); sb_append(&head, iter);
    sb_append(&head, "_i = 0; "); sb_append(&head, iter); sb_append(&head, "_i < ");
    sb_append(&head, iter); sb_append(&head, "_n; "); sb_append(&head, iter);
    sb_append(&head, "_i++) {");
    cg_emit(&g, sb_to_str(&head));
    g.indent = g.indent + 1;
    StringBuilder bind = sb_new();
    sb_append(&bind, elem); sb_append(&bind, " "); sb_append(&bind, cname(node.s1));
    sb_append(&bind, " = "); sb_append(&bind, iter); sb_append(&bind, "[");
    sb_append(&bind, iter); sb_append(&bind, "_i];");
    cg_emit(&g, sb_to_str(&bind));
    NodeVec body = nv_at(node.v1);
    int n = body.len;
    for (int i = 0; i < n; i = i + 1) {
        if (g.in_layout == 1) { gen_layout_node(&g, nv_get(&body, i)); }
        else { gen_stmt(&g, nv_get(&body, i)); }
    }
    g.indent = g.indent - 1;
    cg_emit(&g, "}");
    g.indent = g.indent - 1;
    cg_emit(&g, "}");
}
