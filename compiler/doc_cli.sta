// `strata doc` — an architecture document for a project.
//
// Takes the project root and the files to describe, and writes Markdown to
// stdout. The caller decides which files: the toolchain passes everything
// under src/, which is the project as the compiler sees it.

import io           from std;
import cli          from std;
import mem          from std;
import os           from std;
import str          from std;
import architecture from compiler;

int main() {
    str root = arg(1);
    if (str_len(root) == 0) {
        eprint_raw("usage: doc_cli <project-root> <file.sta>...\n");
        return 2;
    }

    StringBuilder out = sb_new();
    sb_append(&out, "# Architecture\n\n");
    sb_append(&out, "Generated by `strata doc` from the same parse the build uses.\n");
    sb_append(&out, "Do not edit: rerun it. A document written by hand drifts from\n");
    sb_append(&out, "the code and this one cannot, which is the only reason to trust it.\n\n");
    sb_append(&out, "Project root: `");
    sb_append(&out, root);
    sb_append(&out, "`\n");

    int described = 0;
    for (int i = 2; i < 64; i = i + 1) {
        str path = arg(i);
        if (str_len(path) == 0) { break; }
        sb_append(&out, describe_file(path, path));
        described = described + 1;
    }

    if (described == 0) {
        eprint_raw("doc: no files given\n");
        return 2;
    }

    sb_append(&out, "\n---\n\n");
    sb_append(&out, str(described));
    sb_append(&out, " file(s) described.\n\n");
    sb_append(&out, "**Writes** lists the tables a file inserts into, saves, deletes\n");
    sb_append(&out, "from, appends to, rewrites or drops, found by walking every\n");
    sb_append(&out, "statement and the expressions in returns and declarations. It is a\n");
    sb_append(&out, "thorough search rather than a proof: a write buried in some other\n");
    sb_append(&out, "expression position would not appear here. Reads are not listed at\n");
    sb_append(&out, "all — a query can appear anywhere an expression can, and a\n");
    sb_append(&out, "half-complete list of who reads what is worse than none.\n\n");
    sb_append(&out, "What this document does not say is why anything is the way it is.\n");
    sb_append(&out, "The compiler knows the shape of the system, not the reasons for\n");
    sb_append(&out, "it — those still come from a person.\n");
    print(sb_to_str(&out));
    return 0;
}
