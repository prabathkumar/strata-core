// The business rules, apart from HTTP.
//
// These were inside the request handlers, where the only way to exercise them
// was to start a server and post a form. A rule that can only be tested
// through a socket is a rule that is not tested, so the handlers in main.sta
// are now adapters — read the form, call a rule, choose a status code — and
// everything that decides anything lives here, where `strata test` runs it.

import io     from std;
import str    from std;
import schema from app;

int load_all() {
    load Order from "data/orders.tsv";
    load User from "data/users.tsv";
    load Session from "data/sessions.tsv";
    load Attempt from "data/attempts.tsv";
    return 1;
}

// These return whether the write actually happened. They used to return 1
// unconditionally, so a handler that could not write still told the customer
// the order was created.
int save_orders()   { return save Order to "data/orders.tsv"; }
int save_sessions() { return save Session to "data/sessions.tsv"; }

int next_id() {
    list[Order] all = Order <- [id > 0];
    if (count(all) == 0) { return 1; }
    return max(all.id) + 1;
}

// Creating an order. The rules do not persist: the caller decides when to
// write, which is what lets `strata test` exercise them without touching the
// service's data files.
//
// The return value is the outcome, not a page:
//   0  created
//   1  no customer
//   2  no amount
int create_order(str customer, str region, str amount) {
    if (str_len(customer) == 0) { return 1; }
    if (str_len(amount) == 0) { return 2; }
    str where = region;
    if (str_len(where) == 0) { where = "unknown"; }
    Order <- [id = next_id(), customer = customer, region = where,
    amount = str_to_float(amount), status = "OPEN"];
    return 0;
}

// Closing an order. 0 closed, 1 no such order.
int close_order(int want) {
    list[Order] found = Order <- [id == want];
    if (count(found) == 0) { return 1; }
    Order o = found[0];
    o.status = "CLOSED";
    return 0;
}

int open_count() {
    return count(Order <- [status == "OPEN"]);
}

// ── Guarding the sign-in ─────────────────────────────────────────────────────
//
// Nothing slowed a password guess down: the service answered as fast as it
// could, forever. A lockout is kept on the user row rather than in a table of
// attempts, because the language has no delete and a table of attempts would
// grow for as long as anyone was attacking it — which is the wrong way round.

const int LOCKOUT_AFTER   = 5;
const int LOCKOUT_SECONDS  = 300;

// Seconds remaining on a lockout, or 0.
//
// The lockout is against the pair of the account guessed at and the place the
// guessing came from — see `Attempt` in schema.sta for why neither alone
// works. A guesser locks only their own attempts, at that one account, from
// where they are sitting.
//
// The account columns `failed_logins` and `locked_until` are still on `User`
// and still written, because an operator asking "has anyone been trying my
// account" deserves an answer. They no longer refuse anybody.
int locked_for(str who, str from_where, int now) {
    list[Attempt] found = Attempt <- [username == who && source == from_where];
    if (count(found) == 0) { return 0; }
    Attempt a = found[0];
    if (a.locked_until > now) { return a.locked_until - now; }
    return 0;
}

int next_attempt_id() {
    list[Attempt] all = Attempt <- [id > 0];
    if (count(all) == 0) { return 1; }
    return max(all.id) + 1;
}

// Record a failed attempt against the pair, and against the account it aimed
// at. Returns the number of failures now standing against the pair.
int note_failure(str who, str from_where, int now) {
    list[User] found = User <- [username == who];
    if (count(found) > 0) {
        User u = found[0];
        u.failed_logins = u.failed_logins + 1;
        if (u.failed_logins >= LOCKOUT_AFTER) {
            u.locked_until = now + LOCKOUT_SECONDS;
        }
    }

    list[Attempt] seen = Attempt <- [username == who && source == from_where];
    if (count(seen) == 0) {
        Attempt <- [id = next_attempt_id(), source = from_where, username = who,
        failures = 1, locked_until = 0];
        return 1;
    }
    Attempt a = seen[0];
    a.failures = a.failures + 1;
    if (a.failures >= LOCKOUT_AFTER) {
        a.locked_until = now + LOCKOUT_SECONDS;
    }
    return a.failures;
}

// A success clears the account's count and the pair's, so one wrong password
// before the right one leaves nothing behind.
int clear_failures(str who, str from_where) {
    list[User] found = User <- [username == who];
    if (count(found) > 0) {
        User u = found[0];
        u.failed_logins = 0;
        u.locked_until = 0;
    }
    delete Attempt <- [username == who && source == from_where];
    return 1;
}

// Pairs quiet long enough are forgotten, so the table does not grow forever.
// A table that only grows is a service that fails in a month rather than in a
// minute, which is worse, because nobody is watching in a month.
int prune_attempts(int now) {
    // The bound is worked out first. Inside a query a bare name is a column,
    // so `[locked_until < now - LOCKOUT_SECONDS]` asked for a column called
    // `now`, and the compiler said so (E004). A plain variable reads as a
    // variable; an expression does not.
    int cutoff = now - LOCKOUT_SECONDS;
    return delete Attempt <- [locked_until > 0 && locked_until < cutoff];
}

int save_attempts() { return save Attempt to "data/attempts.tsv"; }

int save_users() { return save User to "data/users.tsv"; }

// The CSRF token this session's forms must carry, or "" when there is no
// session. A form without it is not from a page this service rendered.
str csrf_for(str want) {
    list[Session] found = Session <- [token == want];
    if (count(found) == 0) { return ""; }
    Session s = found[0];
    return s.csrf;
}
