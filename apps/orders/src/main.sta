// The Orders service.
//
// One binary: it owns its data, its business rules, its HTTP surface and the
// pages it serves. There is no separate front end, no JSON contract between
// tiers, and no second language — a column renamed in schema.sta breaks this
// file, views.sta and the build, before anything runs.

import io     from std;
import str    from std;
import mem    from std;
import http   from std;
import auth   from std;
import metrics from std;
import schema from app;
import rules  from app;
import views  from app;

// Storage and the business rules are in rules.sta, where `strata test` can
// reach them without a socket.

// The demo operator. A real deployment would not seed a password from source;
// this one prints what it did so nobody mistakes it for a secret.
int seed_if_empty() {
    if (count(User <- [id > 0]) == 0) {
        User <- [id = 1, username = "manager",
        password_hash = hash_password("strata"), failed_logins = 0, locked_until = 0];
        save User to "data/users.tsv";
        print("seeded user 'manager' with password 'strata' — demo only");
    }
    if (count(Order <- [id > 0]) == 0) {
        Order <- [id = 1, customer = "acme",    region = "apac", amount = 1250.00, status = "OPEN"];
        Order <- [id = 2, customer = "globex",  region = "emea", amount =  340.50, status = "OPEN"];
        Order <- [id = 3, customer = "initech", region = "amer", amount =  980.75, status = "CLOSED"];
        save_orders();
    }
    return 1;
}

// ── Sessions ─────────────────────────────────────────────────────────────────

int now_seconds() { native "return (int64_t)time(NULL);"; }

// How many connections may be in flight at once. A process each, so this is
// also the cap on processes this service will create.
const int MAX_CONNECTIONS = 64;

// How long a signed-in session lasts, and how long the service waits for a
// client to finish sending its request.
const int SESSION_SECONDS = 28800;
const int REQUEST_TIMEOUT = 5;

// The signed-in user's id, or 0. A session that has expired is not a session.
int current_user(str request) {
    str want = http_cookie(request, "sid");
    if (str_len(want) == 0) { return 0; }
    // Named `want`, not `token`: inside a query a bare name is the COLUMN, so
    // `token == token` compares the column with itself and matches every row.
    // That is E008 now rather than an auth bypass.
    list[Session] found = Session <- [token == want];
    if (count(found) == 0) { return 0; }
    Session s = found[0];
    if (s.expires_at < now_seconds()) { return 0; }
    return s.user_id;
}

str start_session(int user_id) {
    prune_sessions();
    str token = new_session_token();
    // A second random token, never sent as a cookie. A form carries it, so a
    // request that did not come from a page this service rendered cannot
    // produce it — which is the whole of CSRF protection.
    Session <- [token = token, user_id = user_id,
    expires_at = now_seconds() + SESSION_SECONDS, csrf = new_session_token()];
    save_sessions();
    return token;
}

// Signing out removes the row. It used to set `expires_at` to 0 and leave it,
// because the language had no delete: every sign-out grew the table by one row
// that would never be read again, forever.
int end_session(str want) {
    delete Session <- [token == want];
    save_sessions();
    return 1;
}

// Sessions that have run out are removed on every write. Nothing else prunes
// them, and a table that only grows is a service that fails in a month rather
// than in a minute — which is worse, because nobody is watching in a month.
int prune_sessions() {
    delete Session <- [expires_at < now_seconds()];
    return 1;
}

str cookie_header(str token) {
    StringBuilder sb = sb_new();
    sb_append(&sb, "Set-Cookie: sid=");
    sb_append(&sb, token);
    sb_append(&sb, "; Path=/; HttpOnly; SameSite=Lax\r\n");
    return sb_to_str(&sb);
}

// ── Handlers ─────────────────────────────────────────────────────────────────

int do_login(int conn, str body) {
    str want_user = http_form_value(body, "username");
    str password = http_form_value(body, "password");
    int now = now_seconds();

    // The lockout is checked before the password, and answers the same way for
    // a locked account whatever was typed — otherwise the lockout itself tells
    // an attacker which usernames are real.
    if (locked_for(want_user, now) > 0) {
        return http_respond(conn, 429, "text/html; charset=utf-8",
        render LoginLocked);
    }

    list[User] found = User <- [username == want_user];
    if (count(found) == 0) { return http_ok(conn, render LoginFailed); }
    User u = found[0];
    if (password_matches(password, u.password_hash) == 0) {
        note_failure(want_user, now);
        save_users();
        return http_ok(conn, render LoginFailed);
    }
    clear_failures(want_user);
    save_users();
    return http_redirect_with(conn, "/", cookie_header(start_session(u.id)));
}

int do_logout(int conn, str request) {
    end_session(http_cookie(request, "sid"));
    return http_redirect_with(conn, "/login",
    "Set-Cookie: sid=; Path=/; Max-Age=0\r\n");
}

// The handlers are adapters: read the form, call a rule, choose a status
// code. The rule decides; this file only says what that means over HTTP.
int do_create(int conn, str body) {
    int outcome = create_order(http_form_value(body, "customer"),
    http_form_value(body, "region"),
    http_form_value(body, "amount"));
    if (outcome == 1) {
        return http_bad_request(conn, "<h1>400</h1><p>customer is required</p>");
    }
    if (outcome == 2) {
        return http_bad_request(conn, "<h1>400</h1><p>amount is required</p>");
    }
    // A write that did not happen is not a created order. Telling the
    // customer otherwise is the worst thing this service could do, and until
    // `save` had a value it was the only thing it could do.
    if (save_orders() == 0) {
        return http_respond(conn, 503, "text/html; charset=utf-8",
        "<h1>503</h1><p>the order could not be stored and was not created</p>");
    }
    return http_redirect(conn, "/?notice=created");
}

int do_close(int conn, str body) {
    int want = str_to_int(http_form_value(body, "id"));
    if (want == 0) { return http_bad_request(conn, "<h1>400</h1><p>id is required</p>"); }
    if (close_order(want) == 1) { return http_not_found(conn); }
    if (save_orders() == 0) {
        return http_respond(conn, 503, "text/html; charset=utf-8",
        "<h1>503</h1><p>the change could not be stored and was not made</p>");
    }
    return http_redirect(conn, "/?notice=closed");
}

str summary_page() {
    list[Order] open_orders = Order <- [status == "OPEN"];
    StringBuilder sb = sb_new();
    sb_append(&sb, "<!doctype html><meta charset=\"utf-8\"><title>Orders API</title>");
    sb_append(&sb, "<pre>open orders: ");
    sb_append(&sb, str(count(open_orders)));
    sb_append(&sb, "\nopen value:  ");
    sb_append(&sb, str(sum(open_orders.amount)));
    sb_append(&sb, "\nlargest:     ");
    sb_append(&sb, str(max(open_orders.amount)));
    sb_append(&sb, "</pre>");
    return sb_to_str(&sb);
}

// ── Routing ──────────────────────────────────────────────────────────────────

int handle(int conn, str request) {
    str method = http_method(request);
    str path   = http_path(request);
    str body   = http_body(request);
    int user   = current_user(request);

    // Open to everyone.
    // Two pages the service answers about itself. Neither needs a session:
    // whatever is watching this service is not a person with a password, and
    // a health check that can fail because a cookie expired is a health check
    // that lies. Neither reads the business tables either, so they keep
    // answering when the data is what is broken — which is when they matter.
    if (str_eq(path, "/health") == 1) {
        int hp = metrics_open();
        StringBuilder hb = sb_new();
        sb_append(&hb, "ok\nuptime_seconds ");
        sb_append(&hb, str(metrics_uptime_seconds(hp)));
        sb_append(&hb, "\nrequests ");
        sb_append(&hb, str(metrics_get(hp, M_TOTAL)));
        sb_append(&hb, "\n");
        return http_respond(conn, 200, "text/plain", sb_to_str(&hb));
    }
    if (str_eq(path, "/metrics") == 1) {
        return http_respond(conn, 200, "text/plain", metrics_render(metrics_open()));
    }
    if (str_eq(path, "/login") == 1) {
        if (str_eq(method, "POST") == 1) { return do_login(conn, body); }
        return http_ok(conn, render LoginPage);
    }

    // Everything below needs a session.
    if (user == 0) {
        if (str_eq(method, "GET") == 1) { return http_redirect(conn, "/login"); }
        return http_forbidden(conn);
    }

    // Every write carries the session's CSRF token. A signed-in operator's
    // browser can be made to post to this service by any page on the web; what
    // that page cannot do is read this token out of a page it is not allowed
    // to see.
    str sid = http_cookie(request, "sid");
    if (str_eq(method, "POST") == 1) {
        if (str_eq(http_form_value(body, "_csrf"), csrf_for(sid)) == 0) {
            return http_respond(conn, 403, "text/html; charset=utf-8",
            "<h1>403</h1><p>this form did not come from here</p>");
        }
    }

    if (str_eq(path, "/logout") == 1)  { return do_logout(conn, request); }
    if (str_eq(path, "/orders") == 1)  { return do_create(conn, body); }
    if (str_eq(path, "/close") == 1)   { return do_close(conn, body); }
    if (str_eq(path, "/summary") == 1) { return http_ok(conn, summary_page()); }
    if (str_eq(path, "/") == 1) {
        str region = http_form_value(http_query_string(request), "region");
        str notice = http_form_value(http_query_string(request), "notice");
        return http_ok(conn, render Dashboard(region, notice, csrf_for(sid)));
    }
    return http_not_found(conn);
}

// One connection, served in a child process.
//
// The order of the three steps is the whole design. The request is read
// before the lock is taken, so a slow client delays nobody but itself. The
// tables are loaded inside the lock, because a child forked ten minutes ago
// inherited a copy of them that is now wrong. The lock is held until the
// handler has saved, because two children that each read, change and write a
// whole table would otherwise lose one of the two changes.
int serve(int conn) {
    int started = now_millis();
    http_set_timeout(conn, REQUEST_TIMEOUT);
    str request = http_read_request(conn);
    if (str_len(request) == 0) {
        int code = http_request_timeout(conn);
        int took = now_millis() - started;
        log_request("-", "-", code, took);
        metrics_record(metrics_open(), code, took);
        http_close(conn);
        return 1;
    }
    // A GET takes a shared lock, so pages are served in parallel; anything
    // that can write takes the exclusive one. Taking the exclusive lock for
    // everything was correct and serialised every read behind every other
    // read, which showed up as concurrent throughput below sequential.
    int lock = -1;
    if (str_eq(http_method(request), "GET") == 1) {
        lock = lock_shared("data/.lock");
    } else {
        lock = lock_exclusive("data/.lock");
    }
    load_all();
    int status = handle(conn, request);
    unlock(lock);
    // Logged after the work, with what the handler actually returned. A log
    // line written before the handler runs is a log of intentions.
    int took = now_millis() - started;
    log_request(http_method(request), http_path(request), status, took);
    // The counters live in a page mapped before the first fork, so this child
    // is adding to the same numbers the parent will serve on /metrics. A
    // counter in an ordinary variable would leave with this process.
    metrics_record(metrics_open(), status, took);
    // A request that failed says so in its own line, with enough to find it
    // again. The one-line-per-request log above is for watching; this is for
    // the morning after, when somebody has a timestamp and a complaint.
    if (status >= 400) {
        log_failure(http_method(request), http_path(request), status, took);
    }
    http_close(conn);
    return 1;
}

int main() {
    load_all();
    seed_if_empty();

    // Before the first fork, so every child inherits the same shared page.
    // Started here rather than lazily: a counter created on first use has no
    // start time, and uptime is the first thing anyone asks.
    metrics_start();

    int fd = http_listen(8080);
    if (fd < 0) { eprint("could not bind port 8080"); return 1; }

    // A client that walks away mid-response used to take the service with it.
    http_ignore_broken_pipes();

    print("orders service listening on http://127.0.0.1:8080");

    // Children are counted rather than handed to SIG_IGN, because a service
    // that does not know how many it has cannot refuse the next one. Nothing
    // used to stop a client opening connections faster than they could be
    // served, until the machine ran out of processes.
    // A one-second receive timeout on the listening socket so accept() gives
    // up regularly. Without it the loop sits in accept() while finished
    // children stay defunct: reaping only when the next connection arrives
    // leaves zombies for as long as the service is idle, which is exactly when
    // nobody is watching. This costs one wakeup a second.
    http_set_timeout(fd, 1);

    int live = 0;
    while (1 == 1) {
        live = live - http_reap_finished();
        if (live < 0) { live = 0; }
        int conn = http_accept(fd);
        if (conn < 0) { continue; }
        if (live >= MAX_CONNECTIONS) {
            http_too_busy(conn);
            log_request("-", "-", 503, 0);
            // Counted apart from the 5xx: this is a connection the service
            // never started, not a request it got wrong. Reading them as the
            // same number hides running out of capacity behind what looks
            // like a bug in a handler.
            metrics_refused(metrics_open());
            http_close(conn);
            continue;
        }
        int pid = http_fork();
        if (pid == 0) {
            http_close(fd);
            serve(conn);
            http_exit(0);
        }
        if (pid > 0) { live = live + 1; }
        // The parent keeps no reference to a connection it is not serving; a
        // socket left open here is a connection the client never sees closed.
        http_close(conn);
        if (pid < 0) { serve(conn); }
    }
    return 0;
}
