// THE HOST BRIDGE — apps/orders_mobile/src/host.sta
//
// Four functions, and nothing else crosses the line between Strata and the
// phone. The shell asks for a display list, paints it, reports where a finger
// went, and tells Strata what that meant. It never learns what an order is.
//
// These are plain C functions once compiled, which is the whole reason the
// iOS side is small: Swift calls C directly, with no bridge layer to write
// and no signatures to guess. The Android side needs JNI wrappers around
// these same four.

import io     from std;
import mem    from std;
import str    from std;
import ui     from std;
import screen from app;

// Rebuild the display list. Returns how many items it holds.
int host_draw() {
    draw_screen();
    list[UIItem] all = UIItem <- [id > 0];
    return count(all);
}

// One item, as "kind|x|y|w|h|colour|scale|text|action".
//
// A packed string rather than a struct because it crosses a language boundary
// and every host can split a string. The fields are in the order the Android
// shell already reads, so both shells parse the same line.
str host_item(int index) {
    int wanted = index + 1;
    list[UIItem] rows = UIItem <- [id == wanted];
    str out = "";
    for r in rows {
        StringBuilder sb = sb_new();
        sb_append(&sb, str(r.kind));
        sb_append(&sb, "|");
        sb_append(&sb, str(r.x));
        sb_append(&sb, "|");
        sb_append(&sb, str(r.y));
        sb_append(&sb, "|");
        sb_append(&sb, str(r.w));
        sb_append(&sb, "|");
        sb_append(&sb, str(r.h));
        sb_append(&sb, "|");
        sb_append(&sb, str(r.colour));
        sb_append(&sb, "|");
        sb_append(&sb, str(r.scale));
        sb_append(&sb, "|");
        sb_append(&sb, r.text);
        sb_append(&sb, "|");
        sb_append(&sb, r.action);
        out = sb_to_str(&sb);
    }
    return out;
}

// What a tap at this point means, or "" for nothing.
str host_hit(int x, int y) { return ui_hit(x, y); }

// Tell Strata a tap happened; it decides what changes.
int host_act(str action) { return on_action(action); }

// The shell calls this once before anything else, so a screen has something
// to show on a phone that has never run it. Calling it twice is safe: if the
// table already holds orders, it leaves them alone. A phone shell gets
// restarted for reasons that have nothing to do with the app, and a seed that
// duplicated every row on each restart would look like a data bug.
int host_start() {
    if (count(Order <- [id > 0]) == 0) {
        Order <- [id = 1, customer = "Acme Bhd",      region = "apac", amount = 1250.50, status = "OPEN"];
        Order <- [id = 2, customer = "Globex",        region = "emea", amount =  340.00, status = "OPEN"];
        Order <- [id = 3, customer = "Initech",       region = "amer", amount =  980.75, status = "CLOSED"];
        Order <- [id = 4, customer = "Kestrel Ltd",   region = "apac", amount = 4820.00, status = "OPEN"];
        Order <- [id = 5, customer = "Umbrella Corp", region = "emea", amount =   75.25, status = "OPEN"];
        Order <- [id = 6, customer = "Soylent",       region = "amer", amount = 2010.00, status = "CLOSED"];
        Order <- [id = 7, customer = "Stark Ind",     region = "apac", amount = 9999.99, status = "OPEN"];
        Order <- [id = 8, customer = "Wayne Ent",     region = "amer", amount =  620.40, status = "OPEN"];
        Order <- [id = 9, customer = "Tyrell",        region = "emea", amount = 1500.00, status = "OPEN"];
    }
    return host_draw();
}
