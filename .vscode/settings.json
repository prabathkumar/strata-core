{
  "files.associations": {
    "*.sta": "strata"
  },
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.formatOnSave": true,
  "editor.suggestSelection": "first",
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": false
  },
  "strata.lsp.serverPath": "./bin/strata-lsp",
  "strata.formatter.command": "./bin/strata format",
  "strata.compiler.haltOnFirstError": true
}
