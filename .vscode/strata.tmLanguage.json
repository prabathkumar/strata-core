{
  "$schema": "https://githubusercontent.com",
  "name": "Strata",
  "scopeName": "source.sta",
  "patterns": [
    {
      "name": "keyword.control.strata",
      "match": "\\b(database|stream|protocol|model|predict|report|render|layout|verify|import|from|return|if|else)\\b"
    },
    {
      "name": "storage.type.strata",
      "match": "\\b(int|float|str|void|tensor|list)\\b"
    },
    {
      "name": "keyword.operator.query.strata",
      "match": "<-|::|&"
    },
    {
      "name": "comment.line.double-slash.strata",
      "match": "//.*$"
    }
  ]
}
