# Generated C output from the compiler. The runtime prelude below is SOURCE,
# not output, and must stay tracked — every build reads it.
__pycache__/
*.pyc
*.o
build/
*.c
# Every runtime prelude, not just the native one. Naming a single file
# here let the wasm prelude be silently excluded the moment it was added.
!compiler/runtime_preamble*.c

# The lock file the service creates to serialise writes.
apps/orders/data/.lock

# Scratch the sandbox will not let me unlink; safe to delete by hand.
_to_delete/
*.tar

# Scratch for the check-in script.
COMMIT_MSG.txt

# A nested clone lived here; git re-adds it as a submodule on every `add -A`.
strata-core/

apps/orders_mobile/build/
apps/orders_mobile/data/
apps/orders_mobile/screen.bmp
apps/orders_mobile/src/*.c

# a folder the desktop bridge creates; not part of the project
Claude outputs/
