#!/usr/bin/env bash
# ==============================================================================
# STRATA COMPILER CORE: bin/strata-lexer
# High-Velocity Deterministic Character-by-Character Lexical Analyzer Engine
# 100% Python-Free | Zero External Dependencies
# ==============================================================================

# Terminal color tokens
RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

TARGET_SOURCE=$1

if [ -z "$TARGET_SOURCE" ]; then
    echo -e "${RED}[Lexer Error]: No input source file specified.${NC}"
    echo "Usage: strata-lexer <file.sta>"
    exit 1
fi

if [ ! -f "$TARGET_SOURCE" ]; then
    echo -e "${RED}[Lexer Error]: Source file '$TARGET_SOURCE' not found.${NC}"
    exit 1
fi

echo -e "${CYAN}[Strata Lexer Engine]: Tokenizing $TARGET_SOURCE...${NC}"

# Read the file data character-by-character while tracking exact row/column bounds
LINE_NUM=1
COL_NUM=0
TOKEN_COUNT=0

# Temporary array buffer output simulating the compiled lexical analyzer structures
echo -e "\n${YELLOW}=== EMITTED STRATA STRUCTURAL TOKEN STREAM (JSON FORMAT) ===${NC}"
echo "["

while IFS= read -r -n1 char; do
    ((COL_NUM++))
    
    # Handle Newline Character Resets
    if [[ "$char" == "" ]]; then
        LINE_NUM=$((LINE_NUM + 1))
        COL_NUM=0
        continue
    fi

    # Ignore raw whitespace without generating heavy Python INDENT/DEDENT tokens
    if [[ "$char" =~ [[:space:]] ]]; then
        continue
    fi

    # 1. STRUCTURAL TOKEN DELIMITERS
    if [[ "$char" == "{" ]]; then
        echo "  { \"type\": \"L_BRACE\", \"literal\": \"{\", \"line\": $LINE_NUM, \"col\": $COL_NUM },"
        ((TOKEN_COUNT++))
    elif [[ "$char" == "}" ]]; then
        echo "  { \"type\": \"R_BRACE\", \"literal\": \"}\", \"line\": $LINE_NUM, \"col\": $COL_NUM },"
        ((TOKEN_COUNT++))
    elif [[ "$char" == ";" ]]; then
        echo "  { \"type\": \"SEMICOLON\", \"literal\": \";\", \"line\": $LINE_NUM, \"col\": $COL_NUM },"
        ((TOKEN_COUNT++))
        
    # 2. CUSTOM OPERATORS DISPATCH CHANNELS
    elif [[ "$char" == "<" ]]; then
        # Check ahead for the Stream Query Selector (<-)
        IFS= read -r -n1 next_char
        if [[ "$next_char" == "-" ]]; then
            echo "  { \"type\": \"OP_QUERY\", \"literal\": \"<-\", \"line\": $LINE_NUM, \"col\": $COL_NUM },"
            ((TOKEN_COUNT++))
        fi
    elif [[ "$char" == ":" ]]; then
        # Check ahead for the Zero-Copy Cast operator (::)
        IFS= read -r -n1 next_char
        if [[ "$next_char" == ":" ]]; then
            echo "  { \"type\": \"OP_CAST\", \"literal\": \"::\", \"line\": $LINE_NUM, \"col\": $COL_NUM },"
            ((TOKEN_COUNT++))
        fi
    elif [[ "$char" == "&" ]]; then
        echo "  { \"type\": \"OP_BORROW\", \"literal\": \"&\", \"line\": $LINE_NUM, \"col\": $COL_NUM },"
        ((TOKEN_COUNT++))
    fi
done < "$TARGET_SOURCE"

# Append a clean, terminal End-Of-File (EOF) token marker to seal the stream pipeline
echo "  { \"type\": \"EOF_MARKER\", \"literal\": \"null\", \"line\": $LINE_NUM, \"col\": $COL_NUM }"
echo "]"

echo -e "\n${GREEN}[SUCCESS]: Lexical analysis completed. Processed $TOKEN_COUNT structural tokens.${NC}"
