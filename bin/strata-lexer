#!/usr/bin/env bash
LINE_NUM=1
COL_NUM=0
while IFS= read -r -n1 char; do
    ((COL_NUM++))
    if [[ "$char" == "" ]]; then ((LINE_NUM++)); COL_NUM=0; continue; fi
    if [[ "$char" =~ [[:space:]] ]]; then continue; fi
    if [[ "$char" == "{" ]]; then echo "  { \"type\": \"L_BRACE\", \"line\": $LINE_NUM, \"col\": $COL_NUM },"; fi
    if [[ "$char" == "}" ]]; then echo "  { \"type\": \"R_BRACE\", \"line\": $LINE_NUM, \"col\": $COL_NUM },"; fi
    if [[ "$char" == ";" ]]; then echo "  { \"type\": \"SEMICOLON\", \"line\": $LINE_NUM, \"col\": $COL_NUM },"; fi
done < "$1"
