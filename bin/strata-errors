#!/usr/bin/env bash
# ==============================================================================
# STRATA COMPILER CORE: bin/strata-errors
# High-Fidelity Machine-Parseable Diagnostic & Error Isolation Engine
# 100% Python-Free | Zero External Dependencies
# ==============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

ERROR_ID=$1
FILE_NAME=$2
LINE_NUM=$3
COL_NUM=$4
CONTEXT_STRING=$5

if [ -z "$ERROR_ID" ] || [ -z "$FILE_NAME" ]; then
    echo "Usage: strata-errors <ERROR_ID> <file.sta> <line> <col> <context>"
    exit 1
fi

echo -e "${RED}!!! [STRATA COMPILER CRITICAL HALT] !!!${NC}"
echo -e "┌─ ${YELLOW}FILE IDENTIFIER :${NC} $FILE_NAME"
echo -e "├─ ${YELLOW}POSITION MATRIX :${NC} Line $LINE_NUM | Column $COL_NUM"
echo -e "├─ ${YELLOW}CODE CONTEXT    :${NC} ${CYAN}$CONTEXT_STRING${NC}"
echo -e "└─ ${RED}ERROR MATRIX ID :${NC} $ERROR_ID"

echo -e "\n${YELLOW}=== MACHINE-PARSEABLE DIAGNOSTIC DIAGNOSIS ===${NC}"
case $ERROR_ID in
    "E001")
        echo -e " -> ${RED}[Violation]:${NC} Variable Mutation Mismatch."
        echo -e " -> ${GREEN}[Fix Matrix]:${NC} Ensure the value right of the '=' operator matches the leading type prefix."
        ;;
    "E004")
        echo -e " -> ${RED}[Violation]:${NC} Database Schema Selector Mismatch."
        echo -e " -> ${GREEN}[Fix Matrix]:${NC} Target filter field missing from schema declaration. Verify column token spellings."
        ;;
    "E006")
        echo -e " -> ${RED}[Violation]:${NC} Tensor Dimension Space Drift."
        echo -e " -> ${GREEN}[Fix Matrix]:${NC} Input matrix multiplier shape mismatches model contract bounds. Re-align parallel lanes."
        ;;
    *)
        echo -e " -> [Violation]: General compilation constraint breach."
        echo -e " -> [Fix Matrix]: Consult formal LANGUAGE_SPECIFICATION.md protocols."
        ;;
esac
echo -e "----------------------------------------------------------------------"
echo -e "${RED}==> STATE INVARIANT VIOLATION TRAPPED. GENERATION ENVELOPE ABORTED.${NC}"
exit 1
