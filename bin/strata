#!/usr/bin/env bash
# ==============================================================================
# STRATA DEVELOPER SDK: bin/strata
# Unified Command-Line Interface Toolchain Master Driver (Semantic Check Added)
# ==============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

COMMAND=$1
PARAM1=$2
PARAM2=$3

case $COMMAND in
    "version")
        echo -e "${CYAN}Strata Engine v1.0.0 (Native Semantic Validator Suite Active)${NC}"
        ;;
    "lex")
        ./bin/strata-lexer "$PARAM1"
        ;;
    "parse")
        ./bin/strata-parser "$PARAM1"
        ;;
    "check")
        if [ -z "$PARAM1" ]; then
            echo -e "${RED}[Error]: Please specify a .sta source file to semantically check.${NC}"
            exit 1
        fi
        ./bin/strata-checker "$PARAM1"
        ;;
    "codegen")
        ./bin/strata-codegen "$PARAM1" "$PARAM2"
        ;;
    "test")
        ./bin/strata-test
        ;;
    "build")
        ./bin/strata-deploy
        ;;
    "bench")
        ./bin/strata-bench
        ;;
    "demo")
        ./bin/strata demo
        ;;
    *)
        echo "Strata Enterprise Toolchain (SDK v1.0.0)"
        echo "Usage: strata <lex|parse|check|codegen|test|build|bench|demo|version> [arguments]"
        ;;
esac
