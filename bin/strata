#!/usr/bin/env bash
# STRATA Master CLI v1.0.0
set -e
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(dirname "$SCRIPT_DIR")"
export PYTHONPATH="$ROOT:$PYTHONPATH"

usage() {
    echo "Strata Compiler Toolchain v1.0.0"
    echo "  strata build <file.sta> [-o output] [--target native|wasm] [-v]"
    echo "  strata check <file.sta>"
    echo "  strata lex   <file.sta> [--json|--count]"
    echo "  strata ast   <file.sta>"
    echo "  strata run   <file.sta>"
    echo "  strata new   <project_name>"
    echo "  strata test  [dir]"
    echo "  strata version"
}

typecheck() {
    local f="$1"
    python3 - "$f" << 'PYEOF'
import sys
sys.path.insert(0, sys.argv[1].split('/')[0] if '/' not in sys.argv[1] else '.')
import os
ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__))) if '__file__' in dir() else '.'
sys.path.insert(0, os.environ.get('PYTHONPATH','').split(':')[0] or '.')
from compiler.lexer import tokenise_file, LexError
from compiler.parser import Parser, ParseError
from compiler.typechecker import TypeChecker
f = sys.argv[1]
try:
    toks = tokenise_file(f)
    ast  = Parser(toks).parse()
    tc   = TypeChecker(ast, filename=f)
    errs = tc.check()
    if errs:
        for e in errs: print(str(e), file=sys.stderr)
        sys.exit(1)
    print(f"  {len(ast.imports)} imports, {len(ast.declarations)} decls, {len(ast.functions)} functions")
except (LexError, ParseError) as e:
    print(str(e), file=sys.stderr); sys.exit(1)
PYEOF
}

cmd_build() {
    local file="$1"
    if [ -z "$file" ]; then echo "Usage: strata build <file.sta>"; exit 1; fi
    echo "[Strata] Type checking '$file'..."
    python3 << PYEOF
import sys, os
sys.path.insert(0, '$ROOT')
from compiler.lexer import tokenise_file, LexError
from compiler.parser import Parser, ParseError
from compiler.typechecker import TypeChecker
try:
    toks = tokenise_file('$file')
    ast  = Parser(toks).parse()
    tc   = TypeChecker(ast, filename='$file')
    errs = tc.check()
    if errs:
        for e in errs: print(str(e), file=sys.stderr)
        sys.exit(1)
    print(f"  TypeCheck OK — {len(ast.declarations)} decls, {len(ast.functions)} functions")
except (LexError, ParseError) as e:
    print(str(e), file=sys.stderr); sys.exit(1)
PYEOF
    python3 "$ROOT/bootstrap/stage0.py" "$@"
}

cmd_check() {
    local f="$1"
    if [ -z "$f" ]; then echo "Usage: strata check <file.sta>"; exit 1; fi
    echo "[Strata Check] Analysing '$f'..."
    python3 << PYEOF
import sys, os
sys.path.insert(0, '$ROOT')
from compiler.lexer import tokenise_file, LexError
from compiler.parser import Parser, ParseError
from compiler.typechecker import TypeChecker
try:
    toks = tokenise_file('$f')
    ast  = Parser(toks).parse()
    tc   = TypeChecker(ast, filename='$f')
    errs = tc.check()
    if errs:
        print(f"[Strata Check] {len(errs)} error(s) found:", file=sys.stderr)
        for e in errs: print(f"  {e}", file=sys.stderr)
        sys.exit(1)
    print(f"  {len(ast.imports)} imports, {len(ast.declarations)} decls, {len(ast.functions)} functions")
    print("[Strata Check] No errors. OK")
except (LexError, ParseError) as e:
    print(str(e), file=sys.stderr); sys.exit(1)
PYEOF
}

cmd_lex() { python3 "$ROOT/compiler/lexer.py" "$@"; }

cmd_ast() {
    local f="$1"
    python3 << PYEOF
import sys, json
sys.path.insert(0, '$ROOT')
from compiler.lexer import tokenise_file
from compiler.parser import Parser
toks = tokenise_file('$f')
ast  = Parser(toks).parse()
print(json.dumps(ast.to_dict(), indent=2))
PYEOF
}

cmd_run() {
    local f="$1"
    if [ -z "$f" ]; then echo "Usage: strata run <file.sta>"; exit 1; fi
    local tmp; tmp="$(mktemp /tmp/strata_XXXXXX)"
    python3 "$ROOT/bootstrap/stage0.py" "$f" -o "$tmp"
    "$tmp"
    rm -f "$tmp"
}

cmd_new() {
    local name="$1"
    if [ -z "$name" ]; then echo "Usage: strata new <project_name>"; exit 1; fi
    mkdir -p "$name/src" "$name/test_suite"
    cat > "$name/Strata.toml" << TOML
[package]
name = "$name"
version = "0.1.0"
edition = "2026"
[compiler]
target = "native"
opt_level = "aggressive"
halt_on_error = true
TOML
    cat > "$name/src/main.sta" << STA
import io from std;
int main() {
    print("Hello from $name!");
    return 0;
}
STA
    echo "[Strata] Project '$name' created."
}

cmd_test() {
    # Builds and runs the verify blocks in each file. Previously this only
    # type-checked, so a file with a failing assertion reported PASS.
    local dir="${1:-test_suite}"
    echo "[Strata Test] $dir"
    local p=0 f=0 skipped=0
    local tmp; tmp="$(mktemp -d)"
    for sta in "$dir"/*.sta; do
        [ -f "$sta" ] || continue
        if ! grep -q '^verify ' "$sta"; then
            skipped=$((skipped+1)); continue
        fi
        local bin="$tmp/$(basename "$sta" .sta)"
        if ! python3 "$ROOT/bootstrap/stage0.py" "$sta" --test -o "$bin" >/dev/null 2>&1; then
            echo "  BUILD FAIL: $sta"; f=$((f+1)); continue
        fi
        if "$bin"; then
            echo "  PASS: $sta"; p=$((p+1))
        else
            echo "  FAIL: $sta"; f=$((f+1))
        fi
    done
    rm -rf "$tmp"
    echo "[Strata Test] $p passed, $f failed, $skipped file(s) with no verify blocks."
    [ "$f" -eq 0 ] || exit 1
}

cmd_version() {
    echo "Strata v0.4.0-alpha | self-hosting front end"
    echo "  Stage 0: Python bootstrap (bootstrap/stage0.py)"
    echo "  Stage 1: compiler/{lexer,parser,typechecker,codegen}.sta (Strata)"
    echo "  Targets: native, wasm, c"
}

CMD="${1:-}"; shift 2>/dev/null || true
case "$CMD" in
    build)   cmd_build "$@" ;;
    check)   cmd_check "$@" ;;
    lex)     cmd_lex   "$@" ;;
    ast)     cmd_ast   "$@" ;;
    run)     cmd_run   "$@" ;;
    new)     cmd_new   "$@" ;;
    test)    cmd_test  "$@" ;;
    version) cmd_version ;;
    ""|help) usage ;;
    *) echo "Unknown: $CMD"; usage; exit 1 ;;
esac
