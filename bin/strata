#!/usr/bin/env bash
# ==============================================================================
# STRATA DEVELOPER SDK: bin/strata
# Unified Command-Line Interface Toolchain Master Driver (Full Architecture Active)
# ==============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

COMMAND=$1
PARAM1=$2
PARAM2=$3

case $COMMAND in
    "version") echo -e "${CYAN}Strata SDK Suite v1.0.0 (Full Systems Architecture Active)${NC}" ;;
    "lex")     ./bin/strata-lexer "$PARAM1" ;;
    "parse")   ./bin/strata-parser "$PARAM1" ;;
    "check")   ./bin/strata-checker "$PARAM1" ;;
    "codegen") ./bin/strata-codegen "$PARAM1" "$PARAM2" ;;
    "build")   ./bin/strata-compiler "$PARAM1" "$PARAM2" ;;
    "test")    ./bin/strata-test ;;
    "bench")   ./bin/strata-bench ;;
    "deploy")  ./bin/strata-deploy ;;
    "publish") ./bin/strata-sync ;;
    "debug")
        if [ -z "$PARAM1" ]; then
            echo -e "${RED}[Error]: Please specify a target .sta file to attach debugger to.${NC}"
            echo "Usage: strata debug <file.sta>"
            exit 1
        fi
        # Direct structural pipeline routing to the native debugger utility
        ./bin/strata-debug attach "$PARAM1"
        ;;
    *)
        echo "Strata Enterprise Toolchain (SDK v1.0.0)"
        echo "Usage: strata <lex|parse|check|codegen|build|test|bench|deploy|publish|debug|version> [arguments]"
        ;;
esac
