#!/usr/bin/env bash
# The Strata toolchain.
set -e
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(dirname "$SCRIPT_DIR")"
export PYTHONPATH="$ROOT:$PYTHONPATH"
export STRATA_ROOT="$ROOT"

# Pick a python3 that actually RUNS on this machine, not merely the first one
# on PATH. On an Apple silicon Mac that still has an Intel Homebrew in
# /usr/local, `command -v python3` happily finds an x86 binary and every call
# then dies with "Bad CPU type in executable" -- a confusing way to be told
# that the toolchain is looking at a Python built for a different processor.
# Existing and executable is not the same as runnable, so each candidate is
# tried rather than tested for.
find_python() {
    local c
    for c in "${STRATA_PYTHON:-}" python3 /opt/homebrew/bin/python3 \
             /usr/bin/python3 /usr/local/bin/python3; do
        [ -n "$c" ] || continue
        if command -v "$c" >/dev/null 2>&1 && "$c" -c "pass" >/dev/null 2>&1; then
            printf '%s' "$c"
            return 0
        fi
    done
    echo "[Strata] no working python3 found. Tried PATH, /opt/homebrew," >&2
    echo "         /usr/bin and /usr/local. Set STRATA_PYTHON to one that" >&2
    echo "         runs on this machine." >&2
    return 1
}
PY3="$(find_python)" || exit 1
export STRATA_PYTHON="$PY3"

usage() {
    echo "Strata toolchain 0.4.0-alpha"
    echo "  strata build [file.sta]        no file: builds the project here"
    echo "  strata run   [file.sta]        no file: builds and runs the project"
    echo "  strata deps  [project-dir]     fetch what this project depends on"
    echo "  strata check <file.sta>"
    echo "  strata lex   <file.sta> [--json|--count]"
    echo "  strata ast   <file.sta>"
    echo "  strata run   <file.sta>"
    echo "  strata new   <project_name>"
    echo "  strata test  [dir]"
    echo "  strata repair <file.sta> | --project <dir>   [--backend rules|local|claude|llm]"
    echo "  strata fmt   <file.sta>... [--check]   canonical formatting"
    echo "  strata doc   [dir]            an architecture document for a project"
    echo "  strata version"
}

typecheck() {
    local f="$1"
    "$PY3" - "$f" << 'PYEOF'
import sys
sys.path.insert(0, sys.argv[1].split('/')[0] if '/' not in sys.argv[1] else '.')
import os
ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__))) if '__file__' in dir() else '.'
sys.path.insert(0, os.environ.get('PYTHONPATH','').split(':')[0] or '.')
from compiler.lexer import tokenise_file, LexError
from compiler.parser import Parser, ParseError
from compiler.typechecker import TypeChecker
f = sys.argv[1]
try:
    toks = tokenise_file(f)
    ast  = Parser(toks).parse()
    tc   = TypeChecker(ast, filename=f)
    errs = tc.check()
    if errs:
        for e in errs: print(str(e), file=sys.stderr)
        sys.exit(1)
    print(f"  {len(ast.imports)} imports, {len(ast.declarations)} decls, {len(ast.functions)} functions")
except (LexError, ParseError) as e:
    print(str(e), file=sys.stderr); sys.exit(1)
PYEOF
}

# ── Projects ──────────────────────────────────────────────────────────────────
#
# A Strata application is a directory with a Strata.toml, sources in src/ and
# a binary in build/. `strata build` with no arguments builds the project the
# current directory belongs to.
#
# The reader below is deliberately small: it takes `main` and `output` and
# ignores everything else. It is not a TOML parser, and a key it does not
# understand is not silently honoured — it is simply not read.

find_project() {
    local d="$PWD"
    for _ in 1 2 3 4 5 6; do
        if [ -f "$d/Strata.toml" ]; then echo "$d"; return 0; fi
        [ "$d" = "/" ] && break
        d="$(dirname "$d")"
    done
    return 1
}

toml_value() {
    # toml_value <file> <key> — first `key = "value"`, quotes stripped.
    sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*\"\(.*\)\"[[:space:]]*$/\1/p" "$1" | head -1
}

# The compiler that runs a build.
#
# `compiler/driver.sta` does the whole build in Strata and is proven
# equivalent to the bootstrap by four differential tests: the linker command,
# the C compiler invocation, the finished binary byte for byte, and the
# machine-readable diagnostics. This is what makes that equivalence load
# bearing rather than decorative.
#
# STRATA_BOOTSTRAP=1 forces the Python path. Keep it: if the driver is ever
# wrong, the person hitting it needs a way past without editing the toolchain,
# and the bootstrap is right there.
#
# The driver is rebuilt when any compiler source is newer than it. Without
# that, editing the compiler and running `strata build` would silently use
# yesterday's driver -- the kind of bug that costs an afternoon.
driver_bin() {
    # Per-platform, because build/ is not always one machine's. A folder
    # shared between a Mac and a Linux VM -- or a repo on a USB stick, or a
    # network home directory -- gets a driver built by whichever ran last, and
    # the other then tries to execute a binary for the wrong operating system.
    # "cannot execute binary file" is a baffling thing to be told by a
    # compiler you just installed successfully, so the two no longer collide.
    local bin="$ROOT/build/strata-build-$(uname -s)-$(uname -m)"
    local newest
    newest="$(find "$ROOT/compiler" "$ROOT/std" -name '*.sta' -newer "$bin" -print -quit 2>/dev/null || true)"
    if [ ! -x "$bin" ] || [ -n "$newest" ]; then
        mkdir -p "$ROOT/build"
        # Left by a version of this script that used one shared name.
        rm -f "$ROOT/build/strata-build"
        if ! "$PY3" "$ROOT/bootstrap/stage0.py" "$ROOT/compiler/driver.sta" \
                -o "$bin" >/dev/null 2>&1; then
            return 1
        fi
    fi
    printf '%s' "$bin"
}

# Run a build with the driver, falling back to the bootstrap when the driver
# cannot be built at all. A driver that builds and then rejects the program is
# NOT a fallback case: that is a compiler saying no, and quietly asking a
# different compiler for a second opinion would hide exactly the divergence
# the differential tests exist to catch.
run_build() {
    if [ "${STRATA_BOOTSTRAP:-0}" = "1" ]; then
        "$PY3" "$ROOT/bootstrap/stage0.py" "$@"
        return $?
    fi
    local bin
    if bin="$(driver_bin)"; then
        "$bin" "$@"
        return $?
    fi
    echo "[Strata] the self-hosted driver could not be built; using the bootstrap" >&2
    "$PY3" "$ROOT/bootstrap/stage0.py" "$@"
}

cmd_build() {
    case "${1:-}" in
        -h|--help)
                echo "Usage: strata build [file.sta] [-o out] [--json] [--target native|wasm|c]"
                echo "  Checks and compiles. Inside a project, builds the entry point named"
                echo "  in Strata.toml; with a file, builds that file."
                echo "  --json prints every diagnostic as a JSON payload instead of text."
            return 0 ;;
    esac
    local file="$1"

    if [ -z "$file" ]; then
        local proj; proj="$(find_project)" || {
            echo "no Strata.toml here or above; run 'strata build <file.sta>'" >&2
            return 1
        }
        local main out
        main="$(toml_value "$proj/Strata.toml" main)"
        out="$(toml_value "$proj/Strata.toml" output)"
        [ -z "$main" ] && main="src/main.sta"
        [ -z "$out" ]  && out="build/$(basename "$proj")"
        if [ ! -f "$proj/$main" ]; then
            echo "$proj/Strata.toml names main = \"$main\", which does not exist" >&2
            return 1
        fi
        mkdir -p "$proj/$(dirname "$out")"
        echo "[Strata] building $(basename "$proj") — $main -> $out"
        ( cd "$proj" && run_build "$main" -o "$out" ) || return 1
        return 0
    fi

    # `--json` has to stay JSON all the way through, including the one
    # failure a machine most needs to read. The README offered it on build
    # and nothing implemented it: the flag was ignored and a caller piping
    # the output into a parser got raw C compiler text.
    local want_json=0 args=()
    for a in "$@"; do
        if [ "$a" = "--json" ]; then want_json=1; else args+=("$a"); fi
    done
    if [ "$want_json" = "1" ]; then
        # `strata build --json` with no file is the form CI reaches for,
        # because `strata build` with no file is the documented default. It
        # used to fall through to a branch that needed one and exit 1 with
        # nothing on either stream.
        local src="${args[0]:-}"
        if [ -z "$src" ]; then
            local proj; proj="$(find_project)" || {
                echo '{"ok":false,"stage":"project","error_count":1,"diagnostics":[{"code":"E901","message":"no Strata.toml here or above","hint":"run strata build <file.sta>, or run this inside a project"}]}'
                return 1
            }
            local pmain; pmain="$(toml_value "$proj/Strata.toml" main)"
            [ -z "$pmain" ] && pmain="src/main.sta"
            src="$proj/$pmain"
            args=("$src")
        fi
        # The check comes first and reports in its own shape. A file the
        # checker rejects never reaches the C compiler, so there is nothing
        # further to say about it.
        # `|| true`, because this script runs under `set -e` and stage0
        # exits non-zero when it has diagnostics to report — which is the
        # case this whole branch exists for. Without it the script died here
        # and printed nothing at all on every failing build.
        local check_out
        check_out="$("$PY3" "$ROOT/bootstrap/stage0.py" "$src" --json 2>/dev/null || true)"
        if ! printf '%s' "$check_out" | grep -q '"ok": true'; then
            printf '%s\n' "$check_out"
            return 1
        fi
        # `|| rc=$?` and not a bare assignment: this script runs under
        # `set -e`, which would end it at the failing build before the JSON
        # could be written — which is exactly the case this exists for.
        local build_out rc=0
        build_out="$(run_build "${args[@]}" 2>&1)" || rc=$?
        if [ "$rc" = "0" ]; then
            printf '%s' "$check_out"
            return 0
        fi
        STRATA_CC_OUTPUT="$build_out" STRATA_CC_FILE="$src" "$PY3" - <<'JSONEOF'
import json, os, sys
print(json.dumps({
    "file": os.environ.get("STRATA_CC_FILE", ""),
    "stage": "cc",
    "ok": False,
    "error_count": 1,
    "advisory_count": 0,
    "diagnostics": [{
        "code": "E900",
        "classification": "C Compiler Rejected Generated Code",
        "severity": "CRITICAL_HALT",
        "file": os.environ.get("STRATA_CC_FILE", ""),
        "line": 0,
        "column": 0,
        "message": "the C compiler rejected the generated code",
        "hint": "The type check passed and the build did not. Either a "
                "foreign declaration does not match the library it names, "
                "or this is a compiler defect worth reporting.",
        "remediation_strategy":
            "Do not attempt a source repair from this. The text below "
            "describes generated C, and its line numbers refer to a file "
            "the developer did not write. Check any `foreign` block and "
            "`link` flag first; otherwise report it.",
        "cc_output": os.environ.get("STRATA_CC_OUTPUT", ""),
    }],
}, indent=2))
JSONEOF
        return 1
    fi

    # A single file, for a script or an example. The compiler does the type
    # checking: doing it again here, without resolving imports, printed
    # "TypeCheck OK" for files it then rejected.
    run_build "$@"
}

cmd_check() {
    case "${1:-}" in
        -h|--help)
                echo "Usage: strata check <file.sta>..."
                echo "  Checks without building, and writes nothing."
                echo "  Exits non-zero if anything is wrong, so it suits a pre-commit hook."
            return 0 ;;
    esac
    # Checks a file the way `strata build` checks it: imports resolved first.
    #
    # Without that, a file importing its own schema is checked with no idea
    # what a `database Order` is, so `strata check` reported sixteen errors
    # for apps/orders/src/rules.sta while `strata build` compiled it without
    # complaint. A checker that disagrees with the compiler is worse than no
    # checker: the first thing a newcomer runs told them their code was
    # broken when it was not.
    #
    # This was a Python script embedded here. The check has been Strata for
    # some time; only the reporting around it was not, and a second
    # implementation of "which diagnostics stop a build" is a second thing to
    # get wrong -- `strata check` once treated the E007 advisory as an error,
    # which is the opposite of what the taxonomy says.
    local f="" want_json=0
    local a
    for a in "$@"; do
        case "$a" in
            --json) want_json=1 ;;
            *) [ -z "$f" ] && f="$a" ;;
        esac
    done
    if [ -z "$f" ]; then echo "Usage: strata check <file.sta> [--json]"; exit 1; fi

    # --json was accepted and silently ignored: `strata check x.sta --json`
    # printed the same human text, while three documents promised a payload a
    # model could act on -- and that payload is the project's central claim.
    #
    # It goes through the bootstrap rather than compiler/json_cli.sta, which
    # is the self-hosted emitter and the one this should eventually use. In a
    # project created by `strata new`, json_cli reports `std` as unresolved
    # while `strata build` compiles the same file without complaint. A checker
    # that disagrees with the compiler is worse than no checker, so the
    # correct answer wins over the self-hosted one until json_cli resolves
    # imports the way the compiler does. It is on the list in STAGES.md.
    if [ "$want_json" = "1" ]; then
        "$PY3" "$ROOT/bootstrap/stage0.py" "$f" --json
        return $?
    fi

    local cache="$ROOT/build"
    if ! mkdir -p "$cache" 2>/dev/null || [ ! -w "$cache" ]; then
        cache="${XDG_CACHE_HOME:-$HOME/.cache}/strata"
        mkdir -p "$cache"
    fi
    local bin="$cache/strata-check"
    local newest
    newest="$(find "$ROOT/compiler" "$ROOT/std" -name '*.sta' -newer "$bin" -print -quit 2>/dev/null || true)"
    if [ ! -x "$bin" ] || [ -n "$newest" ]; then
        "$PY3" "$ROOT/bootstrap/stage0.py" "$ROOT/compiler/check_cli.sta" \
            -o "$bin" >/dev/null || { echo "could not build strata check" >&2; return 1; }
    fi
    "$bin" "$f"
}

cmd_lex() {
    case "${1:-}" in
        -h|--help)
            echo "Usage: strata lex <file.sta>"
            echo "  Prints the token stream, for understanding what the lexer saw."
            return 0 ;;
    esac
    "$PY3" "$ROOT/compiler/lexer.py" "$@"
}

cmd_ast() {
    case "${1:-}" in
        -h|--help)
                echo "Usage: strata ast <file.sta>"
                echo "  Prints the parse tree, for understanding what the parser saw."
            return 0 ;;
    esac
    local f="$1"
    "$PY3" << PYEOF
import sys, json
sys.path.insert(0, '$ROOT')
from compiler.lexer import tokenise_file
from compiler.parser import Parser
toks = tokenise_file('$f')
ast  = Parser(toks).parse()
print(json.dumps(ast.to_dict(), indent=2))
PYEOF
}

cmd_run() {
    case "${1:-}" in
        -h|--help)
                echo "Usage: strata run [file.sta] [args...]"
                echo "  Builds, then runs. Inside a project, runs the entry point named in"
                echo "  Strata.toml; anything after the file is passed to the program."
            return 0 ;;
    esac
    local f="$1"
    if [ -z "$f" ]; then
        local proj; proj="$(find_project)" || {
            echo "no Strata.toml here or above; run 'strata run <file.sta>'" >&2
            return 1
        }
        cmd_build || return 1
        local out; out="$(toml_value "$proj/Strata.toml" output)"
        [ -z "$out" ] && out="build/$(basename "$proj")"
        ( cd "$proj" && exec "./$out" )
        return $?
    fi
    local tmp; tmp="$(mktemp /tmp/strata_XXXXXX)"
    "$PY3" "$ROOT/bootstrap/stage0.py" "$f" -o "$tmp"
    "$tmp"
    rm -f "$tmp"
}


cmd_new() {
    case "${1:-}" in
        -h|--help)
                echo "Usage: strata new <name>"
                echo "  Creates a project: schema, program, a test and Strata.toml."
            return 0 ;;
    esac
    local name="$1"
    if [ -z "$name" ]; then echo "Usage: strata new <project_name>"; exit 1; fi
    if [ -e "$name" ]; then echo "'$name' already exists" >&2; return 1; fi
    mkdir -p "$name/src" "$name/tests" "$name/data" "$name/build"
    cat > "$name/Strata.toml" << TOML
[package]
name = "$name"
version = "0.1.0"

[build]
# strata build with no arguments reads these two keys.
main = "src/main.sta"
output = "build/$name"
TOML
    # A project with no .gitignore means the first `git add .` commits the
    # generated C sitting beside the source and the binary in build/. A blind
    # pilot found 92 KB of generated C in src/ and nothing telling them to
    # leave it out.
    cat > "$name/.gitignore" << 'IGNORE'
# What the compiler writes. The sources are src/*.sta; everything here is
# produced from them and can be produced again.
build/
*.c
# What `strata repair` keeps when it rewrites one of your files.
*.before-repair
IGNORE
    cat > "$name/src/schema.sta" << 'STA'
// The data tier. Every other tier is checked against this declaration:
// rename a column and the query, the aggregate and the page fail to build.

database Item {
    int   id;
    str   name;
    float price;
}
STA
    cat > "$name/tests/items_test.sta" << 'STA'
// `strata test` builds and runs every verify block in the project.
//
// A generated project ships with one so that the first `strata test` a new
// developer runs says something other than "0 passed".
//
// A test file is an ordinary Strata file: it reaches the project's code by
// importing the module, exactly as `src/main.sta` does. `import schema from
// app` below is that -- and a function living in another file of yours is
// reached the same way:
//
//     import rules from app;      // then call anything rules.sta defines
//
// Without the import the build fails with E002 and names the function it
// could not find, which is the compiler telling you the file is not in
// scope rather than that the function does not exist.

import io     from std;
import str    from std;
import schema from app;

int total_items() {
    return count(Item <- [id > 0]);
}

verify "an item can be added and counted" {
    assert total_items() == 0;
    Item <- [id = 1, name = "first", price = 9.99];
    assert total_items() == 1;
}

verify "the value of everything is the sum of the prices" {
    Item <- [id = 2, name = "second", price = 0.01];
    list[Item] all = Item <- [id > 0];
    assert sum(all.price) == 10.00;
}
STA
    # Quoted delimiter. Unquoted, bash treated the backticked `src/schema.sta`
    # below as a command to run: every `strata new` printed an error, and the
    # README it wrote had the backticks evaluated away. The name is put in
    # afterwards rather than by the shell.
    cat > "$name/README.md" << 'MD'
# PROJECT_NAME

    strata build      compile it
    strata run        compile and run it
    strata test       build and run the verify blocks
    strata check src/main.sta     type-check one file
    strata fmt src/*.sta          canonical formatting
    strata repair src/main.sta    let a model fix what the compiler rejected

`src/schema.sta` is the data tier. Rename a column there and every query,
aggregate and page that used it fails to build — that contract is the reason
this language exists.
MD
    awk -v n="$name" '{gsub(/PROJECT_NAME/, n); print}' "$name/README.md" \
        > "$name/README.md.tmp" && mv "$name/README.md.tmp" "$name/README.md"
    cat > "$name/src/main.sta" << STA
import io     from std;
import str    from std;
import mem    from std;
import schema from app;

int main() {
    Item <- [id = 1, name = "first", price = 9.99];
    list[Item] all = Item <- [id > 0];
    print(str_concat("items: ", str(count(all))));
    print(str_concat("value: ", str(sum(all.price))));
    return 0;
}
STA
    echo "created $name — 'cd $name && strata run'"
}

cmd_test() {
    # Builds and runs the verify blocks in each file. Previously this only
    # type-checked, so a file with a failing assertion reported PASS.
    #
    # With no argument inside a project, this tests the project: every .sta
    # under it, recursively, compiled from the project root so that
    # `import x from app` resolves and so a test can open the project's data
    # files by the same relative path the service uses. Testing only
    # `test_suite/*.sta` meant an application had no way to be tested at all,
    # which is why apps/orders had no tests until its journey demanded them.
    local dir="$1" base=""
    case "$dir" in
        -h|--help)
            echo "Usage: strata test [dir]"
            echo "  Builds and runs every verify block under [dir], or under"
            echo "  the project containing the current directory."
            echo
            echo "  A test file reaches its project's code the same way any"
            echo "  other file does -- by importing the module:"
            echo "      import main from app;"
            return 0 ;;
    esac
    if [ -z "$dir" ]; then
        local proj; proj="$(find_project)" || true
        if [ -n "$proj" ]; then
            dir="$proj"; base="$proj"
        else
            # This used to fall back to a directory called `test_suite`,
            # which is this repository's own. Run anywhere else it printed
            # `find`'s complaint, reported "0 passed, 0 failed" and exited 0 --
            # so a CI job that changed to the wrong directory went green.
            # `build` and `run` have always refused here; so does this.
            echo "no Strata.toml here or above; run 'strata test <dir>'" >&2
            return 1
        fi
    fi
    echo "[Strata Test] $dir"
    local p=0 f=0 skipped=0
    local tmp; tmp="$(mktemp -d)"
    local files=()
    if [ -n "$base" ]; then
        while IFS= read -r line; do files+=("$line"); done < <(
            find "$dir" -name '*.sta' -not -path '*/build/*' \
                        -not -path '*_to_delete*' | sort)
    else
        while IFS= read -r line; do files+=("$line"); done < <(
            find "$dir" -maxdepth 1 -name '*.sta' | sort)
    fi
    for sta in "${files[@]}"; do
        [ -f "$sta" ] || continue
        if ! grep -q '^verify ' "$sta"; then
            skipped=$((skipped+1)); continue
        fi
        local bin="$tmp/$(basename "$sta" .sta)"
        local src="$sta" run_in="$PWD"
        if [ -n "$base" ]; then
            src="${sta#$base/}"; run_in="$base"
        fi
        # The compiler's output used to go to /dev/null and the loop printed
        # "BUILD FAIL" and nothing else -- from a toolchain whose whole claim
        # is that a diagnostic tells you what to do. The message was right
        # there and thrown away: running `strata check` on the same file by
        # hand gave the code, the line and the hint.
        local why
        if ! why="$( cd "$run_in" && "$PY3" "$ROOT/bootstrap/stage0.py" "$src" --test -o "$bin" 2>&1 )"; then
            echo "  BUILD FAIL: $sta"
            printf '%s\n' "$why" | sed 's/^/      /'
            f=$((f+1)); continue
        fi
        if ( cd "$run_in" && "$bin" ); then
            echo "  PASS: $sta"; p=$((p+1))
        else
            echo "  FAIL: $sta"; f=$((f+1))
        fi
    done
    rm -rf "$tmp"
    echo "[Strata Test] $p passed, $f failed, $skipped file(s) with no verify blocks."
    [ "$f" -eq 0 ] || exit 1
    # A project whose sources do not compile is not a passing project, whatever
    # its tests say. This only ever built the files that HOLD verify blocks, so
    # deleting or renaming the test file made a broken repository report
    # "0 passed, 0 failed" and exit 0 -- green CI on a tree `strata build`
    # refuses. Checked after the blocks have run, so a real failure is still
    # the first thing reported.
    if [ -n "$base" ]; then
        local chk
        if ! chk="$( cd "$base" && cmd_check_project_quietly )"; then
            echo "  BUILD FAIL: the project does not compile"
            printf '%s\n' "$chk" | sed 's/^/      /'
            echo "[Strata Test] the tests say nothing about a tree that does" \
                 "not build."
            exit 1
        fi
        if [ "$p" -eq 0 ] && [ "$f" -eq 0 ]; then
            echo "[Strata Test] no verify blocks were found, so nothing was" \
                 "tested."
            echo "              A test file holds 'verify \"name\" { ... }'." \
                 "Exiting non-zero so an"
            echo "              empty run is not mistaken for a passing one."
            exit 1
        fi
    fi
}

# Whether the project in the current directory compiles, with the compiler's
# own words on failure. Used by `strata test`, which must not call itself a
# success on a tree that does not build.
cmd_check_project_quietly() {
    local entry
    entry="$(toml_value "Strata.toml" main)" || entry=""
    if [ -z "$entry" ]; then entry="src/main.sta"; fi
    [ -f "$entry" ] || { echo "$entry, named in Strata.toml, is not there"; return 1; }
    # --emit-c runs the whole front end and writes to stdout rather than to
    # the tree, so this answers "does it compile" without leaving anything
    # behind beside the developer's source.
    "$PY3" "$ROOT/bootstrap/stage0.py" "$entry" --emit-c >/dev/null 2>&1 \
        || "$PY3" "$ROOT/bootstrap/stage0.py" "$entry" --emit-c 2>&1 >/dev/null
}

cmd_doc() {
    # An architecture document from the same parse the build uses. The point
    # is that it cannot drift: there is no second description of the system
    # to fall out of date, because this one is derived from the first.
    local dir="$1"
    case "$dir" in
        -h|--help)
            echo "Usage: strata doc [dir]"
            echo "  Writes an architecture document for the project to stdout:"
            echo "  its tables and columns, screens, reports, foreign libraries,"
            echo "  imports and function signatures."
            echo "      strata doc > ARCHITECTURE.md"
            return 0 ;;
    esac
    if [ -z "$dir" ]; then
        dir="$(find_project)" || { echo "no Strata.toml here or above" >&2; return 1; }
    fi
    dir="$(cd "$dir" && pwd)"

    local bin="$ROOT/build/strata-doc-$(uname -s)-$(uname -m)"
    local newest
    newest="$(find "$ROOT/compiler" "$ROOT/std" -name '*.sta' -newer "$bin" -print -quit 2>/dev/null || true)"
    if [ ! -x "$bin" ] || [ -n "$newest" ]; then
        mkdir -p "$ROOT/build"
        "$PY3" "$ROOT/bootstrap/stage0.py" "$ROOT/compiler/doc_cli.sta" \
            -o "$bin" >/dev/null || { echo "could not build strata doc" >&2; return 1; }
    fi

    local files=()
    local f
    while IFS= read -r f; do files+=("$f"); done < <(
        cd "$dir" && find . -name '*.sta' -not -path './build/*' -not -path '*/_to_delete/*' -not -path '*/.*/*' | sed 's|^\./||' | sort)
    if [ ${#files[@]} -eq 0 ]; then
        echo "no .sta files under $dir" >&2; return 1
    fi
    ( cd "$dir" && "$bin" "$dir" "${files[@]}" )
}

cmd_version() {
    case "${1:-}" in
        -h|--help)
                echo "Usage: strata version"
                echo "  Prints the compiler's version."
            return 0 ;;
    esac
    echo "Strata v0.4.0-alpha | self-hosting front end"
    echo "  Stage 0: Python bootstrap (bootstrap/stage0.py)"
    echo "  Stage 1: compiler/{lexer,parser,typechecker,codegen}.sta (Strata)"
    echo "  Targets: native, wasm, c"
}

cmd_fmt() {
    local check=0 files=()
    for a in "$@"; do
        case "$a" in
            --check) check=1 ;;
            -h|--help)
                # Unhandled, --help was taken for a filename and the error the
                # user saw was `cmp`'s manual.
                echo "Usage: strata fmt <file.sta>... [--check]"
                echo "  Rewrites each file in the one canonical layout."
                echo "  --check writes nothing: it prints the files that are"
                echo "  not already formatted and exits non-zero, which is"
                echo "  what CI runs."
                return 0 ;;
            *) files+=("$a") ;;
        esac
    done
    if [ "${#files[@]}" -eq 0 ]; then
        echo "usage: strata fmt <file.sta>... [--check]" >&2; return 2
    fi

    # The formatter is itself a Strata program, built on first use and cached.
    # An installed toolchain may sit somewhere the user cannot write --
    # /usr/local, or a read-only image layer -- so the cache goes beside the
    # install when that is writable and in the user's cache directory when it
    # is not. A formatter that only works for whoever ran the installer is not
    # a formatter.
    local cache="$ROOT/build"
    if ! mkdir -p "$cache" 2>/dev/null || [ ! -w "$cache" ]; then
        cache="${XDG_CACHE_HOME:-$HOME/.cache}/strata"
    fi
    local bin="$cache/strata-fmt"
    if [ ! -x "$bin" ] || [ "$ROOT/compiler/fmt.sta" -nt "$bin" ] \
       || [ "$ROOT/compiler/fmt_cli.sta" -nt "$bin" ]; then
        mkdir -p "$cache"
        "$PY3" "$ROOT/bootstrap/stage0.py" "$ROOT/compiler/fmt_cli.sta" \
            -o "$bin" >/dev/null || { echo "could not build the formatter" >&2; return 1; }
    fi

    local rc=0
    for f in "${files[@]}"; do
        local tmp
        tmp="$(mktemp)"
        if ! "$bin" "$f" > "$tmp"; then
            echo "$f: formatter failed" >&2; rm -f "$tmp"; rc=1; continue
        fi
        if cmp -s "$tmp" "$f"; then
            rm -f "$tmp"; continue
        fi
        if [ "$check" -eq 1 ]; then
            echo "$f"
            rc=1
        else
            # Formatted into a temporary file first, so a formatter that fails
            # or produces nothing never reaches the source file. The copy is a
            # truncating redirect rather than `mv` because some mounts refuse
            # unlink(2), and replacing a file requires removing it.
            if [ ! -s "$tmp" ]; then
                echo "$f: formatter produced nothing, leaving it alone" >&2
                rm -f "$tmp"; rc=1; continue
            fi
            cat "$tmp" > "$f"
            rm -f "$tmp"
            echo "formatted $f"
            continue
        fi
        rm -f "$tmp"
    done
    return $rc
}

# `strata deps` — put every declared dependency in place.
#
# Built on first use and rebuilt when its sources change, the same way the
# formatter is. It is a Strata program; nothing about resolving dependencies
# needs Python.
cmd_deps() {
    case "${1:-}" in
        -h|--help)
                echo "Usage: strata deps"
                echo "  Lists what the project in this directory imports, and whether each"
                echo "  import resolves to a checkout on this machine."
            return 0 ;;
    esac
    local cache="$ROOT/build"
    if ! mkdir -p "$cache" 2>/dev/null || [ ! -w "$cache" ]; then
        cache="${XDG_CACHE_HOME:-$HOME/.cache}/strata"
        mkdir -p "$cache"
    fi
    local bin="$cache/strata-deps"
    local newest
    newest="$(find "$ROOT/compiler" "$ROOT/std" -name '*.sta' -newer "$bin" -print -quit 2>/dev/null || true)"
    if [ ! -x "$bin" ] || [ -n "$newest" ]; then
        "$PY3" "$ROOT/bootstrap/stage0.py" "$ROOT/compiler/deps_cli.sta" \
            -o "$bin" >/dev/null || { echo "could not build strata deps" >&2; return 1; }
    fi

    # With no directory given, resolve the project we are standing in, the way
    # `strata build` with no file does.
    if [ $# -eq 0 ] || [ "${1:0:1}" = "-" ]; then
        local proj; proj="$(find_project)" || {
            echo "no Strata.toml here or above; run 'strata deps <project-dir>'" >&2
            return 1
        }
        "$bin" "$proj" "$@"
        return $?
    fi
    "$bin" "$@"
}

CMD="${1:-}"; shift 2>/dev/null || true
case "$CMD" in
    build)   cmd_build "$@" ;;
    deps)    cmd_deps  "$@" ;;
    check)   cmd_check "$@" ;;
    lex)     cmd_lex   "$@" ;;
    ast)     cmd_ast   "$@" ;;
    run)     cmd_run   "$@" ;;
    new)     cmd_new   "$@" ;;
    test)    cmd_test  "$@" ;;
    repair)  exec "$PY3" "$ROOT/ai_self_repair.py" "$@" ;;
    doc)     cmd_doc "$@" ;;
    fmt)     cmd_fmt   "$@" ;;
    version) cmd_version "$@" ;;
    ""|help) usage ;;
    --help|-h|help) usage; exit 0 ;;
    *) echo "Unknown: $CMD"; usage; exit 1 ;;
esac
