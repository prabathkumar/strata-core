#!/usr/bin/env bash
# ==============================================================================
# STRATA DEVELOPER SDK: bin/strata
# Unified Command-Line Interface Toolchain Master Driver (Lexer Integrated)
# ==============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

COMMAND=$1
PARAM1=$2

case $COMMAND in
    "version")
        echo -e "${CYAN}Strata Engine v1.0.0 (Native Lexer/Parser Active)${NC}"
        ;;
    "lex")
        if [ -z "$PARAM1" ]; then
            echo -e "${RED}[Error]: Please specify a .sta source file to tokenize.${NC}"
            exit 1
        fi
        ./bin/strata-lexer "$PARAM1"
        ;;
    "build")
        ./bin/strata-deploy
        ;;
    "bench")
        ./bin/strata-bench
        ;;
    "demo")
        ./bin/strata demo
        ;;
    *)
        echo "Strata Enterprise Toolchain (SDK v1.0.0)"
        echo "Usage: strata <lex|build|bench|demo|version> [arguments]"
        ;;
esac
