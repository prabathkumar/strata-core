#!/usr/bin/env bash
# ==============================================================================
# STRATA DEVELOPER SDK: bin/strata
# Unified Command-Line Interface Toolchain Master Driver (Test Engine Active)
# ==============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

COMMAND=$1
PARAM1=$2

case $COMMAND in
    "version")
        echo -e "${CYAN}Strata Engine v1.0.0 (Native Integration Testing Active)${NC}"
        ;;
    "lex")
        ./bin/strata-lexer "$PARAM1"
        ;;
    "parse")
        ./bin/strata-parser "$PARAM1"
        ;;
    "codegen")
        ./bin/strata-codegen "$PARAM1" "$PARAM2"
        ;;
    "test")
        # Direct structural pipeline routing to the native regression testing tool
        ./bin/strata-test
        ;;
    "build")
        ./bin/strata-deploy
        ;;
    "bench")
        ./bin/strata-bench
        ;;
    "demo")
        ./bin/strata demo
        ;;
    *)
        echo "Strata Enterprise Toolchain (SDK v1.0.0)"
        echo "Usage: strata <lex|parse|codegen|test|build|bench|demo|version> [arguments]"
        ;;
esac
