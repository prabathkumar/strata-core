# The compiler writes a .c file beside every .sta it reads, and a binary into
# build/. Neither is source.
build/
src/*.c
examples/*.c

# A symbolic link pointing out of the tree, created by test_server.sh to
# check that a path escape is refused and removed again afterwards. It is a
# fixture the test makes, not source -- and a link to /etc is an odd thing
# to ship by accident.
examples/escape_link
