+// Drop one layer of parentheses when it wraps the whole expression -- see
+// stage0.py. Without this, `if ((a == b))` made clang warn on every build.
+str unwrap_once(str e) {
+    int n = str_len(e);
+    if (n < 2) { return e; }
+    if (e[0] != 40) { return e; }
+    if (e[n - 1] != 41) { return e; }
+    int depth = 0;
+    for (int i = 0; i < n; i = i + 1) {
+        if (e[i] == 40) { depth = depth + 1; }
+        if (e[i] == 41) {
+            depth = depth - 1;
+            if (depth == 0) {
+                if (i != n - 1) { return e; }
+            }
+        }
+    }
+    if (depth != 0) { return e; }
+    return str_slice(e, 1, n - 1);
+}
