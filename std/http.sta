// STRATA STANDARD LIBRARY — std/http.sta
// A blocking HTTP/1.1 server, written in Strata.
//
// The socket calls are `native` blocks over the headers a `foreign` block
// includes, so this needed no compiler change: the FFI that already existed
// was enough. That is the point worth noticing — the web tier is library
// code, not a privileged part of the language.
//
// What it is: one connection at a time, read the request, hand the path to
// the application, write the response, close. Enough to serve a page backed
// by a database.
//
// Concurrency is a process per connection: `http_fork` after `http_accept`,
// the child serves and exits. The children share nothing but the filesystem,
// so an application that writes must take `lock_exclusive` around the part
// that reads, changes and saves its tables.
//
// What it is NOT: no TLS, no keep-alive, no streaming, no chunked encoding,
// no request larger than 64KB, and no protection against a client that opens
// connections faster than they are served. Do not put this on the public
// internet.

import io  from std;
import str from std;
import mem from std;

foreign "sys/socket.h" link "" { }
foreign "netinet/in.h" link "" { }
foreign "unistd.h"     link "" { }
foreign "sys/file.h"   link "" { }
foreign "sys/wait.h"   link "" { }
foreign "signal.h"     link "" { }
foreign "fcntl.h"      link "" { }
foreign "sys/time.h"   link "" { }

// Returns a listening socket, or -1.
int http_listen(int port) {
    native "
    int fd = socket(AF_INET, SOCK_STREAM, 0);
    if (fd < 0) return -1;
    int yes = 1;
    setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &yes, sizeof(yes));
    struct sockaddr_in a; memset(&a, 0, sizeof(a));
    a.sin_family = AF_INET;
    a.sin_addr.s_addr = htonl(INADDR_ANY);
    a.sin_port = htons((unsigned short)$port);
    if (bind(fd, (struct sockaddr*)&a, sizeof(a)) < 0) { close(fd); return -1; }
    if (listen(fd, 16) < 0) { close(fd); return -1; }
    return fd;
    ";
}

int http_accept(int server_fd) { native "return accept($server_fd, NULL, NULL);"; }

// Read a whole request: headers first, then exactly Content-Length bytes of
// body.
//
// This used to be a single read(). It worked with curl, which puts a small
// request in one packet, and failed with any client that writes the headers
// and the body separately — the body arrived after the read returned, so
// every posted field looked absent and every form submission was a 400.
// Nothing about the code said "one packet"; it just happened to be true of
// the client it was tried with.
str http_read_request(int conn) {
    native "
    static char buf[65536];
    size_t have = 0;
    const char* sep = NULL;

    /* Headers, however many reads that takes. */
    while (have + 1 < sizeof(buf)) {
        buf[have] = 0;
        sep = strstr(buf, \"\\r\\n\\r\\n\");
        if (sep) break;
        ssize_t n = read($conn, buf + have, sizeof(buf) - 1 - have);
        if (n <= 0) break;
        have += (size_t)n;
    }
    buf[have] = 0;
    sep = strstr(buf, \"\\r\\n\\r\\n\");
    /* No headers means the client never sent a request — it timed out, or
       dropped, or sent something that is not HTTP. An empty string says so;
       returning the partial bytes made a truncated request look like a real
       one with a strange path. */
    if (!sep) return \"\";

    /* Then the body the headers said was coming. A client that sends fewer
       bytes than it promised would hang here; a real server needs a timeout,
       and this one does not have one. */
    size_t head_len = (size_t)(sep - buf) + 4;
    /* Header names are case-insensitive, and strcasestr needs _GNU_SOURCE —
       without it the implicit declaration truncates the returned pointer and
       the length reads as zero, so the body is never read and every posted
       field looks absent. Scanned explicitly instead. */
    long want = 0;
    for (const char* p = buf; p + 15 <= sep; p++) {
        int match = 1;
        const char* name = \"content-length:\";
        for (int k = 0; k < 15; k++) {
            if (tolower((unsigned char)p[k]) != name[k]) { match = 0; break; }
        }
        if (match) { want = strtol(p + 15, NULL, 10); break; }
    }
    if (want < 0) want = 0;

    while ((long)(have - head_len) < want && have + 1 < sizeof(buf)) {
        ssize_t n = read($conn, buf + have, sizeof(buf) - 1 - have);
        if (n <= 0) break;
        have += (size_t)n;
    }
    buf[have] = 0;
    /* A body shorter than Content-Length is an incomplete request, not a
       request with missing fields. */
    if ((long)(have - head_len) < want) return \"\";
    return buf;
    ";
}

int http_close(int conn) { native "close($conn); return 1;"; }

// ── Surviving contact ────────────────────────────────────────────────────────
//
// Three things kill a server that works perfectly against one polite client.

// A client that disconnects while the response is being written raises
// SIGPIPE, whose default action is to terminate the process. One abandoned
// page load took the whole service down, and nothing in the code said so.
int http_ignore_broken_pipes() { native "signal(SIGPIPE, SIG_IGN); return 1;"; }

// Children are reaped by the kernel rather than accumulating as zombies until
// the process table is full.
int http_reap_children() { native "signal(SIGCHLD, SIG_IGN); return 1;"; }

// A client that promises more body than it sends holds the connection open
// for as long as it likes. With a receive timeout the read fails, the request
// comes back empty, and the connection is answered and closed.
int http_set_timeout(int conn, int seconds) {
    native "
    struct timeval tv; tv.tv_sec = (time_t)$seconds; tv.tv_usec = 0;
    setsockopt($conn, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
    setsockopt($conn, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
    return 1;
    ";
}

// 0 in the child, the child's pid in the parent, -1 if the fork failed — in
// which case the caller should serve the connection itself rather than drop
// it.
int http_fork() { native "return (int64_t)fork();"; }

// The child leaves without running the parent's exit handlers or flushing
// buffers it inherited a copy of.
int http_exit(int code) { native "_exit((int)$code); return 0;"; }

// The children share nothing but the filesystem. A handler that reads,
// changes and saves a table must hold this across all three, or two requests
// arriving together each write a whole table from their own copy and one of
// them disappears.
int lock_exclusive(str path) {
    native "
    int fd = open($path, O_CREAT | O_RDWR, 0600);
    if (fd < 0) return -1;
    if (flock(fd, LOCK_EX) < 0) { close(fd); return -1; }
    return fd;
    ";
}

// A reader only needs to be sure no writer is halfway through replacing the
// file. Several readers may hold this at once, which is what lets GETs be
// served in parallel.
int lock_shared(str path) {
    native "
    int fd = open($path, O_CREAT | O_RDWR, 0600);
    if (fd < 0) return -1;
    if (flock(fd, LOCK_SH) < 0) { close(fd); return -1; }
    return fd;
    ";
}

int unlock(int fd) {
    native "
    if ($fd < 0) return 0;
    flock($fd, LOCK_UN); close($fd);
    return 1;
    ";
}

// 408, for a request that never finished arriving.
int http_request_timeout(int conn) {
    return http_respond(conn, 408, "text/html; charset=utf-8",
    "<h1>408</h1><p>the request did not finish arriving</p>");
}

// `GET /orders?x=1 HTTP/1.1` -> `/orders`
str http_path(str request) {
    int sp1 = str_index_of(request, " ");
    if (sp1 < 0) { return "/"; }
    str rest = str_slice(request, sp1 + 1, str_len(request));
    int sp2 = str_index_of(rest, " ");
    if (sp2 < 0) { return "/"; }
    str target = str_slice(rest, 0, sp2);
    int q = str_index_of(target, "?");
    if (q >= 0) { target = str_slice(target, 0, q); }
    if (str_len(target) == 0) { return "/"; }
    return target;
}

// `GET /orders HTTP/1.1` -> `GET`
str http_method(str request) {
    int sp = str_index_of(request, " ");
    if (sp < 0) { return "GET"; }
    return str_slice(request, 0, sp);
}

int http_respond(int conn, int status, str content_type, str body) {
    native "
    const char* reason = \"OK\";
    if ($status == 404) reason = \"Not Found\";
    if ($status == 400) reason = \"Bad Request\";
    if ($status == 403) reason = \"Forbidden\";
    if ($status == 408) reason = \"Request Timeout\";
    if ($status == 500) reason = \"Internal Server Error\";
    char head[512];
    int hl = snprintf(head, sizeof(head),
        \"HTTP/1.1 %lld %s\\r\\n\"
        \"Content-Type: %s\\r\\n\"
        \"Content-Length: %zu\\r\\n\"
        \"Connection: close\\r\\n\\r\\n\",
        (long long)$status, reason, $content_type, strlen($body));
    if (write($conn, head, hl) < 0) return 0;
    if (write($conn, $body, strlen($body)) < 0) return 0;
    return 1;
    ";
}

// The request body: everything after the blank line that ends the headers.
// Whatever one read() returned, so a body larger than the buffer is truncated
// — a limit, not a design.
str http_body(str request) {
    int sep = str_index_of(request, "\r\n\r\n");
    if (sep >= 0) { return str_slice(request, sep + 4, str_len(request)); }
    sep = str_index_of(request, "\n\n");
    if (sep >= 0) { return str_slice(request, sep + 2, str_len(request)); }
    return "";
}

// One field out of an application/x-www-form-urlencoded body. Returns "" when
// the field is absent, which a caller must tell apart from a field that was
// submitted empty if it cares.
str http_form_value(str body, str key) {
    StringBuilder needle = sb_new();
    sb_append(&needle, key);
    sb_append(&needle, "=");
    str probe = sb_to_str(&needle);

    int n = str_len(body);
    int start = 0;
    while (start <= n) {
        int end = start;
        while (end < n) {
            if (body[end] == 38) { break; }        // &
            end = end + 1;
        }
        str pair = str_slice(body, start, end);
        if (str_starts_with(pair, probe) == 1) {
            return url_decode(str_slice(pair, str_len(probe), str_len(pair)));
        }
        if (end >= n) { return ""; }
        start = end + 1;
    }
    return "";
}

// `+` is a space and `%41` is an `A`. A stray `%` with nothing usable after it
// is kept as a literal `%` rather than dropped, so a malformed body does not
// silently lose characters.
str url_decode(str raw) {
    StringBuilder out = sb_new();
    int n = str_len(raw);
    int i = 0;
    while (i < n) {
        int c = raw[i];
        int step = 1;
        if (c == 43) { sb_append(&out, " "); }
        if (c == 37) {
            if (i + 2 < n) {
                int hi = hex_digit(raw[i + 1]);
                int lo = hex_digit(raw[i + 2]);
                if (hi >= 0) {
                    if (lo >= 0) {
                        sb_append(&out, char_from_code(hi * 16 + lo));
                        step = 3;
                    }
                }
            }
            if (step == 1) { sb_append(&out, "%"); }
        }
        if (c != 43) {
            if (c != 37) { sb_append(&out, char_from_code(c)); }
        }
        i = i + step;
    }
    return sb_to_str(&out);
}

int hex_digit(int c) {
    if (c >= 48) { if (c <= 57)  { return c - 48; } }      // 0-9
    if (c >= 97) { if (c <= 102) { return c - 87; } }      // a-f
    if (c >= 65) { if (c <= 70)  { return c - 55; } }      // A-F
    return -1;
}

str char_from_code(int c) {
    native "char _b[2]; _b[0]=(char)$c; _b[1]=0; return strata_dup(_b);";
}

// 303, so a refresh after a form post does not resubmit it.
int http_redirect(int conn, str location) {
    native "
    char head[512];
    int hl = snprintf(head, sizeof(head),
        \"HTTP/1.1 303 See Other\\r\\nLocation: %s\\r\\nContent-Length: 0\\r\\nConnection: close\\r\\n\\r\\n\",
        $location);
    if (write($conn, head, hl) < 0) return 0;
    return 1;
    ";
}

int http_bad_request(int conn, str why) {
    return http_respond(conn, 400, "text/html; charset=utf-8", why);
}

// One header's value, or "". Header names are case-insensitive.
str http_header(str request, str name) {
    int n = str_len(request);
    int start = 0;
    while (start < n) {
        int end = start;
        while (end < n) {
            if (request[end] == 10) { break; }
            end = end + 1;
        }
        str line = str_slice(request, start, end);
        if (str_len(line) == 0) { return ""; }          // end of headers
        int colon = str_index_of(line, ":");
        if (colon > 0) {
            if (str_eq(lower(str_slice(line, 0, colon)), lower(name)) == 1) {
                return trim_spaces(str_slice(line, colon + 1, str_len(line)));
            }
        }
        if (end >= n) { return ""; }
        start = end + 1;
    }
    return "";
}

str lower(str v) {
    StringBuilder sb = sb_new();
    int n = str_len(v);
    for (int i = 0; i < n; i = i + 1) {
        int c = v[i];
        if (c >= 65) { if (c <= 90) { c = c + 32; } }
        sb_append(&sb, char_from_code(c));
    }
    return sb_to_str(&sb);
}

str trim_spaces(str v) {
    int n = str_len(v);
    int a = 0;
    while (a < n) {
        if (v[a] != 32) { if (v[a] != 13) { if (v[a] != 9) { break; } } }
        a = a + 1;
    }
    int b = n;
    while (b > a) {
        int c = v[b - 1];
        if (c != 32) { if (c != 13) { if (c != 9) { break; } } }
        b = b - 1;
    }
    return str_slice(v, a, b);
}

// One cookie out of the Cookie header. Cookies are `a=1; b=2`.
str http_cookie(str request, str name) {
    str header = http_header(request, "Cookie");
    int n = str_len(header);
    int start = 0;
    StringBuilder probe = sb_new();
    sb_append(&probe, name); sb_append(&probe, "=");
    str want = sb_to_str(&probe);
    while (start <= n) {
        int end = start;
        while (end < n) {
            if (header[end] == 59) { break; }           // ;
            end = end + 1;
        }
        str pair = trim_spaces(str_slice(header, start, end));
        if (str_starts_with(pair, want) == 1) {
            return str_slice(pair, str_len(want), str_len(pair));
        }
        if (end >= n) { return ""; }
        start = end + 1;
    }
    return "";
}

// The query string of the request line, without the `?`. It is the same
// urlencoded format as a form body, so http_form_value reads it too.
str http_query_string(str request) {
    int sp1 = str_index_of(request, " ");
    if (sp1 < 0) { return ""; }
    str rest = str_slice(request, sp1 + 1, str_len(request));
    int sp2 = str_index_of(rest, " ");
    if (sp2 < 0) { return ""; }
    str target = str_slice(rest, 0, sp2);
    int q = str_index_of(target, "?");
    if (q < 0) { return ""; }
    return str_slice(target, q + 1, str_len(target));
}

// A response with extra headers — a Set-Cookie, for instance. `extra` is
// already CRLF-terminated, or empty.
int http_respond_with(int conn, int status, str content_type, str extra, str body) {
    native "
    const char* reason = \"OK\";
    if ($status == 303) reason = \"See Other\";
    if ($status == 400) reason = \"Bad Request\";
    if ($status == 403) reason = \"Forbidden\";
    if ($status == 404) reason = \"Not Found\";
    if ($status == 500) reason = \"Internal Server Error\";
    char head[1024];
    int hl = snprintf(head, sizeof(head),
        \"HTTP/1.1 %lld %s\\r\\nContent-Type: %s\\r\\nContent-Length: %zu\\r\\n%sConnection: close\\r\\n\\r\\n\",
        (long long)$status, reason, $content_type, strlen($body), $extra);
    if (write($conn, head, hl) < 0) return 0;
    if (write($conn, $body, strlen($body)) < 0) return 0;
    return 1;
    ";
}

// A redirect that also sets or clears a cookie.
int http_redirect_with(int conn, str location, str extra) {
    StringBuilder head = sb_new();
    sb_append(&head, "Location: ");
    sb_append(&head, location);
    sb_append(&head, "\r\n");
    sb_append(&head, extra);
    return http_respond_with(conn, 303, "text/plain", sb_to_str(&head), "");
}

int http_forbidden(int conn) {
    return http_respond(conn, 403, "text/html; charset=utf-8",
    "<!doctype html><title>403</title><h1>403</h1><p>Sign in first.</p>");
}

int http_ok(int conn, str html) {
    return http_respond(conn, 200, "text/html; charset=utf-8", html);
}

int http_not_found(int conn) {
    return http_respond(conn, 404, "text/html; charset=utf-8",
    "<!doctype html><title>404</title><h1>404</h1>");
}
