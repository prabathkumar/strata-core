// STRATA STANDARD LIBRARY — std/cli.sta
//
// The command line.
//
// It was reachable before this file only by writing C: every tool in the
// repository, the compiler included, opens `main` with a `native` block that
// declares `extern char** __strata_argv` and then works in C for the rest of
// the function. A language whose programs cannot read their own arguments
// without leaving the language does not have command-line programs; it has C
// programs with Strata in them.

import io  from std;
import str from std;

// How many arguments, including the program name at index 0.
int arg_count() { native "extern int __strata_argc; return (int64_t)__strata_argc;"; }

// Argument `i`, or "" past the end. Never null, so callers can use str_len
// and str_eq on the result without checking first.
str arg(int i) {
    native "
    extern int __strata_argc; extern char** __strata_argv;
    if ($i < 0 || $i >= __strata_argc) return \"\";
    return __strata_argv[$i];
    ";
}

// The subcommand — argument 1 — or "" when the program was run bare.
str subcommand() { return arg(1); }

// True when `name` appears anywhere in the arguments. For flags, which have
// no position.
int has_flag(str name) {
    int n = arg_count();
    for (int i = 1; i < n; i = i + 1) {
        if (str_eq(arg(i), name) == 1) { return 1; }
    }
    return 0;
}

// The value after `name`, or "" if the flag is absent or last.
str flag_value(str name) {
    int n = arg_count();
    for (int i = 1; i < n - 1; i = i + 1) {
        if (str_eq(arg(i), name) == 1) { return arg(i + 1); }
    }
    return "";
}

// The i'th argument that is not a flag and not a flag's value, counting from
// the subcommand: positional(0) is the subcommand itself.
str positional(int want) {
    int n = arg_count();
    int seen = 0;
    int i = 1;
    while (i < n) {
        str a = arg(i);
        if (str_len(a) > 0) {
            if (a[0] == 45) { i = i + 1; }
            else {
                if (seen == want) { return a; }
                seen = seen + 1;
            }
        }
        i = i + 1;
    }
    return "";
}
