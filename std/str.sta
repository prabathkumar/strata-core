// STRATA STANDARD LIBRARY — std/str.sta
// String builder for compiler code generation output

import mem from std;
import io from std;

database StringBuilder {
    int buf_ptr;
    int length;
    int capacity;
}

StringBuilder sb_new() {
    native "
    StringBuilder* _sb=(StringBuilder*)malloc(sizeof(StringBuilder));
    _sb->capacity=4096; _sb->length=0;
    _sb->buf_ptr=(int64_t)(uintptr_t)malloc(4096);
    ((char*)(uintptr_t)_sb->buf_ptr)[0]='\\0';
    return _sb;
    ";
}

def sb_append(StringBuilder &sb, str text) {
    native "
    size_t _tl=strlen($text);
    while($sb->length+(int64_t)_tl+1>$sb->capacity){
        $sb->capacity*=2;
        $sb->buf_ptr=(int64_t)(uintptr_t)realloc((void*)(uintptr_t)$sb->buf_ptr,(size_t)$sb->capacity);
    }
    memcpy((char*)(uintptr_t)$sb->buf_ptr+$sb->length,$text,_tl+1);
    $sb->length+=(int64_t)_tl;
    ";
}

def sb_append_line(StringBuilder &sb, str text) {
    native "
    size_t _tl=strlen($text);
    while($sb->length+(int64_t)_tl+2>$sb->capacity){
        $sb->capacity*=2;
        $sb->buf_ptr=(int64_t)(uintptr_t)realloc((void*)(uintptr_t)$sb->buf_ptr,(size_t)$sb->capacity);
    }
    memcpy((char*)(uintptr_t)$sb->buf_ptr+$sb->length,$text,_tl);
    ((char*)(uintptr_t)$sb->buf_ptr)[$sb->length+(int64_t)_tl]='\\n';
    ((char*)(uintptr_t)$sb->buf_ptr)[$sb->length+(int64_t)_tl+1]='\\0';
    $sb->length+=(int64_t)_tl+1;
    ";
}

str sb_to_str(StringBuilder &sb) {
    native "return (char*)(uintptr_t)$sb->buf_ptr;";
}

int sb_length(StringBuilder &sb) {
    native "return $sb->length;";
}

// One character as a string of length one.
//
// It lived in std/http.sta, because percent-decoding was the first thing that
// needed it. Writing JSON needs it too, and a JSON writer has no business
// importing an HTTP server to get at a string helper.
str char_from_code(int c) {
    native "char _b[2]; _b[0]=(char)$c; _b[1]=0; return strata_dup(_b);";
}

// A number with a fixed number of decimal places.
//
// `str(1250.50)` gives "1250.5", which is the right answer for a number and
// the wrong one for money: a price list where one row reads 1250.5 and the
// next 340.0 is a price list nobody trusts. Every business screen needs this,
// so it belongs here rather than in each of them.
str str_fixed(float value, int places) {
    native "
    if ($places < 0) { $places = 0; }
    if ($places > 9) { $places = 9; }
    char fmt[8];
    snprintf(fmt, sizeof(fmt), \"%%.%df\", (int)$places);
    char buf[64];
    snprintf(buf, sizeof(buf), fmt, $value);
    return strata_dup(buf);
    ";
}

// ── Joining several pieces ────────────────────────────────────────────────
//
// str_concat takes exactly two arguments, so a line built from three pieces
// nests: str_concat("a ", str_concat(b, str_concat(" ", c))). That is merely
// ugly at ten lines and unreadable at six hundred, and it is the first thing
// a developer writing a report hits.
//
// These are the two shapes that come up. Neither is a language change: a
// StringBuilder already does this, and these just stop every program from
// writing the same loop.

// Several pieces, one after another, with nothing between them.
str str_cat(list[str] parts) {
    StringBuilder sb = sb_new();
    for p in parts {
        sb_append(&sb, p);
    }
    return sb_to_str(&sb);
}

// Several pieces with a separator between them, and none on the ends —
// str_join(["a", "b", "c"], ", ") is "a, b, c".
str str_join(list[str] parts, str between) {
    StringBuilder sb = sb_new();
    int first = 1;
    for p in parts {
        if (first == 0) { sb_append(&sb, between); }
        sb_append(&sb, p);
        first = 0;
    }
    return sb_to_str(&sb);
}
