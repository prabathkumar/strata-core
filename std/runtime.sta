// ==============================================================================
// STRATA SYSTEM STANDARD LIBRARY: std/runtime.sta
// Native Low-Level Systems Runtime Core & Execution Engine Specification
// ==============================================================================

#region RUNTIME_MEMORY_DESCRIPTOR
// Explicit hardware region allocation context mapping memory layouts directly
database RuntimeMemoryHeapContext {
    int   active_heap_pointer;     // Monotonically increasing unsegmented address index
    int   virtual_fiber_page_count;// Number of 64KB WebAssembly memory boundaries allocated
    int   garbage_collection_flag; // Locked to 0: Enforces Compile-Time Lifetime Borrowing
}
#endregion

#region NATIVE_EXECUTION_SUPPORT_PRIMITIVES

// 1. HARDWARE-LEVEL MEMORY ALLOCATION (Zero-Allocation Layer)
int runtime_allocate_heap_block(int requested_bytes) {
    // Directly increments linear memory pointers without garbage collection scanning stalls
    int allocated_address = native_sys_sbrk(requested_bytes);
    if (allocated_address == -1) {
        print_line("[Runtime Critical Panic]: Bare-Metal Out-Of-Memory Resource Exception!");
        return 0; // Strict system fault termination
    }
    return allocated_address;
}

// 2. PREFIXED STRING MEMORY CONTRACT
// Every string is stored as a 64-bit length header followed by pure UTF-8 char bytes
database StrataRuntimeString {
    int string_length_bytes;
    int starting_memory_address;
}

// 3. 4KB VIRTUAL EVENT FIBER ASYNC TASK RUNTIME HANDLER
// Swaps register execution frames in under 1 nanosecond, bypassing OS thread context context switching
int runtime_fiber_yield_context(int active_fiber_id, int target_fiber_id) {
    // Saves processor instructions on the current fiber stack frame and switches execution rings
    return native_hardware_switch_context(active_fiber_id, target_fiber_id);
}

// 4. EXPLICIT EXCEPTIONS TERMINATION ISOLATION
// Rather than spinning up slow try/catch unwinding trees, errors trigger immediate Simple Halts
void runtime_raise_exception(int error_matrix_id, str trace_context) {
    print_line("!!! [STRATA RUNTIME EXCEPTION]: Halted on Error Matrix ID " + convert_int_to_str(error_matrix_id) + " !!!");
    print_line(" -> Context: " + trace_context);
    native_sys_exit(error_matrix_id); // Terminate immediately to save production cluster integrity
}
#endregion
