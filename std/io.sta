// STRATA STANDARD LIBRARY — std/io.sta
// File I/O, Console I/O primitives — compiles to POSIX C

def print(str message) {
    native "puts($message);";
}

def print_raw(str message) {
    native "fputs($message, stdout);";
}

def print_int(int value) {
    native "printf(\"%lld\\n\", (long long)$value);";
}

// Like eprint, but writes the text exactly: no newline is added. For output
// that already carries its own line breaks.
def eprint_raw(str message) {
    native "fputs($message, stderr);";
}

def eprint(str message) {
    native "fprintf(stderr, \"%s\\n\", $message);";
}

str read_line() {
    native "
    static char _buf[4096];
    if (fgets(_buf, sizeof(_buf), stdin) == NULL) _buf[0]='\\0';
    size_t _l=strlen(_buf);
    if (_l>0 && _buf[_l-1]=='\\n') _buf[_l-1]='\\0';
    return strata_dup(_buf);
    ";
}

str file_read(str path) {
    native "
    FILE* _f=fopen($path,\"r\");
    if(!_f) return \"\";
    fseek(_f,0,SEEK_END); long _sz=ftell(_f); rewind(_f);
    char* _b=(char*)malloc(_sz+1);
    fread(_b,1,_sz,_f); _b[_sz]='\\0'; fclose(_f); return _b;
    ";
}

int file_write(str path, str content) {
    native "
    FILE* _f=fopen($path,\"w\");
    if(!_f) return 0; fputs($content,_f); fclose(_f); return 1;
    ";
}

int file_exists(str path) {
    native "FILE* _f=fopen($path,\"r\"); if(_f){fclose(_f);return 1;} return 0;";
}

str int_to_str(int value) {
    native "char _b[32]; snprintf(_b,32,\"%lld\",(long long)$value); return strata_dup(_b);";
}

str float_to_str(float value) {
    native "char _b[64]; snprintf(_b,64,\"%.6f\",$value); return strata_dup(_b);";
}

int str_to_int(str value) {
    native "return (int64_t)atoll($value);";
}

// Text to a number. A form field arrives as text, so a service that takes
// input needs this; unparseable text is 0 rather than an error, which a
// caller that cares must check for itself.
float str_to_float(str value) {
    native "return strtod($value, NULL);";
}

// ── Errors ────────────────────────────────────────────────────────────────
//
// Strata has no exceptions. A load that meets a damaged file refuses it, says
// so on stderr and leaves the table empty. A program that does not check
// carries on with no rows and no idea -- so an error that is never checked
// makes the program exit non-zero, with a message saying which one.
//
// Check it, act on it, then clear it. A handled failure is not a failure.
int had_error() {
    native "return strata_had_error();";
}

// The most recent error, or "" when there is none unchecked.
str last_error() {
    native "return strata_last_error();";
}

// Say the error has been dealt with; the program can then exit normally.
def clear_error() {
    native "strata_clear_error();";
}

// How many errors were reported during this run, checked or not.
int error_count() {
    native "return strata_error_count();";
}
