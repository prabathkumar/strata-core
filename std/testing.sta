// ==============================================================================
// STRATA SYSTEM STANDARD LIBRARY: std/testing.sta
// Native Unit & Integration Testing Primitives Specification
// ==============================================================================

import core from std;

#region TEST_CONTEXT_SCHEMAS
database TestSuiteTelemetry {
    str   test_case_name;
    int   assertion_count;
    str   execution_state; // "PASSED" or "FAILED"
    float duration_ms;
}
#endregion

#region NATIVE_ASSERTION_MACROS
// One assertion, recorded.
//
// This used to print a failure and return 0, and nothing else. The harness
// counts assertions and failures in the runtime, and this function never
// touched either counter, so a suite could print VERIFY FAILURE and still
// finish "0 failed" and exit 0 -- a red test that CI reads as green. It now
// goes through the same recorder the built-in `assert` statement uses, so a
// failure here is counted, appears in the tally, and makes the exit status
// non-zero.
int assert_true(str criterion_label, int conditional_boolean_flag) {
    native "
    __strata_assert($conditional_boolean_flag != 0, $criterion_label, 0);
    return $conditional_boolean_flag != 0 ? 1 : 0;
    ";
}
#endregion
