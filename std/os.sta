// STRATA STANDARD LIBRARY — std/os.sta
//
// The operating system: running a program, reading the environment, making a
// directory, finding a tool on PATH.
//
// The compiler driver is the reason this file exists. Deciding what to build
// is language work and already happens in Strata; actually building it means
// asking the environment questions — which C compiler is installed, where
// pg_config says the Postgres headers are, does the output directory exist —
// and then running a command. Every one of those was a `native` block in the
// bootstrap. A language whose own compiler has to drop into C to invoke a
// compiler is not driving its own build; it is describing it and asking C to
// do it.

import io  from std;
import str     from std;

// Run `command` through the shell and return its exit status. Output goes
// wherever the command sends it, which for the C compiler is what we want:
// its errors should reach the user unedited.
int run(str command) {
    native "int _r = system($command); return (int64_t)(_r == -1 ? 127 : WEXITSTATUS(_r));";
}

// Run `command` and return what it wrote to stdout, with one trailing newline
// removed. "" when the command could not be started or said nothing. This is
// for asking a tool a question (`pg_config --includedir`), not for streaming.
str capture(str command) {
    native "
    FILE* _p = popen($command, \"r\");
    if (!_p) return \"\";
    size_t _cap = 4096, _len = 0;
    char* _b = (char*)malloc(_cap);
    if (!_b) { pclose(_p); return \"\"; }
    size_t _n;
    while ((_n = fread(_b + _len, 1, _cap - _len - 1, _p)) > 0) {
        _len += _n;
        if (_len + 1 >= _cap) {
            _cap *= 2;
            char* _g = (char*)realloc(_b, _cap);
            if (!_g) { free(_b); pclose(_p); return \"\"; }
            _b = _g;
        }
    }
    _b[_len] = '\\0';
    pclose(_p);
    while (_len > 0 && (_b[_len-1] == '\\n' || _b[_len-1] == '\\r')) { _b[--_len] = '\\0'; }
    return _b;
    ";
}

// The environment variable `name`, or "" when it is unset. Never null, so the
// result can go straight into str_len and str_eq.
str env(str name) {
    native "const char* _v = getenv($name); return _v ? strata_dup(_v) : \"\";";
}

// Create `path` and any missing parents. 1 on success, and also 1 when the
// directory was already there — the caller wants the directory to exist, not
// to have been the one who made it.
int make_dir(str path) {
    native "
    const char* _p = $path;
    size_t _n = strlen(_p);
    if (_n == 0) return 1;
    char* _w = (char*)malloc(_n + 1);
    if (!_w) return 0;
    strcpy(_w, _p);
    for (size_t _i = 1; _i <= _n; _i++) {
        if (_w[_i] == '/' || _w[_i] == '\\0') {
            char _save = _w[_i];
            _w[_i] = '\\0';
            if (mkdir(_w, 0755) != 0 && errno != EEXIST) { free(_w); return 0; }
            _w[_i] = _save;
        }
    }
    free(_w);
    return 1;
    ";
}

// True when `name` is runnable from PATH. Used to pick a C compiler rather
// than hardcoding one, so the toolchain works on a machine that has clang and
// on a machine that has gcc.
int tool_exists(str name) {
    StringBuilder sb = sb_new();
    sb_append(&sb, "command -v ");
    sb_append(&sb, name);
    sb_append(&sb, " >/dev/null 2>&1");
    int status = run(sb_to_str(&sb));
    if (status == 0) { return 1; }
    return 0;
}

// The directory part of `path`, or "." when there is none. The output
// directory has to exist before the linker writes into it, and the linker's
// complaint when it does not reads like a permissions problem.
str parent_dir(str path) {
    native "
    const char* _p = $path;
    const char* _slash = strrchr(_p, '/');
    if (!_slash) return \".\";
    if (_slash == _p) return \"/\";
    size_t _n = (size_t)(_slash - _p);
    char* _b = (char*)malloc(_n + 1);
    if (!_b) return \".\";
    memcpy(_b, _p, _n);
    _b[_n] = '\\0';
    return _b;
    ";
}

// `path` with its final extension removed: build/orders.sta -> build/orders.
// A dot in a directory name is not an extension, so ./x has no extension.
str drop_extension(str path) {
    native "
    const char* _p = $path;
    const char* _dot = strrchr(_p, '.');
    const char* _slash = strrchr(_p, '/');
    if (!_dot || (_slash && _dot < _slash)) return strata_dup(_p);
    size_t _n = (size_t)(_dot - _p);
    char* _b = (char*)malloc(_n + 1);
    if (!_b) return strata_dup(_p);
    memcpy(_b, _p, _n);
    _b[_n] = '\\0';
    return _b;
    ";
}

verify "the operating system answers" {
    assert run("true") == 0;
    assert run("exit 3") == 3;
    assert str_eq(capture("printf 'hello'"), "hello") == 1;
    assert str_eq(capture("echo hello"), "hello") == 1;
    assert str_len(env("STRATA_DEFINITELY_NOT_SET_12345")) == 0;
    assert tool_exists("sh") == 1;
    assert tool_exists("strata_not_a_real_tool_12345") == 0;
}

verify "paths split into their directory and their stem" {
    assert str_eq(parent_dir("build/orders"), "build") == 1;
    assert str_eq(parent_dir("orders"), ".") == 1;
    assert str_eq(drop_extension("apps/orders/main.sta"), "apps/orders/main") == 1;
    assert str_eq(drop_extension("build/orders"), "build/orders") == 1;
}

verify "a directory is made, parents and all" {
    assert make_dir("/tmp/strata_os_check/a/b/c") == 1;
    assert file_exists("/tmp/strata_os_check/a/b/c") == 1;
    assert make_dir("/tmp/strata_os_check/a/b/c") == 1;
}
