// STRATA STANDARD LIBRARY — std/fetch.sta
// Calling another service over HTTP.
//
// A program that cannot call another service is not an enterprise program.
// `std/http.sta` is a server; this is the other half.
//
// WHAT IT DOES
//
// One request, one response, blocking: connect, send, read until the other end
// closes or the body is complete, hand back the status and the body. That
// covers what an internal system actually does — ask another service for some
// JSON, post a record, call a webhook.
//
// HTTPS
//
// `https://` works, through `std/tls.sta`, which borrows OpenSSL. The
// certificate is verified and the hostname is checked against it, with no way
// to turn either off -- see that file for why there is no "insecure" flag.
//
// If the machine this was built on had no OpenSSL, the binary still runs and
// still serves plain HTTP; an `https://` call refuses and says that is why,
// rather than quietly sending in the clear. `tls_available()` answers the
// question before you ask it.
//
// WHAT IT DOES NOT DO, AND THIS MATTERS
//
// No redirects, no cookies, no keep-alive, no chunked transfer encoding, no
// compression, no proxy support, and no streaming — the whole body is read
// into memory. A response larger than the cap is refused rather than
// truncated, because a truncated JSON document that still parses is the kind
// of wrong answer this language exists to prevent.
//
// WHY NOT libcurl
//
// Borrowing beats building, and for TLS it was: the handshake is OpenSSL's,
// because a hand-written TLS stack is a liability. For the HTTP part over an
// already-open connection there is nothing worth borrowing — the server next
// door already speaks it the same way, and libcurl would be a second
// dependency to install on a machine that may not have it.

import io  from std;
import str from std;
import mem from std;
import tls from std;

foreign "sys/socket.h" link "" { }
foreign "netinet/in.h" link "" { }
foreign "arpa/inet.h"  link "" { }
foreign "netdb.h"      link "" { }
foreign "sys/time.h"   link "" { }
foreign "unistd.h"     link "" { }

// The most a response body may be: 4 MB. A service answering with more than
// that is a streaming problem, and this is not a streaming client.
int fetch_cap() { return 4194304; }

// ── Taking a URL apart ───────────────────────────────────────────────────
//
// Deliberately small: scheme, host, port, path. No user info, no query
// parsing, no fragment -- the query is part of the path as far as a request
// line is concerned, and the server is the one that reads it.

str fetch_host_of(str url) {
    str rest = fetch_after_scheme(url);
    int n = str_len(rest);
    for (int i = 0; i < n; i = i + 1) {
        if (rest[i] == 47) { return str_slice(rest, 0, i); }
        if (rest[i] == 58) { return str_slice(rest, 0, i); }
    }
    return rest;
}

// 443 for https, 80 for everything else, unless the URL says otherwise. A
// default that ignores the scheme is how a program ends up knocking on port
// 80 with a TLS handshake and waiting for an answer that never comes.
int fetch_default_port(str url) {
    if (str_starts_with(url, "https://") == 1) { return 443; }
    return 80;
}

int fetch_port_of(str url) {
    int fallback = fetch_default_port(url);
    str rest = fetch_after_scheme(url);
    int n = str_len(rest);
    for (int i = 0; i < n; i = i + 1) {
        if (rest[i] == 47) { return fallback; }
        if (rest[i] == 58) {
            int p = 0;
            int j = i + 1;
            while (j < n) {
                int c = rest[j];
                if (c < 48) { break; }
                if (c > 57) { break; }
                p = p * 10 + (c - 48);
                j = j + 1;
            }
            if (p == 0) { return fallback; }
            return p;
        }
    }
    return fallback;
}

str fetch_path_of(str url) {
    str rest = fetch_after_scheme(url);
    int n = str_len(rest);
    for (int i = 0; i < n; i = i + 1) {
        if (rest[i] == 47) { return str_slice(rest, i, n); }
    }
    return "/";
}

str fetch_after_scheme(str url) {
    int at = str_index_of(url, "://");
    if (at < 0) { return url; }
    return str_slice(url, at + 3, str_len(url));
}

// ── The call ─────────────────────────────────────────────────────────────

// Connect to a host and port. -1 if the name does not resolve or nothing
// answers.
// How long to wait, in seconds, for a connection and for each read: 30.
//
// There was no timeout at all. A service that accepts the socket and never
// answers held the program forever, with nothing logged -- a batch job that
// never finishes and never says why. Found by a blind evaluator, round 13.
// A number here is better than no number; a caller who needs a different one
// is better served by a setting than by a hang.
int fetch_timeout_seconds() { return 30; }

int fetch_connect(str host, int port) {
    native "
    struct addrinfo _h; memset(&_h, 0, sizeof(_h));
    _h.ai_family = AF_INET; _h.ai_socktype = SOCK_STREAM;
    char _p[16]; snprintf(_p, sizeof(_p), \"%ld\", (long)$port);
    struct addrinfo* _r = NULL;
    if (getaddrinfo($host, _p, &_h, &_r) != 0 || !_r) return -1;
    int _fd = socket(_r->ai_family, _r->ai_socktype, _r->ai_protocol);
    if (_fd < 0) { freeaddrinfo(_r); return -1; }
    if (connect(_fd, _r->ai_addr, _r->ai_addrlen) != 0) {
        close(_fd); freeaddrinfo(_r); return -1;
    }
    freeaddrinfo(_r);
    /* Without these a peer that accepts and never writes holds this process
     * for as long as it cares to. SO_RCVTIMEO makes read() give up, which
     * fetch_read_all reports as the end of the answer -- and the caller then
     * sees a response with no complete status line, which is a refusal. */
    {
        struct timeval _tv;
        _tv.tv_sec = 30; _tv.tv_usec = 0;   /* fetch_timeout_seconds() */
        setsockopt(_fd, SOL_SOCKET, SO_RCVTIMEO, &_tv, sizeof(_tv));
        setsockopt(_fd, SOL_SOCKET, SO_SNDTIMEO, &_tv, sizeof(_tv));
    }
    return (int64_t)_fd;
    ";
}

def fetch_send(int fd, str data) {
    native "
    const char* _d = $data; size_t _n = strlen(_d), _o = 0;
    while (_o < _n) {
        ssize_t _w = write($fd, _d + _o, _n - _o);
        if (_w <= 0) break;
        _o += (size_t)_w;
    }
    ";
}

// Everything the other end sends until it closes. "" when nothing arrives or
// the answer is larger than the cap -- and in the second case the error flag
// is set, because a truncated body that still parses is worse than none.
str fetch_read_all(int fd, int cap) {
    native "
    size_t _cap = (size_t)$cap, _len = 0, _room = 65536;
    char* _b = (char*)malloc(_room);
    if (!_b) return strata_dup(\"\");
    for (;;) {
        if (_len + 4096 + 1 > _room) {
            if (_room * 2 > _cap + 65536) { free(_b); return strata_dup(\"\"); }
            _room *= 2;
            char* _n2 = (char*)realloc(_b, _room);
            if (!_n2) { free(_b); return strata_dup(\"\"); }
            _b = _n2;
        }
        ssize_t _r = read($fd, _b + _len, 4096);
        if (_r <= 0) break;
        _len += (size_t)_r;
        /* Over the cap. Refused, not truncated -- and refused as an EMPTY
         * STRING rather than as C's NULL, which is what the caller is
         * expecting. Returning NULL here crashed every program that did the
         * documented `str_len(answer)` on the result: the module promised a
         * refusal and delivered a segmentation fault. Found by a blind
         * evaluator, round 13. */
        if (_len > _cap) { free(_b); return strata_dup(\"\"); }
    }
    /* _room is kept one byte ahead of _len above, so this cannot run past the
     * allocation. It could, when the peer closed with the buffer exactly
     * full. */
    _b[_len] = '\\0';
    return _b;
    ";
}

def fetch_close(int fd) { native "close($fd);"; }

// ── What a caller uses ───────────────────────────────────────────────────

// A GET, returning the whole response: headers, a blank line, then the body.
// "" when the call did not happen at all, with the reason on the error flag.
str fetch_raw(str method, str url, str body, str content_type) {
    return fetch_with_headers(method, url, body, content_type, "");
}

// The same call, with extra header lines of your own: each one "Name: value"
// and each one ending "\r\n". This is how an Authorization header gets sent,
// and it is a separate function rather than a fifth argument on the common
// one because most calls do not need it and should not have to pass "".
//
// Nothing here logs `extra` or echoes it back in an error message. A header
// is where the credential lives, and a library that prints the request it
// failed to make is how a key ends up in a log file.
str fetch_with_headers(str method, str url, str body, str content_type, str extra) {
    str host = fetch_host_of(url);
    if (str_len(host) == 0) {
        fail(str_cat(["fetch: no host in '", url, "'"]));
        return "";
    }
    int secure = str_starts_with(url, "https://");
    if (secure == 1) {
        if (tls_available() == 0) {
            fail(str_cat(["fetch: cannot call ", url,
            " — this binary was built on a machine with no OpenSSL, and sending it in the clear instead is not an option"]));
            return "";
        }
    }

    // Two transports, one conversation. `fd` is a plain socket; `conn` is a
    // verified TLS session. Exactly one of them is open, and the rest of this
    // function says which it is writing to rather than hiding it behind a
    // layer -- there are two of them, and two is not enough to be worth one.
    int fd = 0 - 1;
    int conn = 0;
    if (secure == 1) {
        conn = tls_connect(host, fetch_port_of(url));
        if (conn == 0) { return ""; }
    } else {
        fd = fetch_connect(host, fetch_port_of(url));
        if (fd < 0) {
            fail(str_cat(["fetch: could not reach ", host]));
            return "";
        }
    }
    StringBuilder req = sb_new();
    sb_append(&req, method);
    sb_append(&req, " ");
    sb_append(&req, fetch_path_of(url));
    sb_append(&req, " HTTP/1.1\r\nHost: ");
    sb_append(&req, host);
    sb_append(&req, "\r\nUser-Agent: strata/0\r\nAccept: */*\r\nConnection: close\r\n");
    if (str_len(extra) > 0) { sb_append(&req, extra); }
    if (str_len(body) > 0) {
        sb_append(&req, "Content-Type: ");
        sb_append(&req, content_type);
        sb_append(&req, "\r\nContent-Length: ");
        sb_append(&req, str(str_len(body)));
        sb_append(&req, "\r\n");
    }
    sb_append(&req, "\r\n");
    sb_append(&req, body);
    str answer = "";
    if (secure == 1) {
        tls_send(conn, sb_to_str(&req));
        answer = tls_read_all(conn, fetch_cap());
        tls_close(conn);
    } else {
        fetch_send(fd, sb_to_str(&req));
        answer = fetch_read_all(fd, fetch_cap());
        fetch_close(fd);
    }
    if (str_len(answer) == 0) {
        fail(str_cat(["fetch: ", host, " answered with nothing, or with more than this client will hold"]));
        return "";
    }
    return answer;
}

str fetch_get(str url)                                { return fetch_raw("GET", url, "", ""); }
str fetch_post(str url, str body, str content_type)   { return fetch_raw("POST", url, body, content_type); }
str fetch_post_json(str url, str body)                { return fetch_raw("POST", url, body, "application/json"); }

// The status line's number: 200, 404, 503. -1 when the answer is not an HTTP
// response at all, which is what a service behind a confused proxy sends.
int fetch_status(str response) {
    if (str_len(response) < 12) { return 0 - 1; }
    if (str_starts_with(response, "HTTP/") == 0) { return 0 - 1; }
    int at = str_index_of(response, " ");
    if (at < 0) { return 0 - 1; }
    int v = 0;
    int seen = 0;
    for (int i = at + 1; i < str_len(response); i = i + 1) {
        int c = response[i];
        if (c < 48) { break; }
        if (c > 57) { break; }
        v = v * 10 + (c - 48);
        seen = 1;
    }
    if (seen == 0) { return 0 - 1; }
    return v;
}

// What follows the blank line, with chunked transfer encoding undone.
//
// "" when there is no body, no blank line, or the framing is damaged -- and
// in the last case the error flag is set, because a body that cannot be
// trusted is worse than no body.
//
// CHUNKING, which is why this is not two lines.
//
// This module used to say "no chunked transfer encoding" and then not look
// at the header. The chunk framing came back as part of the body, so a
// response in two chunks put a hexadecimal length marker INSIDE a value:
// a supplier name came out as `Selasi\r\n1c\r\nh Sdn Bhd` and the program
// was perfectly happy. That is the "truncated document that still parses"
// failure this module exists to prevent, and it is the common case rather
// than the edge case -- most proxies and most frameworks chunk by default
// when there is no Content-Length. Found by a blind evaluator, round 13.
//
// Decoding it is a dozen lines and removes the whole class, which is better
// than refusing a response most servers send.
str fetch_body(str response) {
    int at = str_index_of(response, "\r\n\r\n");
    int skip = 4;
    if (at < 0) {
        at = str_index_of(response, "\n\n");
        skip = 2;
    }
    if (at < 0) { return ""; }
    str raw = str_slice(response, at + skip, str_len(response));
    str te = str_lower(fetch_header(response, "Transfer-Encoding"));
    if (str_index_of(te, "chunked") < 0) { return raw; }
    return fetch_dechunk(raw);
}

// Undo chunked framing: a hex length, CRLF, that many bytes, CRLF, repeat,
// ending at a zero length.
str fetch_dechunk(str raw) {
    int n = str_len(raw);
    StringBuilder out = sb_new();
    int i = 0;
    while (i < n) {
        // The hex length, up to the CRLF. A chunk extension after a
        // semicolon is allowed and ignored.
        int size = 0;
        int digits = 0;
        while (i < n) {
            int c = raw[i];
            int d = 0 - 1;
            if (c >= 48) { if (c <= 57) { d = c - 48; } }
            if (c >= 97) { if (c <= 102) { d = c - 87; } }
            if (c >= 65) { if (c <= 70) { d = c - 55; } }
            if (d < 0) { break; }
            size = size * 16 + d;
            digits = digits + 1;
            i = i + 1;
        }
        if (digits == 0) {
            fail("fetch: the response says it is chunked and its framing is damaged");
            return "";
        }
        // Skip anything else on the length line, then the CRLF.
        while (i < n) { if (raw[i] == 10) { break; } i = i + 1; }
        if (i < n) { i = i + 1; }
        if (size == 0) { return sb_to_str(&out); }
        if (i + size > n) {
            fail("fetch: the response says it is chunked and it stops in the middle of a chunk");
            return "";
        }
        sb_append(&out, str_slice(raw, i, i + size));
        i = i + size;
        // The CRLF after the chunk.
        while (i < n) { if (raw[i] == 10) { i = i + 1; break; } i = i + 1; }
    }
    // Ran out before the terminating zero-length chunk.
    fail("fetch: the response says it is chunked and the last chunk never arrived");
    return "";
}

// One header's value, matched without regard to case because a server's
// spelling of "Content-Type" is its own business. "" when absent.
str fetch_header(str response, str name) {
    int end = str_index_of(response, "\r\n\r\n");
    if (end < 0) { end = str_len(response); }
    str head = str_slice(response, 0, end);
    str want = str_lower(name);
    int n = str_len(head);
    int start = 0;
    for (int i = 0; i <= n; i = i + 1) {
        int at_end = 0;
        if (i == n) { at_end = 1; }
        int eol = 0;
        if (at_end == 0) { if (head[i] == 10) { eol = 1; } }
        if (eol == 0) { if (at_end == 0) { continue; } }
        str line = str_slice(head, start, i);
        start = i + 1;
        int colon = str_index_of(line, ":");
        if (colon < 0) { continue; }
        if (str_eq(str_lower(str_slice(line, 0, colon)), want) == 0) { continue; }
        str value = str_slice(line, colon + 1, str_len(line));
        return fetch_trim(value);
    }
    return "";
}

str str_lower(str value) {
    StringBuilder sb = sb_new();
    int n = str_len(value);
    for (int i = 0; i < n; i = i + 1) {
        int c = value[i];
        if (c >= 65) { if (c <= 90) { c = c + 32; } }
        sb_append(&sb, char_from_code(c));
    }
    return sb_to_str(&sb);
}

str fetch_trim(str value) {
    int n = str_len(value);
    int a = 0;
    while (a < n) {
        int c = value[a];
        if (c != 32) { if (c != 9) { if (c != 13) { break; } } }
        a = a + 1;
    }
    int b = n;
    while (b > a) {
        int c = value[b - 1];
        if (c != 32) { if (c != 9) { if (c != 13) { break; } } }
        b = b - 1;
    }
    return str_slice(value, a, b);
}

verify "a URL comes apart the way a request line needs it" {
    assert str_eq(fetch_host_of("http://api.internal/orders"), "api.internal") == 1;
    assert fetch_port_of("http://api.internal/orders") == 80;
    assert str_eq(fetch_path_of("http://api.internal/orders"), "/orders") == 1;

    assert str_eq(fetch_host_of("http://10.0.0.4:8080/v1/x?a=1"), "10.0.0.4") == 1;
    assert fetch_port_of("http://10.0.0.4:8080/v1/x?a=1") == 8080;
    assert str_eq(fetch_path_of("http://10.0.0.4:8080/v1/x?a=1"), "/v1/x?a=1") == 1;

    // No path at all is a request for the root, not an empty request line.
    assert str_eq(fetch_path_of("http://api.internal"), "/") == 1;
    assert str_eq(fetch_host_of("api.internal/x"), "api.internal") == 1;
}

verify "chunk framing never reaches a value" {
    // Two chunks splitting a supplier name. Before this was decoded, the
    // hexadecimal length marker arrived INSIDE the name and the program
    // carried on with it.
    str r = str_cat(["HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n",
    "Transfer-Encoding: chunked\r\n\r\n",
    "6\r\n{\"a\":\"\r\n",
    "f\r\nSelasih Sdn Bhd\r\n",
    "0\r\n\r\n"]);
    str body = fetch_body(r);
    assert str_index_of(body, "\r\n") < 0;
    assert str_index_of(body, "Selasih Sdn Bhd") >= 0;
    assert had_error() == 0;

    // A single chunk is the ordinary case and comes out whole.
    str one = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n";
    assert str_eq(fetch_body(one), "hello") == 1;

    // Framing that stops in the middle is a refusal, not a short body.
    str cut = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n20\r\nonly a few bytes";
    assert str_len(fetch_body(cut)) == 0;
    assert had_error() == 1;
    clear_error();

    // A response that is not chunked is untouched.
    str plain = "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello";
    assert str_eq(fetch_body(plain), "hello") == 1;
    assert had_error() == 0;
}

verify "a response comes apart" {
    str r = "HTTP/1.1 201 Created\r\nContent-Type: application/json\r\nX-Trace: abc\r\n\r\n{\"id\":7}";
    assert fetch_status(r) == 201;
    assert str_eq(fetch_body(r), "{\"id\":7}") == 1;
    assert str_eq(fetch_header(r, "Content-Type"), "application/json") == 1;
    assert str_eq(fetch_header(r, "content-type"), "application/json") == 1;
    assert str_eq(fetch_header(r, "X-Trace"), "abc") == 1;
    assert str_eq(fetch_header(r, "Nothing"), "") == 1;
}

verify "something that is not an HTTP answer is not read as one" {
    assert fetch_status("") == 0 - 1;
    assert fetch_status("<html>proxy error</html>") == 0 - 1;
    assert fetch_status("HTTP/1.1 nonsense") == 0 - 1;
    assert str_eq(fetch_body("no blank line here"), "") == 1;
}

verify "the scheme picks the port, because a wrong default waits forever" {
    assert fetch_port_of("https://api.example.com/v1") == 443;
    assert fetch_port_of("http://api.example.com/v1") == 80;
    // An explicit port still wins over both.
    assert fetch_port_of("https://api.example.com:8443/v1") == 8443;
    assert fetch_port_of("http://api.example.com:8080/v1") == 8080;
    assert str_eq(fetch_host_of("https://api.example.com/v1"), "api.example.com") == 1;
    assert str_eq(fetch_path_of("https://api.example.com/v1"), "/v1") == 1;
}

verify "https is either done properly or refused, never downgraded" {
    // On a machine with OpenSSL this reaches a host that does not exist and
    // fails there; on a machine without it, it refuses before opening a
    // socket. What must never happen is a plain-HTTP request to port 443.
    str answer = fetch_get("https://no.such.host.invalid.strata/");
    assert str_len(answer) == 0;
    assert had_error() == 1;
    clear_error();
}
