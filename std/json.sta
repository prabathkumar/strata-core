// STRATA STANDARD LIBRARY — std/json.sta
//
// Writing JSON.
//
// Small on purpose: a service that answers in JSON needs escaping it cannot
// get wrong, and a way to build an object and an array without counting
// commas. There is no parser here — nothing in the project reads JSON yet,
// and a parser nobody calls is a parser nobody tests.

import io  from std;
import str from std;

// A string as a JSON string literal, quotes included.
//
// The characters that must be escaped are not the ones that must be escaped
// in C: a literal newline inside a JSON string is invalid, and so is any
// control character below 0x20.
str json_str(str value) {
    StringBuilder sb = sb_new();
    sb_append(&sb, "\"");
    int n = str_len(value);
    for (int i = 0; i < n; i = i + 1) {
        // A byte, not a character: 0..255. Bytes at or above 128 are part of
        // a UTF-8 sequence and belong in the output untouched -- the escaper
        // used to send each one through the control-character branch, so an
        // em dash in a compiler diagnostic arrived at the repair agent as
        // three pieces of garbage.
        int c = value[i];
        if (c > 127) { sb_append(&sb, char_from_code(c)); continue; }
        if (c == 34) { sb_append(&sb, "\\\""); }
        else {
            if (c == 92) { sb_append(&sb, "\\\\"); }
            else {
                if (c == 10) { sb_append(&sb, "\\n"); }
                else {
                    if (c == 13) { sb_append(&sb, "\\r"); }
                    else {
                        if (c == 9) { sb_append(&sb, "\\t"); }
                        else {
                            if (c < 32) { sb_append(&sb, json_control(c)); }
                            else { sb_append(&sb, char_from_code(c)); }
                        }
                    }
                }
            }
        }
    }
    sb_append(&sb, "\"");
    return sb_to_str(&sb);
}

// \u00XX for a control character with no shorter form.
str json_control(int c) {
    StringBuilder sb = sb_new();
    sb_append(&sb, "\\u00");
    sb_append(&sb, hex_nibble(c / 16));
    sb_append(&sb, hex_nibble(c - (c / 16) * 16));
    return sb_to_str(&sb);
}

str hex_nibble(int v) {
    if (v < 10) { return char_from_code(48 + v); }
    return char_from_code(87 + v);
}

// A `"name": value` pair. The value is written as given, so the caller says
// whether it is a string, a number or a nested object.
str json_field(str name, str value) {
    StringBuilder sb = sb_new();
    sb_append(&sb, json_str(name));
    sb_append(&sb, ":");
    sb_append(&sb, value);
    return sb_to_str(&sb);
}

// Commas, so nobody counts them. `first` is 0 for the first item of an
// object or array and 1 afterwards.
def json_next(StringBuilder &sb, int first) {
    if (first == 1) { sb_append(&sb, ","); }
}

// A float written plainly. str() on a float is the language's own rendering;
// this exists so a reader of the service can see where numbers come from.
str json_num(float value) { return str(value); }
str json_int(int value)   { return str(value); }

// Reading one integer field out of a flat JSON object.
//
// Not a parser. It finds `"name"`, skips to the first digit or minus sign
// after the colon, and reads the number — which is what a stream handler does
// with a message envelope, and all that the examples in this repository ever
// needed. It returns 0 for a field that is absent, so a caller that must tell
// "absent" from "zero" needs something this does not do yet.
//
// It exists because two examples called it and nothing defined it: their
// `import ... from hub` named a registry that never existed, and an
// unresolvable import disarms the undefined-call rule, so the missing function
// went unreported for as long as the fake import stood next to it.
int extract_json_int(str text, str name) {
    StringBuilder key = sb_new();
    sb_append(&key, "\"");
    sb_append(&key, name);
    sb_append(&key, "\"");
    int at = str_index_of(text, sb_to_str(&key));
    if (at < 0) { return 0; }

    int n = str_len(text);
    int i = at + str_len(sb_to_str(&key));
    while (i < n) {
        int c = text[i];
        if (c == 45) { return str_to_int(str_slice(text, i, n)); }
        if (c > 47) { if (c < 58) { return str_to_int(str_slice(text, i, n)); } }
        // Anything before the number — the colon, spaces — is skipped, but a
        // comma means this field had no number in it.
        if (c == 44) { return 0; }
        i = i + 1;
    }
    return 0;
}

// The index just past `"name"` in `text`, searching from `start_at`, or -1.
//
// Reading JSON, rather than writing it, starts here. It is deliberately
// positional: find a key, then read the value that follows it. That is enough
// for a document whose shape is known -- a taxonomy keyed by error code, a
// configuration file -- and not enough for one that is not. Anything needing
// real parsing should say so rather than leaning on this.
int json_index_of_key(str text, str name, int start_at) {
    StringBuilder key = sb_new();
    sb_append(&key, "\"");
    sb_append(&key, name);
    sb_append(&key, "\"");
    int n = str_len(text);
    if (start_at < 0) { return -1; }
    if (start_at >= n) { return -1; }
    int at = str_index_of(str_slice(text, start_at, n), sb_to_str(&key));
    if (at < 0) { return -1; }
    return start_at + at + str_len(sb_to_str(&key));
}

// The string value of field `name`, searching from `start_at`. "" when the field
// is absent or does not hold a string. Escapes are not interpreted: a
// document with a backslash in a value needs a real parser, and the ones this
// reads do not have one.
str json_string_field_from(str text, str name, int start_at) {
    int at = json_index_of_key(text, name, start_at);
    if (at < 0) { return ""; }
    int n = str_len(text);
    int i = at;
    // Step over the colon and any space to the opening quote.
    while (i < n) {
        int c = text[i];
        if (c == 34) { i = i + 1; break; }
        // A comma or a brace before the quote means this field had no string.
        if (c == 44) { return ""; }
        if (c == 125) { return ""; }
        i = i + 1;
    }
    int start = i;
    while (i < n) {
        if (text[i] == 34) { return str_slice(text, start, i); }
        i = i + 1;
    }
    return "";
}

// The string value of field `name` anywhere in `text`.
str json_string_field(str text, str name) {
    return json_string_field_from(text, name, 0);
}

verify "a string with a character outside ASCII survives the trip" {
    // An em dash is three bytes. Each one reads as negative when the string
    // is indexed, and the escaper used to turn each into a \u00XX escape of a
    // negative number -- so a compiler diagnostic containing one arrived at
    // the repair agent as garbage. Quotes, backslashes and real control
    // characters still have to be escaped.
    assert str_eq(json_str("a — b"), "\"a — b\"") == 1;
    assert str_eq(json_str("plain"), "\"plain\"") == 1;
    assert str_eq(json_str("say \"hi\""), "\"say \\\"hi\\\"\"") == 1;
    assert str_eq(json_str("a\nb"), "\"a\\nb\"") == 1;
    assert str_eq(json_str("tab\there"), "\"tab\\there\"") == 1;
}

verify "a known-shape document can be read back" {
    str doc = "{\"E004\": {\"severity\": \"CRITICAL_HALT\", \"note\": \"x\"}, \"E007\": {\"severity\": \"ADVISORY\"}}";
    assert str_eq(json_string_field(doc, "severity"), "CRITICAL_HALT") == 1;
    int at = json_index_of_key(doc, "E007", 0);
    assert at > 0;
    assert str_eq(json_string_field_from(doc, "severity", at), "ADVISORY") == 1;
    assert str_eq(json_string_field(doc, "absent"), "") == 1;
    assert json_index_of_key(doc, "absent", 0) < 0;
}
