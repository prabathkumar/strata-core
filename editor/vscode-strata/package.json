{
  "name": "strata-lang",
  "displayName": "Strata",
  "description": "Syntax highlighting, live compiler diagnostics, and one-click repair for the Strata language (.sta).",
  "version": "0.4.0",
  "publisher": "prabathkumar",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0F1416",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "strata",
    "sta",
    "compiler",
    "systems language",
    "database schema",
    "auto-repair"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/prabathkumar/strata-core"
  },
  "bugs": {
    "url": "https://github.com/prabathkumar/strata-core/issues"
  },
  "homepage": "https://github.com/prabathkumar/strata-core#readme",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:strata"
  ],
  "contributes": {
    "languages": [
      {
        "id": "strata",
        "aliases": [
          "Strata",
          "strata"
        ],
        "extensions": [
          ".sta"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "strata",
        "scopeName": "source.strata",
        "path": "./syntaxes/strata.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.c.strata": "c"
        }
      }
    ],
    "commands": [
      {
        "command": "strata.check",
        "title": "Strata: Check This File",
        "category": "Strata"
      },
      {
        "command": "strata.repair",
        "title": "Strata: Repair This File",
        "category": "Strata"
      }
    ],
    "configuration": {
      "title": "Strata",
      "properties": {
        "strata.toolchainPath": {
          "type": "string",
          "default": "strata",
          "description": "Path to the strata command. The default assumes it is on PATH, which is what the toolchain's install script arranges."
        },
        "strata.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run strata check when a .sta file is saved and show what it reports."
        },
        "strata.checkOnType": {
          "type": "boolean",
          "default": true,
          "description": "Also check while typing, a moment after you stop."
        }
      }
    }
  }
}
