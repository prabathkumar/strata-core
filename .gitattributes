# What GitHub counts as this repository's language.
#
# GitHub's detector has never heard of Strata, so it counts .sta files as
# nothing and reports the next largest thing — which makes a repository that
# is roughly half Strata by volume look like a Python project. Nothing here
# can fix that: an override can only name a language GitHub already knows,
# and naming Strata as C or Swift to make the bar look right would be a lie
# in a file. Getting .sta recognised means a pull request to
# github-linguist/linguist, which only accepts languages already in use
# across hundreds of repositories.
#
# What these rules do is stop the count being wrong for reasons that ARE in
# our control: generated files and test code are not what this repository is
# written in.

# Generated by the compiler from .sta sources. Real output, not authored C.
compiler/*.c                 linguist-generated=true
apps/**/*.c                  linguist-generated=true
examples/*.c                 linguist-generated=true
test_suite/**/*.c            linguist-generated=true
build/**                     linguist-generated=true

# The runtime preamble is hand-written C and stays counted.
compiler/runtime_preamble.c      -linguist-generated
compiler/runtime_preamble_wasm.c -linguist-generated

# Test code. Excluded from the language statistics the way GitHub already
# excludes anything it recognises as tests; these suites simply do not live
# in a directory it recognises.
test_suite/*.py              linguist-detectable=false

# Strata sources. Marked so they are at least treated as source text rather
# than as data, and so a diff of one is not collapsed.
*.sta                        text diff
